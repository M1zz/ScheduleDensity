// Version.xcconfig
//
// **버전과 빌드 번호의 단일 소스.**
//
// 예전에는 이 두 값이 ScheduleDensityApp.project.yml 의 settings.base 에 있었다.
// 그러면 올릴 때마다 프로젝트 파일(또는 생성된 project.pbxproj)을 고쳐야 하는데,
// 이 앱은 타겟이 셋(앱·위젯·공유)이라 한 군데만 고치면 번들끼리 버전이 어긋나
// 업로드가 거절된다. 여기 한 파일만 고치면 셋이 함께 따라온다.
//
// ⚠️ **settings.base 에 같은 키를 다시 넣지 말 것.** 프로젝트 빌드 설정은 xcconfig 보다
//    우선해서, 넣는 순간 이 파일이 조용히 무시된다.
//
// ⚠️ CURRENT_PROJECT_VERSION 은 **같은 MARKETING_VERSION 안에서 올리기만 한다.**
//    1.1.0 에서 9까지 올려 두고 1로 되돌렸다가 거절된 적이 있다
//    ("must contain a higher version than [9]"). 같은 버전에서는 되돌리지 못한다.
//    MARKETING_VERSION 을 올리면 새 트레인이라 1부터 다시 셀 수 있다 — 1.1.1 이 그것이다.

// 사람이 읽는 버전 (App Store 에 보이는 번호)
MARKETING_VERSION = 1.1.1

// 빌드 번호 — 업로드마다 올린다
CURRENT_PROJECT_VERSION = 1
