{
  "sourceLanguage": "ko",
  "strings": {
    "%@ 실제로 하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actually do %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 실제로 하기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實際去做%@"
          }
        }
      }
    },
    "%@짜리라 조각 안에 들어갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@, so it fits inside a fragment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@짜리라 조각 안에 들어갑니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長度為 %@，放得進碎片。"
          }
        }
      }
    },
    "%@짜리라 조각에 안 들어갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@, so it won't fit in a fragment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@짜리라 조각에 안 들어갑니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長度為 %@，放不進碎片。"
          }
        }
      }
    },
    "%@짜리입니다. 한 자리에서도 안 닫힙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@. Even one sitting won't close it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@짜리입니다. 한 자리에서도 안 닫힙니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長度為 %@。就算一次坐下也收不了尾。"
          }
        }
      }
    },
    "%lld개 단계가 2시간을 넘습니다. 끝이 닫히는 크기로 더 쪼개세요. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld steps run past two hours. Split them down to a size that closes. A half-done step drags your attention into the next hour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 단계가 2시간을 넘습니다. 끝이 닫히는 크기로 더 쪼개세요. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個步驟超過兩小時。請再拆分到能收尾的大小。做到一半的步驟會把注意力拖到下一個小時。"
          }
        }
      }
    },
    "%lld분": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分鐘"
          }
        }
      }
    },
    "%lld시간": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld h"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld시간"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小時"
          }
        }
      }
    },
    "%lld시간 %lld분": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldh %lldm"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld시간 %lld분"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小時 %lld 分鐘"
          }
        }
      }
    },
    "'보내기·발행하기·제출하기'처럼 끝을 닫는 단계를 마지막에 두세요. 90% 끝난 일의 마지막 10%는 조각의 가장 좋은 용도이고, 닫아두면 그 뒤의 덩어리 시간까지 깨끗해집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a closing step last — send it, publish it, submit it. The final 10% of a job that's 90% done is the best possible use of a fragment, and closing it leaves the block of time after it clean."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'보내기·발행하기·제출하기'처럼 끝을 닫는 단계를 마지막에 두세요. 90% 끝난 일의 마지막 10%는 조각의 가장 좋은 용도이고, 닫아두면 그 뒤의 덩어리 시간까지 깨끗해집니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把「寄出、發布、提交」這類收尾的步驟放在最後。完成 90% 的事剩下的 10%，是碎片最好的用途；收完尾，之後的整塊時間也會清爽許多。"
          }
        }
      }
    },
    "5분 안에 끝까지 가나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does it run all the way through in five minutes?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분 안에 끝까지 가나요?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五分鐘內能做到底嗎？"
          }
        }
      }
    },
    "5분이 생겼을 때 집을 단계가 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No step here can be picked up in a five-minute gap"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분이 생겼을 때 집을 단계가 없습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有能在五分鐘空檔拿起來做的步驟"
          }
        }
      }
    },
    "‘%@’은(는) 한 번에 안 끝납니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' won't finish in one go"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 한 번에 안 끝납니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無法一次完成"
          }
        }
      }
    },
    "‘%@’이(가) ‘%@’보다 뒤입니다. 정해지지 않은 채 시작한 작업은 조각에서도 덩어리에서도 닫히지 않습니다. 결정 단계를 앞으로 옮기세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' comes after '%@'. Work started before the decision is made won't close in a fragment or in a block. Move the decision earlier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’이(가) ‘%@’보다 뒤입니다. 정해지지 않은 채 시작한 작업은 조각에서도 덩어리에서도 닫히지 않습니다. 결정 단계를 앞으로 옮기세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」排在「%@」之後。還沒決定就開始的工作，不論在碎片或整塊時間都無法收尾。請把決定的步驟往前移。"
          }
        }
      }
    },
    "건너뜀": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너뜀"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已略過"
          }
        }
      }
    },
    "결정이 작업 뒤에 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A decision sits behind the work"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정이 작업 뒤에 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定排在工作之後"
          }
        }
      }
    },
    "고정 시간대": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed hours"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 시간대"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定時段"
          }
        }
      }
    },
    "글쓰기·구현·설계처럼 맥락을 다시 불러와야 하는 일은 조각 크기로 잡아두면 시동만 걸다 끝납니다. 시간을 늘리거나, 그 앞에 '준비' 조각 단계를 따로 두세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing, building, designing — work that needs its context reloaded spends a fragment-sized slot warming up and nothing more. Give it more time, or put a small setup step in front of it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글쓰기·구현·설계처럼 맥락을 다시 불러와야 하는 일은 조각 크기로 잡아두면 시동만 걸다 끝납니다. 시간을 늘리거나, 그 앞에 '준비' 조각 단계를 따로 두세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫作、實作、設計這類需要重新載入脈絡的事，若只給碎片大小的時間，只會暖身就結束。請增加時間，或在前面另外加一個「準備」的碎片步驟。"
          }
        }
      }
    },
    "끊기면 다시 올라와야 합니다. 방해 없는 시간에 두세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it breaks, you have to climb back up. Give it undisturbed time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끊기면 다시 올라와야 합니다. 방해 없는 시간에 두세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦中斷就得重新爬回去。請放在不受打擾的時間。"
          }
        }
      }
    },
    "끝나지 않은 일은 잔여물이 되어 그다음 덩어리 시간까지 갉아먹습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished work leaves residue that eats into the next block of time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝나지 않은 일은 잔여물이 되어 그다음 덩어리 시간까지 갉아먹습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒做完的事會留下殘留，連帶啃掉下一段整塊時間。"
          }
        }
      }
    },
    "끝을 닫는 단계. 짬이 나면 바로 집을 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The step that closes the end. Take it whenever a gap opens."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝을 닫는 단계. 짬이 나면 바로 집을 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收尾的步驟。一有空檔就能拿起來做。"
          }
        }
      }
    },
    "끝이 닫히는 크기로 더 쪼개세요. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split it further, down to a size that closes. A half-done step drags your attention into the next hour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝이 닫히는 크기로 더 쪼개세요. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再拆分到能收尾的大小。做到一半的步驟會把注意力拖到下一個小時。"
          }
        }
      }
    },
    "끝이 정해져 있어 여기서 닫힙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end is fixed, so it closes here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝이 정해져 있어 여기서 닫힙니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終點已確定，所以能在這裡收尾。"
          }
        }
      }
    },
    "끝이 정해져 있지 않아 안 닫힙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no fixed end, so it never closes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝이 정해져 있지 않아 안 닫힙니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終點沒有確定，所以收不了尾。"
          }
        }
      }
    },
    "다시 붙잡는 데만 평균 23분이 듭니다. 조각에 넣으면 시동만 걸다 끝나니, 시간을 늘리거나 덩어리 시간에 두세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It takes 23 minutes on average just to get back into it. In a fragment you'd only be warming up — give it more time, or put it in a block."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 붙잡는 데만 평균 23분이 듭니다. 조각에 넣으면 시동만 걸다 끝나니, 시간을 늘리거나 덩어리 시간에 두세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光是重新進入狀況平均就要 23 分鐘。放在碎片裡只會暖身就結束，請增加時間，或放在整塊時間。"
          }
        }
      }
    },
    "달성": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Met"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달성"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達成"
          }
        }
      }
    },
    "덩어리": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덩어리"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整塊"
          }
        }
      }
    },
    "덩어리입니다. 지켜 둔 시간에 두세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a block. Give it time you've set aside."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덩어리입니다. 지켜 둔 시간에 두세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是整塊。請放在預留的時間。"
          }
        }
      }
    },
    "링크·자료를 펼쳐만 둡니다. 본 작업의 시동 비용을 여기서 미리 냅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just open the links and files. You pay the real work's warm-up cost here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크·자료를 펼쳐만 둡니다. 본 작업의 시동 비용을 여기서 미리 냅니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要打開連結和資料就好。先在這裡付掉正式工作的暖身成本。"
          }
        }
      }
    },
    "마무리해서 보내기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap it up and send it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마무리해서 보내기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收尾並寄出"
          }
        }
      }
    },
    "마지막을 닫는 단계가 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no step that closes the end"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막을 닫는 단계가 없습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有收尾的步驟"
          }
        }
      }
    },
    "맥락을 다시 읽어 와야 하는 일은 조각에서 시동만 걸다 끝납니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work that needs its context reloaded spends the whole fragment warming up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맥락을 다시 읽어 와야 하는 일은 조각에서 시동만 걸다 끝납니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新讀回脈絡的事，在碎片裡只會暖身就結束。"
          }
        }
      }
    },
    "모든 단계가 자리를 잡아야 하는 크기입니다. 자료 모아두기·한 줄 메모처럼 조각에서 닫히는 단계를 하나 만들어두면, 흘려보내던 틈이 이 할 일에 쓰입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every step here needs you to sit down for it. Add one step that closes in a fragment — gathering links, a one-line note — and the gaps you used to let slip start going into this job."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 단계가 자리를 잡아야 하는 크기입니다. 자료 모아두기·한 줄 메모처럼 조각에서 닫히는 단계를 하나 만들어두면, 흘려보내던 틈이 이 할 일에 쓰입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個步驟都需要坐下來做。加一個能在碎片裡收尾的步驟，例如收集資料、寫一行筆記，原本白白流走的空檔就會用在這件事上。"
          }
        }
      }
    },
    "몸으로 하는 일은 나눠 해도 쌓입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Physical work adds up even when it's split."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸으로 하는 일은 나눠 해도 쌓입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身體力行的事，分開做也會累積。"
          }
        }
      }
    },
    "몸으로 하는 일이라 시동이 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's physical, so there's no warm-up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸으로 하는 일이라 시동이 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是身體力行的事，不需要暖身。"
          }
        }
      }
    },
    "무엇을 할지 정하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide what to do"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 할지 정하기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定要做什麼"
          }
        }
      }
    },
    "뭘 할지 고르는 동안 조각이 끝납니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap is gone before you finish choosing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뭘 할지 고르는 동안 조각이 끝납니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還在挑要做什麼，碎片就結束了。"
          }
        }
      }
    },
    "뭘 할지 고르는 동안 조각이 끝납니다. 결정은 덩어리에서 하고, 정해진 것만 조각 단계로 보내세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap is gone before you finish choosing. Make decisions in a block, and send only the settled work to fragment steps."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뭘 할지 고르는 동안 조각이 끝납니다. 결정은 덩어리에서 하고, 정해진 것만 조각 단계로 보내세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還在挑要做什麼，碎片就結束了。請在整塊時間做決定，只把已確定的事交給碎片步驟。"
          }
        }
      }
    },
    "배수구": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the drain"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배수구"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排水孔"
          }
        }
      }
    },
    "부분 달성": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partly met"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부분 달성"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分達成"
          }
        }
      }
    },
    "시간을 안 적어 두어서, 5분 안에 닫히는지 아직 모릅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time is written down, so there's no telling yet whether it closes in five minutes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 안 적어 두어서, 5분 안에 닫히는지 아직 모릅니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有寫下時間，所以還不知道能否在五分鐘內收尾。"
          }
        }
      }
    },
    "시동 없이 바로 시작되나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does it start with no warm-up?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 없이 바로 시작되나요?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用暖身就能馬上開始嗎？"
          }
        }
      }
    },
    "심야": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late night"
          }
        },
        "ko": {
