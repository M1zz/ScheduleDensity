            "value": "早上（6–12 點）"
          }
        }
      }
    },
    "안 정한 것이 먼저 막고 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something undecided is blocking it first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안 정한 것이 먼저 막고 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有尚未決定的事先擋在前面。"
          }
        }
      }
    },
    "안 정해진 게 남아 있으면 아래 단계가 전부 안 열립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If anything is left undecided, none of the steps below will open."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안 정해진 게 남아 있으면 아래 단계가 전부 안 열립니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要還有沒決定的事，下面的步驟就全都無法開始。"
          }
        }
      }
    },
    "앞에서 막고 있는 것이 안 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing seems to be blocking it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞에서 막고 있는 것이 안 보입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看不出前面有東西擋著。"
          }
        }
      }
    },
    "어디까지 했는지 다시 읽어 와야 시작됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have to reload where you left off before you can start."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디까지 했는지 다시 읽어 와야 시작됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "得先重新讀回做到哪裡才能開始。"
          }
        }
      }
    },
    "오후": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Afternoon"
          }
        },
        "ko": {
          "stringUnit": {
