            "value": "취소"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "판정 기준 3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule 3"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판정 기준 3"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "判斷標準 3"
          }
        }
      }
    },
    "필요한 것 모아두기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gather what you'll need"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 것 모아두기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收集需要的東西"
          }
        }
      }
    },
    "한 번에 못 끝내는 크기입니다. 끝이 닫히도록 더 쪼개지 않으면 '하다 만 상태'가 다음 시간까지 따라옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is too big to finish in one go. Unless you split it down to something that closes, the half-done state follows you into the next hour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 못 끝내는 크기입니다. 끝이 닫히도록 더 쪼개지 않으면 '하다 만 상태'가 다음 시간까지 따라옵니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個大小無法一次完成。若不再拆分到能收尾的大小，「做到一半」的狀態會一路跟到下一個小時。"
          }
        }
      }
    },
    "할 것이 정해져 있어 바로 손이 갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What to do is already settled, so you can start."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 것이 정해져 있어 바로 손이 갑니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要做什麼已經確定，可以馬上動手。"
          }
        }
      }
    },
    "할 일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To-Do"
          }
        },
        "ko": {
