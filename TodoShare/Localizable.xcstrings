          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入"
          }
        }
      }
    },
    "취소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ko": {
          "stringUnit": {
