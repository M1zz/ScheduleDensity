<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 앱이 구워둔 할 일 스냅샷을 읽기 위한 통로.
	     ⚠️ 앱 타깃(ScheduleDensityApp.entitlements)의 값과 반드시 같아야 한다. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.devkoan.ScheduleDensity</string>
	</array>
</dict>
</plist>
