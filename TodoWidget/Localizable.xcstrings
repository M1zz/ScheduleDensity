    "단계를 5분에 닫히는 크기로 잘라 두면 여기 섭니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkraťte krok tak, aby se uzavřel do pěti minut, a objeví se tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør et trin så lille, at det lukker på fem minutter, så lander det her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneide einen Schritt so klein, dass er in fünf Minuten fertig ist, dann landet er hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κόψε ένα βήμα τόσο μικρό ώστε να κλείνει σε πέντε λεπτά και θα εμφανιστεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cut a step small enough to close in five minutes and it lands here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta un paso a un tamaño que se cierre en cinco minutos y aparecerá aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun pilkot vaiheen niin pieneksi, että se valmistuu viidessä minuutissa, se ilmestyy tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupez une étape assez petite pour se boucler en cinq minutes et elle apparaîtra ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potong langkah sampai cukup kecil untuk tuntas dalam lima menit, maka ia muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taglia una fase abbastanza piccola da chiudersi in cinque minuti e comparirà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステップを5分で閉じられる大きさに切っておくと、ここに並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단계를 5분에 닫히는 크기로 잘라 두면 여기 섭니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør et trinn så lite at det avsluttes på fem minutter, så havner det her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knip een stap op tot hij in vijf minuten af kan, dan komt hij hier te staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potnij krok tak, by zamykał się w pięć minut, a pojawi się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corte uma etapa num tamanho que se feche em cinco minutos e ela aparece aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нарежьте шаг так, чтобы он закрывался за пять минут, — и он появится здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör ett steg så litet att det blir klart på fem minuter, så hamnar det här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัดขั้นตอนให้เล็กพอจะจบใน 5 นาที แล้วจะมาอยู่ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir adımı beş dakikada kapanacak boyutta keserseniz burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắt một bước đủ nhỏ để xong trong năm phút, nó sẽ hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把步骤切成五分钟内能收尾的大小，就会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把步驟切成五分鐘內能收尾的大小，就會出現在這裡。"
          }
        }
      }
    },
    "러닝 30분" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
