        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel je activiteiten met anderen, alleen-lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij innym swoje wydarzenia, tylko do odczytu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe seus eventos com outras pessoas, só para leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывайте свои события другим в режиме только для чтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela dina händelser med andra, skrivskyddat."
          }
        },
        "th" : {
          "stringUnit" : {
