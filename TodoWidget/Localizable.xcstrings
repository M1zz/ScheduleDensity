    "내 일정을 읽기 전용으로 나눠 봅니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílejte svůj rozvrh s ostatními jen ke čtení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del dine begivenheder med andre, skrivebeskyttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deine Termine schreibgeschützt mit anderen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
