    "%@ 위젯이 잠겨 있습니다. 눌러서 무지개 Pro를 여십시오." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget %@ je zamčený. Klepnutím odemknete Rainbow Pro."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgetten %@ er låst. Tryk for at låse op med Rainbow Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Widget „%@“ ist gesperrt. Tippe, um Rainbow Pro freizuschalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το γραφικό στοιχείο %@ είναι κλειδωμένο. Πάτα για να ξεκλειδώσεις το Rainbow Pro."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ widget is locked. Tap to unlock Rainbow Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El widget %@ está bloqueado. Tócalo para desbloquear Rainbow Pro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-widget on lukittu. Avaa Rainbow Pro napauttamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le widget %@ est verrouillé. Touchez pour débloquer Rainbow Pro."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget %@ terkunci. Ketuk untuk membuka Rainbow Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il widget %@ è bloccato. Tocca per sbloccare Rainbow Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ウィジェットはロックされています。タップしてRainbow Proを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 위젯이 잠겨 있습니다. 눌러서 무지개 Pro를 여십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgeten %@ er låst. Trykk for å låse opp med Rainbow Pro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De widget %@ is vergrendeld. Tik om Rainbow Pro te ontgrendelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widżet %@ jest zablokowany. Stuknij, aby odblokować Rainbow Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O widget %@ está bloqueado. Toque para desbloquear o Rainbow Pro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджет «%@» закрыт. Нажмите, чтобы открыть Rainbow Pro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgeten %@ är låst. Tryck för att låsa upp Rainbow Pro."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิดเจ็ต %@ ถูกล็อกอยู่ แตะเพื่อปลดล็อก Rainbow Pro"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ araç takımı kilitli. Rainbow Pro’yu açmak için dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiện ích %@ đang khóa. Chạm để mở khóa Rainbow Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 小组件已锁定。轻点以解锁彩虹 Pro。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 小工具已鎖定。點一下以解鎖彩虹 Pro。"
          }
        }
      }
    },
    "%@ 위젯이 잠겨 있습니다. 앱의 설정에서 무지개 Pro를 사면 열립니다." : {
