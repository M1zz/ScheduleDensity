    "시스템 캘린더의 일정을 무지개로 들여옵니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přenese události ze systémového Kalendáře do Duhy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter begivenheder fra Kalender ind på regnbuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holt Termine aus „Kalender“ in den Regenbogen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φέρνει συμβάντα από το Ημερολόγιο στο ουράνιο τόξο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brings events from Calendar onto the Rainbow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva los eventos de Calendario al arcoíris."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo tapahtumat Kalenterista sateenkaareen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amène les événements de Calendrier sur l’Arc-en-ciel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membawa jadwal dari Kalender ke Pelangi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta gli eventi di Calendario sull’Arcobaleno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーの予定を虹に取り込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 캘린더의 일정을 무지개로 들여옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter hendelser fra Kalender inn på regnbuen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haalt activiteiten uit Agenda naar de regenboog."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi wydarzenia z Kalendarza na tęczę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traz os eventos do Calendário para o arco-íris."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносит события из Календаря на радугу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämtar händelser från Kalender till regnbågen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำกิจกรรมจากแอปปฏิทินมาไว้บนสายรุ้ง"
          }
