    "두 시간을 넘기면 하다 말게 됩니다. 넘을 것 같으면 그 마디를 다시 쪼개세요 — 단계를 길게 누르면 그 단계만 따로 쪼갤 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dvou hodinách to necháte napůl hotové. Pokud fáze vypadá, že se protáhne, rozdělte ji znovu – podržením kroku rozdělíte jen ten jeden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over to timer ender du med at lade det stå halvfærdigt. Ser en fase ud til at løbe over, så del den op igen – tryk og hold på et trin for at dele netop det op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach mehr als zwei Stunden bleibt es halb fertig liegen. Sieht eine Etappe danach aus, teile sie noch einmal – halte einen Schritt gedrückt, um nur diesen aufzuteilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάνω από δύο ώρες, θα το αφήσεις στη μέση. Αν ένα στάδιο μοιάζει να ξεπερνά τον χρόνο, χώρισέ το ξανά — πάτα παρατεταμένα ένα βήμα για να χωρίσεις μόνο αυτό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past two hours you'll leave it half done. If a stage looks like it will run over, split it again — press and hold a step to split just that one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past two hours you'll leave it half done. If a stage looks like it will run over, split it again — press and hold a step to split just that one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasadas dos horas, lo dejarás a medias. Si una etapa parece que se va a alargar, divídela otra vez: mantén pulsado un paso para dividir solo ese."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahden tunnin jälkeen työ jää kesken. Jos osio näyttää venyvän, pilko se uudelleen – paina vaihetta pitkään, niin voit pilkkoa juuri sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de deux heures, vous la laisserez à moitié faite. Si une étape risque de déborder, redécoupez-la : maintenez une étape pour ne découper qu’elle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lewat dua jam, biasanya akan ditinggal setengah jalan. Kalau satu tahap sepertinya bakal lewat, pecah lagi — tekan lama sebuah langkah untuk memecah langkah itu saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre le due ore finirai per lasciarlo a metà. Se un passaggio rischia di sforare, suddividilo di nuovo: tieni premuta una fase per suddividere solo quella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2時間を超えると途中で止まってしまいます。超えそうなら、その区切りをもう一度分けましょう。ステップを長押しすると、そのステップだけを分けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 시간을 넘기면 하다 말게 됩니다. 넘을 것 같으면 그 마디를 다시 쪼개세요 — 단계를 길게 누르면 그 단계만 따로 쪼갤 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over to timer ender du med å la det stå halvferdig. Ser det ut til at en fase blir for lang, deler du den opp igjen – trykk og hold på et trinn for å dele opp akkurat det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na twee uur laat je het half af. Lijkt een fase uit te lopen, splits hem dan opnieuw — houd een stap ingedrukt om alleen die stap op te splitsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dwóch godzinach zostawisz to w połowie. Jeśli etap może się przeciągnąć, podziel go jeszcze raz — przytrzymaj krok, aby podzielić tylko jego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passou de duas horas, vai ficar pela metade. Se uma fase parece que vai estourar, divida de novo — toque e segure uma etapa para dividir só ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше двух часов — и дело останется недоделанным. Если этап может затянуться, разбейте его ещё раз: нажмите и удерживайте шаг, чтобы разбить только его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter två timmar blir det halvfärdigt. Ser en etapp ut att dra över, dela upp den igen – tryck länge på ett steg för att dela upp just det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเกินสองชั่วโมง มักจะทำค้างไว้ครึ่งทาง ถ้าช่วงไหนดูจะเกิน ให้แบ่งใหม่อีกครั้ง — กดค้างที่ขั้นตอนเพื่อแบ่งเฉพาะขั้นตอนนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki saati geçerse yarım kalır. Bir aşama aşacak gibi görünüyorsa onu yeniden bölün; bir adıma basılı tutarak yalnızca o adımı bölebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá hai tiếng là bạn sẽ bỏ dở giữa chừng. Nếu một giai đoạn có vẻ sẽ vượt quá, hãy chia nó lần nữa — nhấn giữ một bước để chia riêng bước đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过两小时就会做到一半停下。如果某一段看起来会超过，就再拆一次；长按某个步骤，就能只拆那一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過兩小時就會做到一半停下。如果某一段看起來會超過，就再拆一次；長按某個步驟，就能只拆那一個。"
          }
        }
      }
    },
    "두 질문으로 조각과 덩어리를 가르는 것까지 전부." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Včetně dvou otázek, které oddělí střípky od souvislého času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inklusive de to spørgsmål, der skiller tidslommer fra fokusblokke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inklusive der zwei Fragen, die Splitter von Fokuszeit trennen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαζί με τις δύο ερωτήσεις που ξεχωρίζουν τα κομμάτια από τα συνεχή διαστήματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Including the two questions that sort quick bits from big blocks."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Including the two questions that sort quick bits from big blocks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluidas las dos preguntas que separan fragmentos de tramos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukaan lukien kaksi kysymystä, jotka erottavat pätkät jaksoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y compris les deux questions qui séparent fragments et plages de concentration."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termasuk dua pertanyaan yang memilah kepingan dari sesi fokus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprese le due domande che separano frammenti e tempo di concentrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つの問いで、かけらとまとまった時間を分けるところまで全部。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 질문으로 조각과 덩어리를 가르는 것까지 전부."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkludert de to spørsmålene som skiller tidslommer fra fokusblokker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclusief de twee vragen die fragmenten van brokken scheiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łącznie z dwoma pytaniami, które oddzielają okruchy od ciągłych odcinków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclusive as duas perguntas que separam fragmentos de períodos contínuos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включая два вопроса, которые отделяют кусочки от цельных отрезков."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inklusive de två frågorna som skiljer ministeg från fokustid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมถึงสองคำถามที่แยกชิ้นย่อยออกจากช่วงเวลายาว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parçaları ve odak sürelerini ayıran iki soru da dahil, hepsi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kể cả hai câu hỏi tách mảnh khỏi quãng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连同用两个问题区分碎片与整块的方法，全部都有。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連同用兩個問題區分碎片與整塊的方法，全部都有。"
          }
        }
      }
    },
    "두 칸은 끝까지 따로 셉니다. 합치면 “50분 벌었는데 왜 아무것도 못 했지”가 됩니다.\n하루의 끝이 시계로 고정돼 있으면 절약은 시간으로 회수되지 않고 여유(부하 감소)로만 회수됩니다. 그때 이 칸이 0인 것은 실패가 아니라 사실입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oba sloupce se počítají zvlášť, až do konce. Kdybyste je sečetli, vyšlo by „Ušetřil jsem 50 minut – tak proč jsem nic nestihl?“\nKdyž je konec dne pevně daný hodinami, ušetřené se nevrací jako čas, ale jen jako rezerva (menší zátěž). Nula v tomto sloupci pak není selhání, ale prostý fakt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De to kolonner tælles hver for sig, hele vejen. Lægger du dem sammen, får du “Jeg sparede 50 minutter – hvorfor fik jeg så intet fra hånden?”\nNår din dags slutning er fastlagt af uret, kommer det, du sparer, tilbage som luft, ikke som tid. Et nul i denne kolonne er så ikke et nederlag; det er en kendsgerning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zwei Spalten werden bis zum Schluss getrennt gezählt. Wer sie zusammenrechnet, landet bei „50 Minuten gespart – und trotzdem nichts geschafft?“\nWenn das Ende deines Tages von der Uhr festgelegt ist, kommt Erspartes nicht als Zeit zurück, sondern nur als Luft (weniger Last). Eine Null in dieser Spalte ist dann kein Versagen, sondern eine Tatsache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δύο στήλες μετρώνται χωριστά, ως το τέλος. Αν τις ενώσεις, καταλήγεις στο «κέρδισα 50 λεπτά, γιατί δεν έκανα τίποτα;».\nΌταν το τέλος της μέρας σου ορίζεται από το ρολόι, ό,τι εξοικονομείς επιστρέφει ως άνεση, όχι ως χρόνος. Τότε το μηδέν σε αυτή τη στήλη δεν είναι αποτυχία· είναι γεγονός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The two columns are counted apart, all the way. Add them together and you get \"I saved 50 minutes — why did I get nothing done?\"\nWhen the end of your day is fixed by the clock, what you save comes back as slack, not as time. A zero in this column then isn't failure; it's the fact."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The two columns are counted apart, all the way. Add them together and you get \"I saved 50 minutes — why did I get nothing done?\"\nWhen the end of your day is fixed by the clock, what you save comes back as slack, not as time. A zero in this column then isn't failure; it's the fact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las dos columnas se cuentan por separado hasta el final. Si las juntas, acabas pensando: “Ahorré 50 minutos, ¿por qué no hice nada?”.\nCuando el final de tu día lo marca el reloj, lo que ahorras no vuelve como tiempo, sino como holgura. Un cero en esta columna no es un fracaso: es un hecho."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarakkeet lasketaan erikseen loppuun asti. Jos ne lasketaan yhteen, tulos on ”Säästin 50 minuuttia – miksen saanut mitään aikaan?”\nKun päiväsi loppu on kellon määräämä, säästetty aika palaa väljyytenä eikä aikana. Nolla tässä sarakkeessa ei silloin ole epäonnistuminen vaan tosiasia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux colonnes se comptent à part, jusqu’au bout. Additionnez-les et vous obtenez « J’ai gagné 50 minutes, pourquoi je n’ai rien fait ? »\nQuand la fin de votre journée est fixée par l’horloge, ce que vous économisez revient en marge, pas en temps. Un zéro dans cette colonne n’est alors pas un échec, c’est un fait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua kolom dihitung terpisah sampai akhir. Kalau digabung, jadinya “Saya hemat 50 menit — kok tidak ada yang beres?”\nJika akhir hari Anda dipatok jam, yang dihemat tidak kembali sebagai waktu, melainkan sebagai kelonggaran (beban berkurang). Saat itu, angka nol di kolom ini bukan kegagalan, melainkan kenyataan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le due colonne si contano separate, fino in fondo. Se le sommi ottieni “ho risparmiato 50 minuti, perché non ho combinato niente?”.\nQuando la fine della giornata è fissata dall’orologio, ciò che risparmi non torna come tempo ma solo come margine (meno carico). Allora uno zero in questa colonna non è un fallimento: è un dato di fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つの欄は最後まで別々に数えます。合わせると「50分浮いたのに、なぜ何もできなかったんだろう」になってしまいます。\n1日の終わりが時計で決まっているなら、節約した分は時間ではなく余裕（負荷の軽減）としてしか戻ってきません。そのときこの欄が0なのは失敗ではなく、事実です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 칸은 끝까지 따로 셉니다. 합치면 “50분 벌었는데 왜 아무것도 못 했지”가 됩니다.\n하루의 끝이 시계로 고정돼 있으면 절약은 시간으로 회수되지 않고 여유(부하 감소)로만 회수됩니다. 그때 이 칸이 0인 것은 실패가 아니라 사실입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De to kolonnene telles hver for seg, hele veien. Legger du dem sammen, får du «Jeg sparte 50 minutter – hvorfor fikk jeg ingenting gjort?»\nNår slutten på dagen din er låst av klokken, kommer det du sparer tilbake som luft, ikke som tid. En null i denne kolonnen er da ikke et nederlag; det er et faktum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De twee kolommen worden tot het eind apart geteld. Tel je ze op, dan krijg je ‘50 minuten gewonnen, en toch niets gedaan?’\nLigt het einde van je dag vast op de klok, dan komt wat je bespaart terug als lucht, niet als tijd. Een nul in deze kolom is dan geen falen, maar gewoon een feit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obie kolumny liczone są osobno, do samego końca. Gdyby je zsumować, wyszłoby: „Zaoszczędziłem 50 minut — czemu nic nie zrobiłem?”.\nGdy koniec dnia wyznacza zegar, oszczędność nie wraca jako czas, tylko jako luz (mniejsze obciążenie). Zero w tej kolumnie nie jest wtedy porażką, tylko faktem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As duas colunas são contadas separadas até o fim. Se juntar, vira “ganhei 50 minutos, por que não fiz nada?”.\nQuando o fim do seu dia é fixado pelo relógio, o que você economiza não volta como tempo, e sim como folga. Um zero nesta coluna não é fracasso; é um fato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два столбца считаются отдельно до самого конца. Если их сложить, выйдет «сэкономил 50 минут — почему же ничего не успел?».\nКогда конец дня жёстко задан часами, сэкономленное возвращается не временем, а запасом (меньшей нагрузкой). Тогда ноль в этом столбце — не провал, а просто факт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De två kolumnerna räknas var för sig, hela vägen. Lägger du ihop dem får du ”Jag sparade 50 minuter – varför fick jag ingenting gjort?”\nNär slutet på din dag styrs av klockan kommer det du sparar tillbaka som marginal, inte som tid. En nolla i den här kolumnen är då inget misslyckande, utan ett faktum."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สองช่องนี้นับแยกกันไปจนสุด ถ้ารวมกันจะกลายเป็น “ประหยัดได้ 50 นาที ทำไมไม่ได้อะไรเลย”\nเมื่อเวลาเลิกงานของวันถูกกำหนดด้วยนาฬิกา สิ่งที่ประหยัดได้จะไม่กลับมาเป็นเวลา แต่กลับมาเป็นความผ่อนคลาย (ภาระลดลง) เท่านั้น ตอนนั้นช่องนี้เป็น 0 ไม่ใช่ความล้มเหลว แต่เป็นข้อเท็จจริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki sütun sonuna kadar ayrı sayılır. Toplarsanız “50 dakika kazandım, neden hiçbir şey yapamadım?” sorusu çıkar.\nGününüzün sonu saatle sabitse, kazandığınız şey zaman olarak değil, rahatlık (daha az yük) olarak geri döner. O zaman bu sütunun sıfır olması başarısızlık değil, gerçeğin ta kendisidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai cột được tính riêng đến cùng. Gộp lại, bạn sẽ thành “mình tiết kiệm được 50 phút, sao chẳng làm được gì?”\nKhi giờ kết thúc ngày đã cố định theo đồng hồ, phần tiết kiệm không quay lại thành thời gian mà chỉ thành sự thong thả (bớt tải). Khi đó, số 0 ở cột này không phải thất bại; đó là sự thật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两栏从头到尾分开计算。合在一起，就会变成“明明省了 50 分钟，怎么什么都没做成”。\n如果一天的结束由时钟固定，省下的不会变回时间，只会变成余量（负担减轻）。这时这一栏是 0，不是失败，而是事实。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩欄從頭到尾分開計算。合在一起，就會變成「明明省了 50 分鐘，怎麼什麼都沒做成」。\n如果一天的結束由時鐘固定，省下的不會變回時間，只會變成餘裕（負擔減輕）。這時這一欄是 0，不是失敗，而是事實。"
          }
        }
      }
    },
