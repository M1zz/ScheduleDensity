    "쌓여야 보이는 것까지 전부 열려 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemčeno je všechno, i to, co se ukáže až časem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er åbent, også det, der først viser sig med tiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles ist freigeschaltet – auch das, was erst mit der Zeit sichtbar wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα είναι ανοιχτά, ακόμη κι όσα φαίνονται με τον καιρό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is open, including what shows up over time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is open, including what shows up over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo está desbloqueado, incluido lo que solo se ve con el tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki on avattu, myös se, mikä näkyy vasta ajan myötä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est débloqué, y compris ce qui apparaît avec le temps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya terbuka, termasuk yang baru terlihat seiring waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto è sbloccato, compreso ciò che emerge col tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "積み重なって見えてくるものまで、すべて使えます。"
