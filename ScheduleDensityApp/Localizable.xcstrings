        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free for %lld days, then it bills."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free for %lld days, then it bills."
          }
        },
