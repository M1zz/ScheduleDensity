    "Face ID나 Touch ID로 앱을 잠가 내 일정과 할 일을 지켜요." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkněte aplikaci pomocí Face ID nebo Touch ID a chraňte své události a úkoly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID, og beskyt dine begivenheder og opgaver."
