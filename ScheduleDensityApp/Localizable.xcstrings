            "value" : "Donkere en lichte vakjes"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciemne i jasne komórki"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
