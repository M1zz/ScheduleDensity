    "서로 기다리지 않습니다. 남은 것 중 5분에 집을 수 있는 것부터 세웁니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They don't wait for each other. Whatever's left that fits in five minutes comes first."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서로 기다리지 않습니다. 남은 것 중 5분에 집을 수 있는 것부터 세웁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼此不必等待。剩下的步骤中，五分钟内能做的排在前面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼此不必等待。剩下的步驟中，五分鐘內能做的排在前面。"
          }
        }
      }
    },
