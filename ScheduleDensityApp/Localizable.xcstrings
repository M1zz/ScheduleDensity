    "점선 알약은 시각이 정해지지 않은 것입니다 — 빈 자리에 놓아 본 자리예요. 정확한 시각은 맥앱 ‘무지개 공방’에서 끌어 옮길 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čárkovaná kapsle nemá pevný čas – jen jsme ji zkusmo položili do volného místa. Na přesný čas ji přetáhnete v aplikaci Rainbow Craft na Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En stiplet pille har intet fast klokkeslæt – den er bare sat ind på en ledig plads. Træk den til et præcist tidspunkt i Rainbow Craft på Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine gestrichelte Pille hat keine feste Uhrzeit – sie wurde nur in eine freie Lücke gelegt. Auf eine genaue Uhrzeit ziehst du sie in Rainbow Craft auf dem Mac."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια διακεκομμένη κάψουλα δεν έχει σταθερή ώρα — απλώς μπήκε σε ένα ελεύθερο κενό. Σύρε τη σε ακριβή ώρα στο Rainbow Craft στο Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dashed pill has no fixed time — it's just been dropped into an open slot. Drag it to an exact time in Rainbow Craft on the Mac."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dashed pill has no fixed time — it's just been dropped into an open slot. Drag it to an exact time in Rainbow Craft on the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una píldora punteada no tiene hora fija: solo se ha colocado en un hueco libre. Arrástrala a una hora exacta en Rainbow Craft para Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katkoviivainen pilleri on ilman tarkkaa aikaa – se on vain pudotettu vapaaseen rakoon. Vedä se tarkkaan aikaan Macin Rainbow Craftissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pastille en pointillés n’a pas d’heure fixe : elle a juste été posée dans un créneau libre. Faites-la glisser à une heure précise dans Rainbow Craft sur Mac."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pil bergaris putus-putus belum punya jam pasti — hanya ditaruh di slot yang kosong. Seret ke jam yang tepat di Rainbow Craft di Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pillola tratteggiata non ha un orario fisso: è solo stata messa in uno spazio libero. Trascinala a un orario preciso in Rainbow Craft sul Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点線のピルは時刻が決まっていないものです。空いた場所に仮に置いた位置です。正確な時刻は、MacアプリのRainbow Craftでドラッグして移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점선 알약은 시각이 정해지지 않은 것입니다 — 빈 자리에 놓아 본 자리예요. 정확한 시각은 맥앱 ‘무지개 공방’에서 끌어 옮길 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En stiplet pille har ikke noe fast klokkeslett – den er bare satt inn på en ledig plass. Dra den til et nøyaktig tidspunkt i Rainbow Craft på Mac."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gestippelde pil heeft geen vast tijdstip — hij is alleen in een vrij plekje gezet. Sleep hem in Rainbow Craft op de Mac naar een precies tijdstip."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przerywana pigułka nie ma ustalonej godziny — została tylko wstawiona w wolne miejsce. Dokładną godzinę ustawisz, przeciągając ją w Rainbow Craft na Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pílula tracejada não tem horário fixo — só foi colocada num espaço livre. Arraste para um horário exato no Rainbow Craft para Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пунктирная капсула — это дело без точного времени, его просто поставили в свободное место. Перетащить на точное время можно в Rainbow Craft на Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En streckad bricka har ingen fast tid – den har bara lagts i en ledig lucka. Dra den till en exakt tid i Rainbow Craft på Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แคปซูลเส้นประคือรายการที่ยังไม่กำหนดเวลา แค่วางลงในช่องว่างไว้ก่อน ลากไปยังเวลาที่แน่นอนได้ในแอป Rainbow Craft บน Mac"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesikli hap şeklindekilerin saati belli değildir; yalnızca boş bir yere bırakılmıştır. Mac’teki Rainbow Craft’ta tam bir saate sürükleyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viên thuốc nét đứt là việc chưa có giờ cố định — chỉ mới được thả vào một chỗ trống. Kéo nó sang giờ chính xác trong Rainbow Craft trên Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚线胶囊表示时间尚未确定——只是先放在空档里。可以在 Mac App“彩虹工坊”中拖动到确切的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛線膠囊表示時間尚未確定——只是先放在空檔裡。可以在 Mac App「彩虹工坊」中拖曳到確切的時間。"
          }
        }
      }
    },
