    "시간은 아래에서 위로 쌓여 이 할 일의 소요시간이 됩니다.\n순서 바꾸기·하위 단계는 상세 화면의 ‘단계’에서 합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas se sčítá zdola nahoru do celkové doby tohoto úkolu.\nPořadí a dílčí kroky změníte v části „Kroky“ na obrazovce podrobností."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden lægges sammen nedefra og op til opgavens samlede tid.\nRækkefølge og undertrin findes under Trin på detaljeskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit addiert sich von unten nach oben zur Dauer dieser Aufgabe.\nUmsortieren und Teilschritte findest du in der Detailansicht unter „Schritte“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χρόνος στοιβάζεται από κάτω προς τα πάνω και γίνεται το σύνολο αυτής της εργασίας.\nΗ αλλαγή σειράς και τα επιμέρους βήματα βρίσκονται στα «Βήματα» της οθόνης λεπτομερειών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time stacks from the bottom up into this to-do's total.\nReordering and substeps live under Steps on the detail screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time stacks from the bottom up into this to-do's total.\nReordering and substeps live under Steps on the detail screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo se suma de abajo arriba y da el total de esta tarea.\nPara reordenar y añadir subpasos, ve a Pasos en la pantalla de detalle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aika kertyy alhaalta ylöspäin tämän tehtävän kokonaisajaksi.\nJärjestystä ja alavaiheita muokataan tietonäkymän kohdassa Vaiheet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps s’additionne de bas en haut pour donner la durée de cette tâche.\nL’ordre et les sous-étapes se gèrent dans Étapes, sur l’écran de détail."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu bertumpuk dari bawah ke atas menjadi durasi tugas ini.\nMengubah urutan dan sub-langkah dilakukan di ‘Langkah’ pada layar detail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo si somma dal basso verso l’alto e diventa la durata di questa attività.\nRiordino e sottofasi si gestiscono in “Fasi” nella schermata dei dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間は下から上へ積み上がって、このやることの所要時間になります。\n並べ替えやサブステップは、詳細画面の「ステップ」で行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간은 아래에서 위로 쌓여 이 할 일의 소요시간이 됩니다.\n순서 바꾸기·하위 단계는 상세 화면의 ‘단계’에서 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden legges sammen nedenfra og opp til oppgavens totale tid.\nRekkefølge og undertrinn finner du under Trinn på detaljskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tijd stapelt zich van onder naar boven op tot de duur van deze taak.\nVolgorde wijzigen en deelstappen doe je onder ‘Stappen’ in het detailscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas sumuje się od dołu i daje łączny czas zadania.\nZmiana kolejności i kroki podrzędne są w sekcji „Kroki” na ekranie szczegółów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo se soma de baixo para cima e vira o total desta tarefa.\nPara reordenar e criar subetapas, vá em Etapas na tela de detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время складывается снизу вверх в длительность этой задачи.\nПорядок и подшаги меняются в разделе «Шаги» на экране подробностей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden staplas nerifrån och upp till den här uppgiftens totala tid.\nOrdningen och delstegen ändrar du under Steg på detaljskärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาจะสะสมจากล่างขึ้นบนเป็นเวลารวมของสิ่งที่ต้องทำนี้\nการจัดลำดับและขั้นตอนย่อยอยู่ใน “ขั้นตอน” ในหน้ารายละเอียด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süreler aşağıdan yukarıya toplanarak bu görevin süresini oluşturur.\nSıralama ve alt adımlar ayrıntı ekranındaki Adımlar bölümündedir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian cộng dồn từ dưới lên thành tổng thời gian của việc này.\nĐổi thứ tự và bước con nằm ở mục Các bước trong màn hình chi tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间由下往上累加，成为这个待办事项的所需时间。\n调整顺序与子步骤，请在详细页面的“步骤”中进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間由下往上累加，成為這個待辦事項的所需時間。\n調整順序與子步驟，請在詳細畫面的「步驟」中進行。"
          }
        }
      }
    },
    "시간을 안 적어 두어서, 5분 안에 닫히는지 아직 모릅니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas není zapsaný, takže zatím nevíme, jestli se to uzavře do pěti minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen tid angivet, så det vides endnu ikke, om den lukker på fem minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist keine Dauer eingetragen, deshalb ist noch offen, ob es in fünf Minuten fertig wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει γραφτεί χρόνος, οπότε δεν είναι ακόμη γνωστό αν κλείνει σε πέντε λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No time is written down, so there's no telling yet whether it closes in five minutes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No time is written down, so there's no telling yet whether it closes in five minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay tiempo anotado, así que todavía no se sabe si se cierra en cinco minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikaa ei ole kirjattu, joten vielä ei tiedetä, valmistuuko se viidessä minuutissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune durée indiquée : impossible de savoir encore si cela se boucle en cinq minutes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktunya belum ditulis, jadi belum diketahui apakah tuntas dalam lima menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai indicato una durata, quindi non si sa ancora se si chiude in cinque minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間が書かれていないので、5分で閉じられるかはまだ分かりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간을 안 적어 두어서, 5분 안에 닫히는지 아직 모릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke angitt noen tid, så det er ennå ikke kjent om den avsluttes på fem minutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat geen tijd bij, dus nog niet te zeggen of het binnen vijf minuten af is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zapisano czasu, więc jeszcze nie wiadomo, czy zamknie się w pięć minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há tempo anotado, então ainda não dá para saber se fecha em cinco minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время не указано, поэтому пока неясно, закроется ли шаг за пять минут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tid är angiven, så det går ännu inte att säga om det blir klart på fem minuter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้ใส่เวลา จึงยังไม่รู้ว่าจบได้ใน 5 นาทีหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süre yazılmadığı için beş dakikada kapanıp kapanmadığı henüz bilinmiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa ghi thời gian nên chưa biết có khép lại được trong năm phút không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没写下时间，所以还不知道能不能在五分钟内完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒寫下時間，所以還不知道能不能在五分鐘內完成。"
          }
        }
      }
    },
    "시간을 잡아야 하는 단계는 맥에서 한 주에 놓고, 5분이면 끝나는 단계는 아이폰의 번개로 바로 합니다. 한쪽에서 끝내면 양쪽에서 끝납니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky, které potřebují vyhrazený čas, si na Macu zařadíte do týdne. Pětiminutové kroky uděláte hned na iPhonu s Bleskem. Co dokončíte na jednom zařízení, je hotové na obou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trin, der kræver beskyttet tid, lægges ind i ugen på din Mac. Trin på fem minutter klares med det samme med lynet på iPhone. Gør du ét færdigt det ene sted, er det færdigt begge steder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte, die geschützte Zeit brauchen, planst du auf dem Mac in deine Woche ein. Fünf-Minuten-Schritte erledigst du sofort mit dem Blitz auf dem iPhone. Was auf einer Seite erledigt ist, ist es auf beiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα βήματα που θέλουν προστατευμένο χρόνο μπαίνουν στην εβδομάδα σου στο Mac. Τα πεντάλεπτα βήματα γίνονται αμέσως με την Αστραπή στο iPhone. Όταν ολοκληρώνεις κάτι στη μία πλευρά, ολοκληρώνεται και στις δύο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steps that need protected time go into your week on the Mac. Five-minute steps get done right away with the Bolt on iPhone. Finish one on either side and it's done on both."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steps that need protected time go into your week on the Mac. Five-minute steps get done right away with the Bolt on iPhone. Finish one on either side and it's done on both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos que necesitan tiempo protegido van a tu semana en el Mac. Los de cinco minutos se hacen al momento con el rayo en el iPhone. Si lo terminas en uno, queda terminado en los dos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suojattua aikaa vaativat vaiheet sijoitetaan viikkoon Macilla. Viiden minuutin vaiheet tehdään heti iPhonen salamalla. Kun saat vaiheen valmiiksi toisella, se on valmis molemmilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes qui demandent un temps protégé se placent dans votre semaine sur le Mac. Celles de cinq minutes se font tout de suite avec l’Éclair sur iPhone. Terminée d’un côté, une étape l’est des deux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah yang butuh waktu khusus ditaruh di minggu Anda di Mac, sedangkan langkah lima menit langsung dikerjakan lewat Kilat di iPhone. Selesai di satu sisi, selesai juga di sisi lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fasi che richiedono tempo dedicato vanno nella settimana sul Mac. Quelle da cinque minuti si fanno subito con il Fulmine su iPhone. Se le completi da una parte, risultano completate su entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間を確保すべきステップはMacで1週間の中に置き、5分で終わるステップはiPhoneの稲妻ですぐにやります。どちらかで終えれば、両方で完了になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간을 잡아야 하는 단계는 맥에서 한 주에 놓고, 5분이면 끝나는 단계는 아이폰의 번개로 바로 합니다. 한쪽에서 끝내면 양쪽에서 끝납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinn som trenger skjermet tid, legges inn i uken på Macen. Femminuttstrinn gjøres med en gang med lynet på iPhone. Blir ett ferdig på den ene enheten, er det ferdig på begge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stappen die vrijgehouden tijd nodig hebben, zet je op de Mac in je week. Stappen van vijf minuten doe je meteen met de bliksem op je iPhone. Rond je er één af aan de ene kant, dan is hij aan beide kanten af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroki wymagające chronionego czasu rozkładasz w tygodniu na Macu. Kroki na pięć minut robisz od razu z Błyskawicą na iPhonie. Skończone na jednym urządzeniu są skończone na obu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etapas que precisam de tempo protegido vão para a sua semana no Mac. As de cinco minutos são feitas na hora com o raio no iPhone. Concluiu num, está concluído nos dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаги, которым нужно защищённое время, раскладывайте по неделе на Mac, а пятиминутные делайте сразу с молнией на iPhone. Закончили на одном устройстве — готово на обоих."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steg som behöver skyddad tid läggs in i veckan på Mac. Femminuterssteg görs direkt med blixten på iPhone. Gör du klart ett på ena sidan är det klart på båda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขั้นตอนที่ต้องกันเวลาไว้ให้วางในสัปดาห์บน Mac ส่วนขั้นตอนที่จบใน 5 นาทีให้ทำทันทีด้วยสายฟ้าบน iPhone ทำเสร็จฝั่งไหน ก็เสร็จทั้งสองฝั่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korunan zaman isteyen adımları Mac’te haftanıza yerleştirin; beş dakikalık adımları iPhone’da Şimşek ile hemen yapın. Bir tarafta bitirdiğiniz iş iki tarafta da biter."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những bước cần thời gian giữ riêng thì đặt vào tuần trên Mac. Bước năm phút thì làm ngay bằng Tia chớp trên iPhone. Xong ở bên nào cũng là xong ở cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要留出时间的步骤，在 Mac 上排进一周；五分钟就能做完的步骤，用 iPhone 的闪电马上完成。在任一边完成，两边都会完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要留出時間的步驟，在 Mac 上排進一週；五分鐘就能做完的步驟，用 iPhone 的閃電馬上完成。在任一邊完成，兩邊都會完成。"
          }
        }
      }
    },
    "시동 없이 바로 시작되나요?" : {
