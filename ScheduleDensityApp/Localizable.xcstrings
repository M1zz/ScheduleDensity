    "해마다 결제되고 언제든 해지합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účtováno ročně. Zrušit můžete kdykoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betales årligt. Opsig når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jährliche Abrechnung. Jederzeit kündbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ετήσια χρέωση. Ακύρωση οποτεδήποτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bills yearly, cancel any time."
          }
        },
