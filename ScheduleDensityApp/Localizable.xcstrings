    "%lld일 무료로 써 보고, 그 뒤에 결제됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarma po dobu %lld dnů, poté placené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis i %lld dage, derefter betaling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Tage kostenlos, danach kostenpflichtig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν για %lld ημέρες, μετά χρέωση."
