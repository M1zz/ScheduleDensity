    "회수와 회복 기록만 지웁니다. 할 일은 그대로입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaže jen záznamy o získaném čase a oddechu. Úkoly zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rydder kun registreringerne af genvundet tid og restitution. Dine opgaver bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht nur die Einträge zu gewonnener Zeit und Erholung. Deine Aufgaben bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει μόνο τις καταγραφές ανάκτησης και ανάκαμψης. Οι εργασίες σου μένουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears only the recovery records. Your to-dos stay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears only the recovery records. Your to-dos stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo borra los registros de recuperación. Tus tareas se quedan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjentää vain palautumismerkinnät. Tehtäväsi säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’efface que les relevés de temps récupéré et de récupération. Vos tâches restent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya menghapus catatan waktu yang didapat kembali dan pemulihan. Tugas Anda tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella solo i registri di recupero. Le attività restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回収と回復の記録だけを消去します。やることはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회수와 회복 기록만 지웁니다. 할 일은 그대로입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter bare registreringene av gjenvunnet tid og restitusjon. Oppgavene dine blir værende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist alleen de gegevens over teruggewonnen tijd en herstel. Je taken blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa tylko zapisy odzyskanego czasu i regeneracji. Zadania zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga só os registros de recuperação. Suas tarefas continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляются только записи о возвращённом времени и отдыхе. Задачи остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rensar bara återhämtningsposterna. Dina uppgifter finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล้างเฉพาะบันทึกการได้คืนและการฟื้นตัว สิ่งที่ต้องทำยังอยู่"
