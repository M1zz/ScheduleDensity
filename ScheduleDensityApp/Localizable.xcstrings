    "‘%@’을(를) 지우면 이 분류를 쓰던 할 일 %lld개가 미분류로 바뀝니다.\n할 일 자체는 지워지지 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazáním „%@“ se úkoly, které tuto kategorii používají (%lld), přesunou do kategorie Bez kategorie.\nSamotné úkoly zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter du “%@”, bliver de %lld opgaver, der bruger den, til Uden kategori.\nSelve opgaverne bliver ikke slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du „%@“ löschst, landen die %lld Aufgaben dieser Kategorie unter „Ohne Kategorie“.\nDie Aufgaben selbst bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν διαγράψεις την κατηγορία «%@», οι %lld εργασίες που τη χρησιμοποιούν θα γίνουν «Χωρίς κατηγορία».\nΟι ίδιες οι εργασίες δεν διαγράφονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting '%@' turns the %lld to-dos using it into Uncategorized.\nThe to-dos themselves stay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting '%@' turns the %lld to-dos using it into Uncategorised.\nThe to-dos themselves stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eliminas “%@”, las %lld tareas de esta categoría pasarán a Sin categoría.\nLas tareas en sí no se eliminan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos poistat luokan ”%@”, sitä käyttävät %lld tehtävää muuttuvat luokittelemattomiksi.\nItse tehtävät säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer « %@ » fera passer les %lld tâches qui l’utilisent en Sans catégorie.\nLes tâches elles-mêmes sont conservées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika “%@” dihapus, %lld tugas yang memakai kategori ini akan menjadi Tanpa kategori.\nTugasnya sendiri tidak ikut terhapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimini “%@”, le %lld attività che la usano diventeranno Senza categoria.\nLe attività non vengono eliminate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除すると、このカテゴリを使っているやること%lld件が「未分類」になります。\nやること自体は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’을(를) 지우면 이 분류를 쓰던 할 일 %lld개가 미분류로 바뀝니다.\n할 일 자체는 지워지지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter du «%@», blir de %lld oppgavene som bruker den, satt til Uten kategori.\nSelve oppgavene blir ikke slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je ‘%@’ verwijdert, worden de %lld taken in deze categorie ‘Zonder categorie’.\nDe taken zelf blijven bestaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie „%@” sprawi, że zadania z tą kategorią (%lld) staną się zadaniami bez kategorii.\nSame zadania nie zostaną usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao apagar “%@”, as %lld tarefas desta categoria passam para Sem categoria.\nAs tarefas em si não são apagadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если удалить «%@», задачи с этой категорией (%lld) станут «Без категории».\nСами задачи не удалятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du raderar ”%@” blir de %lld uppgifter som använder den Okategoriserade.\nSjälva uppgifterna finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากลบ “%@” สิ่งที่ต้องทำ %lld รายการที่ใช้หมวดหมู่นี้จะกลายเป็น “ไม่มีหมวดหมู่”\nตัวสิ่งที่ต้องทำจะไม่ถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” silinirse bu kategoriyi kullanan %lld görev Kategorisiz olur.\nGörevlerin kendisi silinmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa “%@” sẽ chuyển %lld việc cần làm đang dùng danh mục này sang Chưa phân loại.\nBản thân các việc vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除“%@”后，使用此分类的 %lld 个待办事项会变成未分类。\n待办事项本身不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除「%@」後，使用此分類的 %lld 個待辦事項會變成未分類。\n待辦事項本身不會被刪除。"
          }
        }
      }
    },
