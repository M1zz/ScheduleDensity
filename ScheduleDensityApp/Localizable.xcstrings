    "직접 시작한 타이머가 있을 때만 줄이 섭니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bar appears only when a timer you started is running."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 시작한 타이머가 있을 때만 줄이 섭니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你自己啟動計時器時才會顯示橫條。"
          }
        }
      }
    },
    "직접 정한 답입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You answered this yourself."
          }
        },
        "ko" : {
