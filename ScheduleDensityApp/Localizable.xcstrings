          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回買えばそれきりです。サブスクリプションではなく、同じApple Accountのほかのデバイスでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 사면 끝입니다. 구독이 아니고, 같은 Apple 계정의 다른 기기에서도 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøp den én gang, så er du ferdig. Det er ikke et abonnement, og den låses opp på de andre enhetene dine med samme Apple-konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
