    "무지개, 할 일 쪼개기, 두 질문, 단계 순서는 값을 받지 않습니다. 한 번 사면 끝이고 구독이 아닙니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duha, dělení úkolů, dvě otázky a pořadí kroků jsou zdarma. Platíte jednou, není to předplatné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regnbuen, opdeling, de to spørgsmål og trinrækkefølge koster intet. Ét køb, intet abonnement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regenbogen, Aufteilen, die zwei Fragen und die Schrittfolge kosten nichts. Einmal kaufen, kein Abo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ουράνιο τόξο, ο χωρισμός εργασιών, οι δύο ερωτήσεις και η σειρά βημάτων δεν κοστίζουν τίποτα. Μία αγορά, χωρίς συνδρομή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Rainbow, splitting, the two questions, and step order cost nothing. One purchase, no subscription."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Rainbow, splitting, the two questions, and step order cost nothing. One purchase, no subscription."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El arcoíris, dividir tareas, las dos preguntas y el orden de los pasos no cuestan nada. Pagas una vez y es tuyo: no es una suscripción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sateenkaari, pilkkominen, kaksi kysymystä ja vaiheiden järjestys ovat maksuttomia. Yksi osto, ei tilausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Arc-en-ciel, le découpage, les deux questions et l’ordre des étapes sont gratuits. Un seul achat, pas d’abonnement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelangi, memecah tugas, dua pertanyaan, dan urutan langkah tidak berbayar. Sekali beli, bukan langganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Arcobaleno, la suddivisione, le due domande e l’ordine delle fasi sono gratuiti. Un solo acquisto, nessun abbonamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虹、やることの分割、2つの問い、ステップの順番は無料です。1回買えばそれきりで、サブスクリプションではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무지개, 할 일 쪼개기, 두 질문, 단계 순서는 값을 받지 않습니다. 한 번 사면 끝이고 구독이 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regnbuen, oppdeling, de to spørsmålene og trinnrekkefølge koster ingenting. Ett kjøp, ikke noe abonnement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De regenboog, opsplitsen, de twee vragen en de stapvolgorde zijn gratis. Eén keer kopen, geen abonnement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tęcza, dzielenie zadań, dwa pytania i kolejność kroków są za darmo. Jeden zakup, bez subskrypcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arco-íris, dividir tarefas, as duas perguntas e a ordem das etapas não custam nada. Pague uma vez e é seu: não é assinatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Радуга, разбивка задач, два вопроса и порядок шагов — бесплатно. Покупка разовая, не подписка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regnbågen, uppdelningen, de två frågorna och stegordningen kostar ingenting. Ett köp, ingen prenumeration."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สายรุ้ง การแบ่งสิ่งที่ต้องทำ สองคำถาม และลำดับขั้นตอน ใช้ได้ฟรี ซื้อครั้งเดียวจบ ไม่ใช่การสมัครสมาชิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gökkuşağı, görev bölme, iki soru ve adım sırası ücretsizdir. Tek seferlik satın alma, abonelik yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cầu vồng, chia nhỏ việc, hai câu hỏi và thứ tự bước đều miễn phí. Mua một lần, không phải gói đăng ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彩虹、拆分待办事项、两个问题、步骤顺序都不收费。买一次就好，不是订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彩虹、拆分待辦事項、兩個問題、步驟順序都不收費。買一次就好，不是訂閱。"
          }
        }
      }
    },
    "무지개, 할 일 쪼개기, 두 질문, 단계 순서는 그대로 쓰십니다. 곁다리 %lld가지가 잠겨 있습니다." : {
