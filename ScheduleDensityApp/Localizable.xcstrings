        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맥락을 다시 읽어 와야 하는 일은 조각에서 시동만 걸다 끝납니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
