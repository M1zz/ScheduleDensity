    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: larger text layouts",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I při větším písmu se nic neořízne a vše se úhledně přeskládá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med større tekst bliver intet skåret af, og alt placeres pænt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei größerer Schrift wird nichts abgeschnitten, alles ordnet sich sauber neu an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμα και με μεγαλύτερα γράμματα, τίποτα δεν κόβεται και όλα τακτοποιούνται σωστά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bigger text sizes fit neatly without getting cut off."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bigger text sizes fit neatly without getting cut off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque aumentes el tamaño del texto, nada se corta y todo se reorganiza bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isompikaan teksti ei leikkaudu, vaan kaikki asettuu siististi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même en agrandissant le texte, rien n’est coupé et tout se réorganise proprement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski ukuran teks diperbesar, tidak ada yang terpotong dan semuanya tertata rapi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con il testo ingrandito niente viene tagliato e tutto si riordina bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても切れずに、見やすく並び直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med større tekst blir ingenting kuttet, og alt plasseres pent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook met grotere tekst wordt niets afgekapt en staat alles netjes op zijn plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet przy większym tekście nic się nie ucina, a wszystko ładnie się układa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com o texto maior, nada fica cortado e tudo se reorganiza bem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже с крупным шрифтом ничего не обрезается, всё аккуратно перестраивается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även med större text klipps inget av, och allt placeras snyggt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้ขยายตัวอักษร ก็ไม่ถูกตัดและจัดวางใหม่ให้อ่านง่าย"
