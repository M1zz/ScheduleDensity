    "짧게 잡아 두어도 여기서 끝나지는 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani při krátkém naplánování se to tady nedokončí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med kort tid sat af bliver den ikke færdig her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst knapp eingeplant wird es hier nicht fertig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη κι αν το προγραμματίσεις σύντομο, δεν θα τελειώσει εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even with a short time set, it won't end here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even with a short time set, it won't end here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque le hayas dado poco tiempo, aquí no se termina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyhyeksi varattunakaan se ei valmistu tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même prévu court, cela ne se terminera pas ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski dijadwalkan singkat, ini tidak akan selesai di sini."
