    "그날 한꺼번에 굴리고 있는 일의 개수입니다. 일곱 칸이 다 차 가면 하나만 어긋나도 그 날 전체가 밀려요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolik věcí ten den táhnete najednou. Jakmile se zaplní všech sedm políček, stačí jedno zaškobrtnutí a posune se celý den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange opgaver du jonglerer med på én gang den dag. Når alle syv felter er ved at være fyldt, skubber én forsinkelse hele dagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So viele Dinge hast du an diesem Tag gleichzeitig am Laufen. Sind alle sieben Kästchen fast voll, verschiebt eine kleine Panne den ganzen Tag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσες δουλειές τρέχεις ταυτόχρονα εκείνη τη μέρα. Όταν γεμίσουν και τα επτά κελιά, μία καθυστέρηση μετακινεί όλη τη μέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many jobs you're rolling at once that day. Once all seven cells fill up, one slip pushes the whole day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many jobs you're rolling at once that day. Once all seven cells fill up, one slip pushes the whole day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas cosas llevas a la vez ese día. Cuando se llenan las siete celdas, un solo desajuste desplaza el día entero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montako asiaa pyörität sinä päivänä yhtä aikaa. Kun kaikki seitsemän ruutua alkavat täyttyä, yksikin lipsahdus siirtää koko päivää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre de choses que vous menez de front ce jour-là. Quand les sept cases se remplissent, un seul imprévu décale toute la journée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah pekerjaan yang Anda jalankan bersamaan hari itu. Begitu ketujuh kotak hampir penuh, satu meleset saja bisa menggeser seluruh hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti lavori porti avanti insieme quel giorno. Quando tutte e sette le celle si riempiono, basta un intoppo per far slittare l’intera giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その日に同時に回している仕事の数です。7つのマスが埋まってくると、ひとつずれただけでその日全体がずれ込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그날 한꺼번에 굴리고 있는 일의 개수입니다. 일곱 칸이 다 차 가면 하나만 어긋나도 그 날 전체가 밀려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange oppgaver du sjonglerer samtidig den dagen. Når alle sju rutene begynner å bli fulle, skyver én forsinkelse hele dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel klussen je die dag tegelijk draaiende houdt. Zodra alle zeven vakjes vol raken, schuift de hele dag op als er één misgaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyle spraw toczysz jednocześnie tego dnia. Gdy wszystkie siedem komórek się zapełni, jedno opóźnienie przesuwa cały dzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantas coisas você está tocando ao mesmo tempo naquele dia. Quando as sete células enchem, um único deslize empurra o dia inteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько дел вы ведёте одновременно в этот день. Когда заполнены все семь клеток, одна заминка сдвигает весь день."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur många jobb du har igång samtidigt den dagen. När alla sju rutor börjar fyllas räcker en miss för att hela dagen ska skjutas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนงานที่คุณหมุนพร้อมกันในวันนั้น เมื่อเจ็ดช่องเริ่มเต็ม แค่งานเดียวคลาดก็ทำให้ทั้งวันเลื่อนไปหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gün aynı anda yürüttüğünüz işlerin sayısı. Yedi hücre dolmaya başlayınca tek bir aksama bütün günü kaydırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số việc bạn đang cùng lúc xoay xở trong ngày đó. Khi cả bảy ô gần kín, chỉ một việc trễ cũng đẩy lùi cả ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是那天同时在进行的事情数量。七格快满时，只要一件出错，整天都会往后推。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是那天同時在進行的事情數量。七格快滿時，只要一件出錯，整天都會往後延。"
          }
        }
      }
    },
