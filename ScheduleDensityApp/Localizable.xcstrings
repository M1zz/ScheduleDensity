    "서로 기다리지 않습니다. 남은 것 중 5분에 집을 수 있는 것부터 세웁니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky na sebe nečekají. Nahoru jde to, co ze zbytku stihnete za pět minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De venter ikke på hinanden. Det, der er tilbage og passer i fem minutter, kommer først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie warten nicht aufeinander. Was übrig ist und in fünf Minuten geht, kommt zuerst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν περιμένουν το ένα το άλλο. Ό,τι απομένει και χωράει σε πέντε λεπτά μπαίνει πρώτο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They don't wait for each other. Whatever's left that fits in five minutes comes first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They don't wait for each other. Whatever's left that fits in five minutes comes first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se esperan entre sí. Primero va lo que quede y quepa en cinco minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne eivät odota toisiaan. Jäljellä olevista ensimmäisinä ovat ne, jotka mahtuvat viiteen minuuttiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles ne s’attendent pas. Parmi ce qui reste, ce qui tient en cinq minutes passe en premier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak saling menunggu. Yang tersisa dan bisa diambil dalam lima menit diletakkan lebih dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si aspettano a vicenda. Prima viene ciò che resta e si fa in cinque minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お互いを待ちません。残りの中から5分で手に取れるものを先に並べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서로 기다리지 않습니다. 남은 것 중 5분에 집을 수 있는 것부터 세웁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De venter ikke på hverandre. Det som er igjen og passer i fem minutter, kommer først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze wachten niet op elkaar. Wat er over is en in vijf minuten past, komt eerst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroki nie czekają na siebie. Najpierw to, co z pozostałych da się zrobić w pięć minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma não espera a outra. Vem primeiro o que sobrou e cabe em cinco minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаги не ждут друг друга. Первым встаёт то, что из оставшегося можно сделать за пять минут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De väntar inte på varandra. Det som är kvar och ryms på fem minuter kommer först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องรอกัน จากที่เหลือ อันไหนหยิบทำได้ใน 5 นาทีจะขึ้นมาก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birbirlerini beklemezler. Kalanlar arasında beş dakikaya sığanlar önce gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bước không chờ nhau. Trong số còn lại, bước nào làm được trong năm phút sẽ lên trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼此不必等待。剩下的步骤中，五分钟内能做的排在前面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼此不必等待。剩下的步驟中，五分鐘內能做的排在前面。"
          }
        }
      }
    },
