        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Rainbow Craft για Mac ανοίγει την ίδια λίστα εργασιών και σε βοηθά να βρεις θέση στην εβδομάδα σου για καθεμιά."
          }
        },
        "en" : {
