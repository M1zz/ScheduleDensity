          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell to read it; press and hold to edit or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una celda para verla; mantenla pulsada para editarla o eliminarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta ruutua lukeaksesi sen; paina pitkään muokataksesi tai poistaaksesi."
