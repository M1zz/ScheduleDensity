    "같은 Apple 계정이면 양쪽에서 보입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se stejným Apple účtem se úkoly zobrazí na obou zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med samme Apple-konto vises opgaverne begge steder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit demselben Apple Account auf beiden sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τον ίδιο Λογαριασμό Apple, εμφανίζονται και στις δύο συσκευές."
