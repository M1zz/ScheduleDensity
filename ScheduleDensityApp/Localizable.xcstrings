            "value" : "Tap + at the top right and write down this week's work."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 위 + 를 눌러 이번 주에 할 일을 적어보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
