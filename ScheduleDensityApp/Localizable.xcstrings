    "줄을 누르면 마지막 단계가 되돌아옵니다. 왼쪽으로 밀면 지웁니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na řádek vrátíte poslední krok. Přejetím doleva ho smažete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en linje for at hente det sidste trin tilbage. Swipe til venstre for at slette den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Zeile, um den letzten Schritt zurückzuholen. Nach links wischen zum Löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα μια γραμμή για να επιστρέψει το τελευταίο βήμα. Σύρε αριστερά για διαγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a line to bring the last step back. Swipe left to delete it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a line to bring the last step back. Swipe left to delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una línea para recuperar el último paso. Desliza a la izquierda para eliminarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta riviä palauttaaksesi viimeisen vaiheen. Poista pyyhkäisemällä vasemmalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une ligne pour faire revenir la dernière étape. Balayez vers la gauche pour la supprimer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk baris untuk mengembalikan langkah terakhir. Geser ke kiri untuk menghapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una riga per recuperare l’ultima fase. Scorri a sinistra per eliminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行をタップすると最後のステップが戻ります。左にスワイプすると削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄을 누르면 마지막 단계가 되돌아옵니다. 왼쪽으로 밀면 지웁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en linje for å hente tilbake det siste trinnet. Sveip til venstre for å slette den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een regel om de laatste stap terug te halen. Veeg naar links om te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij linijkę, aby przywrócić ostatni krok. Przesuń w lewo, aby usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque numa linha para trazer de volta a última etapa. Deslize para a esquerda para apagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на строку, чтобы вернуть последний шаг. Смахните влево, чтобы удалить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en rad för att få tillbaka det sista steget. Svep åt vänster för att radera den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะบรรทัดเพื่อนำขั้นตอนสุดท้ายกลับมา ปัดซ้ายเพื่อลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son adımı geri getirmek için bir satıra dokunun. Silmek için sola kaydırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào một dòng để lấy lại bước cuối. Vuốt sang trái để xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点该列可以找回最后一个步骤。向左滑动即可删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下該列可以找回最後一個步驟。向左滑動即可刪除。"
          }
        }
      }
    },
    "줄을 세우지 않습니다. 타이머는 그대로 돌고 잠금화면에서 봅니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lišta se nezobrazí. Časovač běží dál a uvidíte ho na zamčené obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen bjælke. Timeren kører stadig, og du kan se den på låseskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Balken. Der Timer läuft trotzdem, und du siehst ihn auf dem Sperrbildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς μπάρα. Το χρονόμετρο συνεχίζει και το βλέπεις στην οθόνη κλειδώματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No bar. The timer still runs, and you can see it on the Lock Screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No bar. The timer still runs, and you can see it on the Lock Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin barra. El temporizador sigue en marcha y lo ves en la pantalla bloqueada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei palkkia. Ajastin käy silti, ja näet sen lukitusnäytöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de barre. Le minuteur continue et reste visible sur l’écran verrouillé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilah tidak ditampilkan. Timer tetap berjalan dan bisa dilihat di Layar Terkunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna barra. Il timer continua e lo vedi sulla schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーは表示しません。タイマーはそのまま動き、ロック画面で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄을 세우지 않습니다. 타이머는 그대로 돌고 잠금화면에서 봅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen linje. Tidtakeren går fortsatt, og du kan se den på låseskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen balk. De timer loopt gewoon door en je ziet hem op het toegangsscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez paska. Timer nadal działa i widać go na ekranie blokady."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem barra. O timer continua rodando e aparece na Tela Bloqueada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без полосы. Таймер продолжает идти, его видно на экране блокировки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen stapel. Timern går ändå och syns på låsskärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่แสดงแถบ ตัวจับเวลายังทำงานต่อ และดูได้บนหน้าจอล็อก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubuk yok. Zamanlayıcı çalışmaya devam eder, Kilitli Ekran’da görebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiện thanh. Bộ hẹn giờ vẫn chạy và bạn xem được trên Màn hình khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不显示横条。计时器照常运作，可在锁定屏幕查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不顯示橫條。計時器照常運作，可在鎖定畫面查看。"
          }
        }
      }
    },
