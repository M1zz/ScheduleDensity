    "계획에 적힌 시간을 거꾸로 셉니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpočítává čas zapsaný v plánu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tæller ned fra den tid, der står i din plan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt die Zeit aus deinem Plan herunter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά αντίστροφα τον χρόνο που έγραψες στο πλάνο σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts down the time written in your plan."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts down the time written in your plan."
          }
        },
