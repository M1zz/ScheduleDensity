    "한 번 사면 끝입니다. 구독이 아니고, 같은 Apple 계정의 다른 기기에서도 열립니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy it once and you're done. It isn't a subscription, and it opens on your other devices with the same Apple Account."
          }
        },
        "ko" : {
          "stringUnit" : {
