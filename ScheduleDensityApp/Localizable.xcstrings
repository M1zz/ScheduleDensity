    "고른 날 하루에 들어가는 시간이에요. 이 숫자가 그날이 얼마나 차는지를 정합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolik hodin to zabere v každý vybraný den. Toto číslo určuje, jak plný ten den bude."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timerne, det tager på hver af de dage, du har valgt. Tallet bestemmer, hvor fyldt dagen bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So viele Stunden fallen an jedem gewählten Tag an. Diese Zahl bestimmt, wie voll der Tag wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ώρες που παίρνει σε κάθε μέρα που διάλεξες. Αυτός ο αριθμός ορίζει πόσο γεμίζει εκείνη η μέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hours this takes on each day you picked. This number decides how full that day gets."
