    "시작일부터 종료일까지가 이 일정에 매여 있는 기간이고, 그중 고른 날에만 시간이 실제로 들어갑니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od začátku do konce vás tato událost drží; čas reálně zabírají jen vybrané dny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra start til slut er, hvor længe den binder dig; kun de dage, du har valgt, tager faktisk timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Start bis zum Ende bindet dich dieser Termin; Zeit kostet er aber nur an den gewählten Tagen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από την έναρξη ως τη λήξη είναι ο χρόνος που σε δεσμεύει αυτό το συμβάν· μόνο οι μέρες που διάλεξες παίρνουν πραγματικά ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start to end is how long this holds you; only the days you picked actually take hours."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start to end is how long this holds you; only the days you picked actually take hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del inicio al fin es el tiempo que esto te tiene atado; solo los días que elegiste ocupan horas de verdad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alusta loppuun on aika, jonka tämä sitoo sinua; vain valitsemasi päivät vievät oikeasti tunteja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du début à la fin, c’est la période où cet événement vous mobilise ; seuls les jours choisis prennent réellement des heures."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari tanggal mulai sampai tanggal selesai adalah masa jadwal ini mengikat Anda, dan waktu benar-benar terpakai hanya di hari yang Anda pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dall’inizio alla fine è il periodo in cui questo evento ti impegna; le ore vengono occupate solo nei giorni scelti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始日から終了日までがこの予定にとられている期間で、そのうち選んだ日にだけ実際に時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작일부터 종료일까지가 이 일정에 매여 있는 기간이고, 그중 고른 날에만 시간이 실제로 들어갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra start til slutt er hvor lenge den binder deg; bare dagene du har valgt, tar faktisk timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van begin tot eind is hoelang dit je bezighoudt; alleen op de dagen die je kiest, gaan er echt uren in zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od początku do końca to czas, w którym to wydarzenie Cię wiąże; godziny zajmują tylko wybrane dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do início ao fim é o tempo em que isto prende você; só os dias escolhidos ocupam horas de verdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От начала до конца — это время, пока дело вас держит; часы занимают только выбранные дни."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från start till slut är hur länge det här binder dig; bara dagarna du valt tar faktiskt timmar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งแต่วันเริ่มต้นถึงวันสิ้นสุดคือช่วงที่กิจกรรมนี้ผูกคุณไว้ และจะใช้เวลาจริงเฉพาะวันที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlangıçtan bitişe kadarki süre bu etkinliğin sizi bağlı tuttuğu dönemdir; bunlardan yalnızca seçtiğiniz günlere gerçekten zaman ayrılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ ngày bắt đầu đến ngày kết thúc là khoảng thời gian sự kiện này giữ chân bạn; chỉ những ngày bạn chọn mới thực sự tốn giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从开始日期到结束日期，是这个日程绑住你的期间；其中只有你选的日子会实际投入时间。"
          }
        },
        "zh-Hant" : {
