    "시간 분석에서 자유시간 중 수면시간을 별도로 표시합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V analýze času zobrazí spánek odděleně od volného času."
