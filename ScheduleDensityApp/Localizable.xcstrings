    "여기서 적은 할 일이 맥에서도 보입니다. 적는 것 자체는 무료입니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To-dos you write here show up on your Mac. Writing itself is free."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 적은 할 일이 맥에서도 보입니다. 적는 것 자체는 무료입니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡寫下的待辦事項，在 Mac 上也看得到。寫下本身是免費的。"
