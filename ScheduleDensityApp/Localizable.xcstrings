    "이번 주에 걸쳐 있는 일정입니다. 누르면 단계로 쪼개어 이번 주 할 일로 가져옵니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Události, které zasahují do tohoto týdne. Klepnutím je rozdělíte na kroky a přenesete do úkolů na tento týden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begivenheder, der løber gennem denne uge. Tryk på en for at dele den op i trin og føje den til ugens opgaver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine, die in diese Woche reichen. Tippe auf einen, um ihn in Schritte aufzuteilen und in die Aufgaben dieser Woche zu holen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμβάντα που διατρέχουν αυτή την εβδομάδα. Πάτα ένα για να το χωρίσεις σε βήματα και να το φέρεις στις εργασίες της εβδομάδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Events that run through this week. Tap one to split it into steps and bring it into this week's to-dos."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Events that run through this week. Tap one to split it into steps and bring it into this week's to-dos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos que abarcan esta semana. Toca uno para dividirlo en pasos y traerlo a las tareas de esta semana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä viikolla käynnissä olevat tapahtumat. Napauta yhtä pilkkoaksesi sen vaiheiksi ja tuodaksesi sen viikon tehtäviin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Événements qui traversent cette semaine. Touchez-en un pour le découper en étapes et l’ajouter aux tâches de la semaine."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadwal yang berjalan sepanjang minggu ini. Ketuk untuk memecahnya jadi langkah dan memasukkannya ke tugas minggu ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventi che attraversano questa settimana. Toccane uno per suddividerlo in fasi e portarlo tra le attività di questa settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週にまたがる予定です。タップするとステップに分けて、今週のやることに取り込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주에 걸쳐 있는 일정입니다. 누르면 단계로 쪼개어 이번 주 할 일로 가져옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hendelser som går gjennom denne uken. Trykk på en for å dele den opp i trinn og legge den til ukens oppgaver."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activiteiten die door deze week lopen. Tik erop om ze in stappen op te splitsen en naar je taken van deze week te halen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydarzenia trwające w tym tygodniu. Stuknij jedno, aby podzielić je na kroki i dodać do zadań na ten tydzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos que atravessam esta semana. Toque num deles para dividir em etapas e trazer para as tarefas da semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "События, которые идут на этой неделе. Нажмите, чтобы разбить на шаги и добавить в задачи недели."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Händelser som pågår den här veckan. Tryck på en för att dela upp den i steg och föra in den bland veckans uppgifter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กิจกรรมที่คร่อมสัปดาห์นี้ แตะเพื่อแบ่งเป็นขั้นตอนแล้วนำเข้ามาเป็นสิ่งที่ต้องทำสัปดาห์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu haftaya yayılan etkinlikler. Birine dokunarak adımlara bölün ve bu haftanın görevlerine getirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những sự kiện kéo dài qua tuần này. Chạm vào một sự kiện để chia thành các bước và đưa vào việc cần làm tuần này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是横跨本周的日程。轻点即可拆分成步骤，带进本周待办事项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是橫跨本週的行程。點一下即可拆分成步驟，帶進本週待辦事項。"
          }
        }
      }
    },
    "이번 주에 걸쳐 있는 일정입니다. 누르면 단계로 쪼개어 이번 주 할 일로 가져옵니다.\n마감이 더 먼 일정 %lld개는 때가 되면 여기 올라옵니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Události, které zasahují do tohoto týdne. Klepnutím je rozdělíte na kroky a přenesete do úkolů na tento týden.\nUdálosti se vzdálenějším termínem (%lld) se tu objeví, až přijde jejich čas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begivenheder, der løber gennem denne uge. Tryk på en for at dele den op i trin og føje den til ugens opgaver.\n%lld begivenheder med senere frister dukker op her, når det bliver deres tur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine, die in diese Woche reichen. Tippe auf einen, um ihn in Schritte aufzuteilen und in die Aufgaben dieser Woche zu holen.\n%lld Termine mit späterer Deadline tauchen hier auf, wenn es so weit ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμβάντα που διατρέχουν αυτή την εβδομάδα. Πάτα ένα για να το χωρίσεις σε βήματα και να το φέρεις στις εργασίες της εβδομάδας.\n%lld συμβάντα με μεταγενέστερη προθεσμία θα εμφανιστούν εδώ όταν έρθει η ώρα τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Events that run through this week. Tap one to split it into steps and bring it into this week's to-dos.\n%lld events with later deadlines will come up here when their time arrives."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Events that run through this week. Tap one to split it into steps and bring it into this week's to-dos.\n%lld events with later deadlines will come up here when their time arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos que abarcan esta semana. Toca uno para dividirlo en pasos y traerlo a las tareas de esta semana.\nLos %lld eventos con fechas límite más lejanas aparecerán aquí cuando les llegue el momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä viikolla käynnissä olevat tapahtumat. Napauta yhtä pilkkoaksesi sen vaiheiksi ja tuodaksesi sen viikon tehtäviin.\n%lld tapahtumaa, joiden määräaika on myöhemmin, ilmestyy tähän ajallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Événements qui traversent cette semaine. Touchez-en un pour le découper en étapes et l’ajouter aux tâches de la semaine.\n%lld événements à échéance plus lointaine apparaîtront ici le moment venu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadwal yang berjalan sepanjang minggu ini. Ketuk untuk memecahnya jadi langkah dan memasukkannya ke tugas minggu ini.\n%lld jadwal dengan tenggat lebih jauh akan muncul di sini saat waktunya tiba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventi che attraversano questa settimana. Toccane uno per suddividerlo in fasi e portarlo tra le attività di questa settimana.\nI %lld eventi con scadenze più lontane compariranno qui al momento giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週にまたがる予定です。タップするとステップに分けて、今週のやることに取り込みます。\n締め切りがもっと先の予定%lld件は、時期が来たらここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주에 걸쳐 있는 일정입니다. 누르면 단계로 쪼개어 이번 주 할 일로 가져옵니다.\n마감이 더 먼 일정 %lld개는 때가 되면 여기 올라옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hendelser som går gjennom denne uken. Trykk på en for å dele den opp i trinn og legge den til ukens oppgaver.\n%lld hendelser med senere frister dukker opp her når det blir deres tur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activiteiten die door deze week lopen. Tik erop om ze in stappen op te splitsen en naar je taken van deze week te halen.\n%lld activiteiten met een latere deadline komen hier vanzelf als het zover is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydarzenia trwające w tym tygodniu. Stuknij jedno, aby podzielić je na kroki i dodać do zadań na ten tydzień.\nWydarzenia z późniejszym terminem (%lld) pojawią się tu, gdy przyjdzie ich czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos que atravessam esta semana. Toque num deles para dividir em etapas e trazer para as tarefas da semana.\n%lld eventos com prazos mais distantes vão aparecer aqui quando chegar a hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "События, которые идут на этой неделе. Нажмите, чтобы разбить на шаги и добавить в задачи недели.\nСобытия с более поздним дедлайном (%lld) появятся здесь, когда придёт их время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Händelser som pågår den här veckan. Tryck på en för att dela upp den i steg och föra in den bland veckans uppgifter.\n%lld händelser med senare deadline dyker upp här när det är dags."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กิจกรรมที่คร่อมสัปดาห์นี้ แตะเพื่อแบ่งเป็นขั้นตอนแล้วนำเข้ามาเป็นสิ่งที่ต้องทำสัปดาห์นี้\nกิจกรรมอีก %lld รายการที่กำหนดส่งไกลกว่านี้จะขึ้นมาที่นี่เมื่อถึงเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu haftaya yayılan etkinlikler. Birine dokunarak adımlara bölün ve bu haftanın görevlerine getirin.\nSon tarihi daha ileride olan %lld etkinlik, zamanı gelince burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những sự kiện kéo dài qua tuần này. Chạm vào một sự kiện để chia thành các bước và đưa vào việc cần làm tuần này.\n%lld sự kiện có hạn xa hơn sẽ hiện ở đây khi đến lúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横跨本周的日程。轻点即可拆成步骤，带进本周的待办事项。\n截止较远的 %lld 个日程，时候到了就会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "橫跨本週的行程。點一下即可拆成步驟，帶進本週的待辦事項。\n截止較遠的 %lld 個行程，時候到了就會出現在這裡。"
          }
        }
      }
    },
