    "일정 데이터는 기기에만 저장되며\n외부로 전송되지 않습니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data událostí zůstávají jen v zařízení\na nikam se neodesílají"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data om begivenheder bliver på denne enhed\nog sendes aldrig nogen steder hen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termindaten bleiben auf diesem Gerät\nund werden nirgendwohin gesendet"
