    "일정의 전체 길이로 셉니다. 이미 지난 만큼은 흐른 채로 시작합니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá se celá délka události; čas, který už uplynul, se bere jako uběhlý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tæller hele planens længde, og den tid, der allerede er gået, regnes som forløbet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt die ganze Länge des Termins; was schon vorbei ist, gilt als verstrichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά όλη τη διάρκεια του πλάνου, με τον χρόνο που έχει ήδη περάσει ως παρελθόντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts the whole length of the plan, with the time already past counted as elapsed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts the whole length of the plan, with the time already past counted as elapsed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta toda la duración del evento; el tiempo que ya pasó se da por transcurrido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee suunnitelman koko keston; jo kulunut aika lasketaan kuluneeksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte toute la durée du planning, en considérant le temps déjà passé comme écoulé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihitung dari panjang jadwal secara utuh. Waktu yang sudah lewat dianggap sudah berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta l’intera durata dell’evento, considerando già trascorso il tempo passato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定の全体の長さで数えます。すでに過ぎた分は経過済みとして始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일정의 전체 길이로 셉니다. 이미 지난 만큼은 흐른 채로 시작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teller hele lengden på planen, og tiden som allerede har gått, regnes som forløpt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt de hele duur van de activiteit; de tijd die al voorbij is, telt als verstreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy całą długość planu; czas, który już minął, jest wliczony jako upłynięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta a duração inteira do evento; o tempo que já passou entra como decorrido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считается вся длина события; уже прошедшая часть сразу засчитывается как истёкшая."
