    "직접 시작한 타이머가 있을 때만 줄이 섭니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lišta se zobrazí, jen když běží časovač, který jste spustili sami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bjælken vises kun, når en timer, du selv har startet, kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Balken erscheint nur, wenn ein Timer läuft, den du selbst gestartet hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μπάρα εμφανίζεται μόνο όταν τρέχει ένα χρονόμετρο που ξεκίνησες εσύ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bar appears only when a timer you started is running."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bar appears only when a timer you started is running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra solo aparece cuando hay un temporizador que iniciaste tú."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palkki näkyy vain, kun käynnistämäsi ajastin on käynnissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre n’apparaît que si vous avez lancé un minuteur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilah hanya muncul saat ada timer yang Anda mulai sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra compare solo quando è attivo un timer che hai avviato tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で始めたタイマーがあるときだけバーが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 시작한 타이머가 있을 때만 줄이 섭니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjen vises bare når en tidtaker du har startet selv, går."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De balk verschijnt alleen als er een timer loopt die je zelf hebt gestart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasek pojawia się tylko wtedy, gdy działa uruchomiony przez Ciebie timer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra só aparece quando há um timer que você mesmo iniciou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полоса появляется, только когда идёт таймер, запущенный вами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stapeln visas bara när en timer du startat är igång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถบจะแสดงเฉพาะเมื่อมีตัวจับเวลาที่คุณเริ่มเองทำงานอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubuk yalnızca sizin başlattığınız bir zamanlayıcı çalışırken görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanh chỉ hiện khi có bộ hẹn giờ bạn tự bắt đầu đang chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你自己启动计时器时才会显示横条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你自己啟動計時器時才會顯示橫條。"
          }
        }
