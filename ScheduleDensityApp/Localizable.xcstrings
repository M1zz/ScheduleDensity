    "무지개에 그어 둔 줄도 함께 없어집니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmizí i čára, kterou nakreslil na Duze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjen, den tegnede på regnbuen, forsvinder også."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Linie im Regenbogen verschwindet ebenfalls."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φεύγει και η γραμμή που σχεδίασε στο ουράνιο τόξο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The line it drew on the Rainbow goes too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The line it drew on the Rainbow goes too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea que dibujó en el arcoíris también desaparece."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myös sen sateenkaareen piirtämä viiva poistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trait tracé sur l’Arc-en-ciel disparaît aussi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garis yang sudah ditarik di Pelangi juga ikut hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
