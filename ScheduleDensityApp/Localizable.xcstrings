          "stringUnit": {
            "state": "translated",
            "value": "Indigo"
          }
        }
      }
    },
    "남은 몫": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left over"
          }
        }
      }
    },
    "낮음 - 여유로운 날짜에 배치됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low — placed on the roomier days"
          }
        }
      }
    },
    "내 버전": {
      "localizations": {
        "en": {
