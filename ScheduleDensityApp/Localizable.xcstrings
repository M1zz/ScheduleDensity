        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用暖身就能直接開始嗎？"
          }
        }
      }
    },
    "시스템 캘린더 앱에서\n캘린더를 먼저 만들어주세요" : {
      "localizations" : {
