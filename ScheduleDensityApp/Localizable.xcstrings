          }
        }
      }
    },
    "%lld개의 일정을 새로운 날짜로 이동하시겠습니까?\n\n이 작업은 일정의 시작/종료일을 변경합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesunout události (%lld) na nová data?\n\nZmění se jejich datum začátku a konce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du flytte %lld begivenheder til nye datoer?\n\nDet ændrer deres start- og slutdatoer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Termine auf neue Daten verschieben?\n\nDabei ändern sich ihre Start- und Enddaten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να μετακινηθούν %lld συμβάντα σε νέες ημερομηνίες;\n\nΑυτό αλλάζει την ημερομηνία έναρξης και λήξης τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move %lld events to new dates?\n\nThis changes their start and end dates."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move %lld events to new dates?\n\nThis changes their start and end dates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mover %lld eventos a nuevas fechas?\n\nEsto cambia sus fechas de inicio y fin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirretäänkö %lld tapahtumaa uusiin päiviin?\n\nTämä muuttaa niiden alku- ja loppupäivät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer %lld événements vers de nouvelles dates ?\n\nLeurs dates de début et de fin seront modifiées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindahkan %lld jadwal ke tanggal baru?\n\nTanggal mulai dan selesainya akan diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare %lld eventi a nuove date?\n\nVerranno modificate le date di inizio e di fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件の予定を新しい日付に移動しますか？\n\n予定の開始日・終了日が変更されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개의 일정을 새로운 날짜로 이동하시겠습니까?\n\n이 작업은 일정의 시작/종료일을 변경합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du flytte %lld hendelser til nye datoer?\n\nDette endrer start- og sluttdatoene deres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld activiteiten naar nieuwe datums verplaatsen?\n\nHiermee veranderen hun begin- en einddatums."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieść wydarzenia (%lld) na nowe daty?\n\nZmieni to ich daty rozpoczęcia i zakończenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover %lld eventos para novas datas?\n\nIsso altera as datas de início e término."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенести события на новые даты (%lld)?\n\nУ них изменятся даты начала и окончания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta %lld händelser till nya datum?\n\nDet här ändrar deras start- och slutdatum."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้าย %lld กิจกรรมไปยังวันที่ใหม่ไหม\n\nการดำเนินการนี้จะเปลี่ยนวันเริ่มต้นและวันสิ้นสุดของกิจกรรม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld etkinlik yeni tarihlere taşınsın mı?\n\nBu işlem etkinliklerin başlangıç ve bitiş tarihlerini değiştirir."
          }
        },
        "vi" : {
