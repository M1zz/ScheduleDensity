    "할 일 화면에서 닫았던 조언(쪼개기·단계 크기 팁)을 처음부터 다시 봅니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu zobrazí tipy, které jste na obrazovce Úkoly zavřeli – k dělení a velikosti kroků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter de tips tilbage, du har lukket på skærmen Opgaver – om opdeling og trinstørrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holt die Tipps zurück, die du auf dem Aufgaben-Bildschirm geschlossen hast – zum Aufteilen und zur Schrittgröße."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρει τις συμβουλές που έκλεισες στην οθόνη Εργασίες — για τον χωρισμό και το μέγεθος των βημάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brings back the tips you dismissed on the To-Do screen — splitting and step size."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brings back the tips you dismissed on the To-Do screen — splitting and step size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupera los consejos que cerraste en la pantalla Tareas (cómo dividir y el tamaño de los pasos)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo takaisin Tehtävät-näkymässä sulkemasi vinkit pilkkomisesta ja vaiheiden koosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réaffiche les conseils fermés sur l’écran Tâches (découpage et taille des étapes)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan lagi dari awal saran yang Anda tutup di layar Tugas (tips memecah dan ukuran langkah)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripropone i consigli chiusi nella schermata Attività (suddivisione e dimensione delle fasi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やること画面で閉じたアドバイス（分け方・ステップの大きさのヒント）を、最初からもう一度表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할 일 화면에서 닫았던 조언(쪼개기·단계 크기 팁)을 처음부터 다시 봅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
