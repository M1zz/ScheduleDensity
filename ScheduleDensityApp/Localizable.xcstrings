    "길게 눌러 끌면 순서가 바뀝니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržením a přetažením změníte pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold, og træk for at ændre rækkefølgen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedrückt halten und ziehen, um die Reihenfolge zu ändern."
          }
        },
