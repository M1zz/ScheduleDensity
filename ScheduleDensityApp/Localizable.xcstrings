    "체험 중에 해지하면 요금이 나가지 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když předplatné během zkušební doby zrušíte, nic nezaplatíte."
          }
