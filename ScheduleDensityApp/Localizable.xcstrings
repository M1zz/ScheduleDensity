    "끊기면 다시 올라와야 합니다. 방해 없는 시간에 두세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když vás někdo vyruší, musíte se do toho znovu dostávat. Zařaďte to do nerušeného času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliver du afbrudt, skal du kæmpe dig ind i det igen. Giv det uforstyrret tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirst du unterbrochen, musst du dich wieder hineinarbeiten. Plane es in ungestörte Zeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν σε διακόψουν, πρέπει να ξαναμπείς στο κλίμα. Βάλ’ το σε χρόνο χωρίς ενοχλήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it breaks, you have to climb back up. Give it undisturbed time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it breaks, you have to climb back up. Give it undisturbed time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te interrumpen, tienes que volver a subir. Dale un tiempo sin interrupciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos sinut keskeytetään, joudut palaamaan alkuun. Sijoita tämä häiriöttömään aikaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous êtes interrompu, il faut s’y remettre. Placez-le dans un temps sans dérangement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau terganggu, Anda harus memanaskan diri lagi. Taruh di waktu yang tidak terganggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vieni interrotto devi riprendere il filo. Mettila in un momento senza disturbi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断されると、また集中し直す必要があります。邪魔の入らない時間に置きましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끊기면 다시 올라와야 합니다. 방해 없는 시간에 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir du avbrutt, må du jobbe deg inn i det igjen. Gi det uforstyrret tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
