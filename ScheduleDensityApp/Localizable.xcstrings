          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante %lld días; después, se cobra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen %lld päivää, sen jälkeen maksullinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pendant %lld jours, puis facturé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis selama %lld hari, lalu ditagih."
