    "나중에 무지개에서 이 칸을 눌렀을 때 알아볼 수 있게, 한 줄로 적어주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napište jeden řádek, podle kterého to později poznáte, až v duze klepnete na toto políčko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv én linje, du kan genkende senere, når du trykker på dette felt på regnbuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib eine Zeile, an der du das Kästchen später im Regenbogen wiedererkennst."
