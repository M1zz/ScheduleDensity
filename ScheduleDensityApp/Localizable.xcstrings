      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld events"
          }
        }
      }
    },
    "일정 %lld개 삭제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %lld events"
          }
        }
      }
    },
    "일정 검색": {
