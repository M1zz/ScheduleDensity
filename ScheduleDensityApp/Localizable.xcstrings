    "설정에서 iCloud에 로그인하면 다른 사람과 할 일을 공유할 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to iCloud in Settings to share to-dos with someone else."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 iCloud에 로그인하면 다른 사람과 할 일을 공유할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中登录 iCloud，就能与他人共享待办事项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」中登入 iCloud，就能與他人共享待辦事項。"
          }
        }
      }
    },
    "설정에서 언제든 바꿀 수 있습니다." : {
