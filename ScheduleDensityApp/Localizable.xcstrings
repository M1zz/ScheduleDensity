    "특정 날짜를 일정에서 제외합니다. 과거 예외는 30일 후 자동 삭제됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechá z události konkrétní dny. Minulé výjimky se po 30 dnech automaticky smažou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udelader bestemte datoer fra en begivenhed. Tidligere undtagelser fjernes efter 30 dage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt bestimmte Tage von einem Termin aus. Vergangene Ausnahmen werden nach 30 Tagen gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξαιρεί συγκεκριμένες ημερομηνίες από ένα συμβάν. Οι παλαιότερες εξαιρέσεις διαγράφονται μετά από 30 ημέρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves specific dates out of an event. Past exceptions are removed after 30 days."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves specific dates out of an event. Past exceptions are removed after 30 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluye fechas concretas de un evento. Las excepciones pasadas se eliminan a los 30 días."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jättää tietyt päivät pois tapahtumasta. Menneet poikkeukset poistetaan 30 päivän jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclut certaines dates d’un événement. Les exceptions passées sont supprimées après 30 jours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengecualikan tanggal tertentu dari jadwal. Pengecualian yang sudah lewat dihapus otomatis setelah 30 hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esclude date specifiche da un evento. Le eccezioni passate vengono eliminate dopo 30 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特定の日付を予定から除外します。過去の例外は30日後に自動削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "특정 날짜를 일정에서 제외합니다. 과거 예외는 30일 후 자동 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utelater bestemte datoer fra en hendelse. Tidligere unntak fjernes etter 30 dager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit bepaalde datums uit van een activiteit. Eerdere uitzonderingen worden na 30 dagen verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyklucza wybrane daty z wydarzenia. Minione wyjątki są usuwane po 30 dniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui datas específicas de um evento. Exceções passadas são apagadas após 30 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключает отдельные даты из события. Прошлые исключения удаляются через 30 дней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undantar vissa datum från en händelse. Tidigare undantag tas bort efter 30 dagar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกเว้นบางวันออกจากกิจกรรม ข้อยกเว้นที่ผ่านไปแล้วจะถูกลบอัตโนมัติหลัง 30 วัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirli tarihleri etkinliğin dışında bırakır. Geçmiş istisnalar 30 gün sonra silinir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ một số ngày cụ thể khỏi sự kiện. Ngoại lệ đã qua sẽ tự xóa sau 30 ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
