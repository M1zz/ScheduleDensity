        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tyle mały, by domknąć za jednym posiedzeniem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequena o bastante para fechar numa sentada só"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы закрывался за один подход"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så litet att det blir klart i ett pass"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล็กพอจะจบได้ในการนั่งครั้งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek oturuşta kapanacak kadar küçük"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đủ nhỏ để khép lại trong một lần ngồi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次坐下就能收尾的大小"
          }
