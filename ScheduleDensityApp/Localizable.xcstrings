          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee alaspäin suunnitelmaasi kirjatun ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décompte le temps prévu dans votre planning."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghitung mundur waktu yang tertulis di rencana Anda."
