          }
        }
      }
    },
    "일정이 몰려있는 날짜를 감지하고, 자유시간과 중요도를 고려하여 자동으로 일정을 재배치합니다. 중요도가 낮은 일정만 이동됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najde dny, kdy se události hromadí, a přeskládá je s ohledem na volný čas a důležitost. Přesouvají se jen méně důležité události."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder de dage, hvor begivenheder hober sig op, og flytter rundt på tingene med hensyn til fritid og vigtighed. Kun begivenheder med lav vigtighed flyttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Tage, an denen sich Termine ballen, und verteilt sie unter Berücksichtigung von freier Zeit und Wichtigkeit neu. Verschoben werden nur Termine mit niedriger Wichtigkeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρίσκει τις μέρες όπου στοιβάζονται συμβάντα και τα μετακινεί, λαμβάνοντας υπόψη τον ελεύθερο χρόνο και τη σημασία. Μετακινούνται μόνο συμβάντα χαμηλής σημασίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the days where events pile up and moves things around, weighing free time and importance. Only low-importance events are moved."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the days where events pile up and moves things around, weighing free time and importance. Only low-importance events are moved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta los días en que se acumulan los eventos y los reorganiza teniendo en cuenta el tiempo libre y la importancia. Solo se mueven los eventos de importancia baja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsii päivät, joille tapahtumat kasautuvat, ja siirtää niitä vapaa-ajan ja tärkeyden mukaan. Vain vähemmän tärkeitä tapahtumia siirretään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repère les jours où les événements s’accumulent et les redistribue en tenant compte du temps libre et de l’importance. Seuls les événements peu importants sont déplacés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendeteksi tanggal yang jadwalnya menumpuk, lalu memindahkan jadwal secara otomatis dengan memperhitungkan waktu luang dan tingkat kepentingan. Hanya jadwal yang kurang penting yang dipindahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Individua i giorni in cui gli eventi si accumulano e li ridistribuisce tenendo conto di tempo libero e importanza. Vengono spostati solo gli eventi poco importanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定が集中している日を見つけて、自由時間と重要度を考えながら自動で予定を再配置します。移動するのは重要度の低い予定だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일정이 몰려있는 날짜를 감지하고, 자유시간과 중요도를 고려하여 자동으로 일정을 재배치합니다. 중요도가 낮은 일정만 이동됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finner dagene der hendelser hoper seg opp, og flytter på ting med tanke på fritid og viktighet. Bare hendelser med lav viktighet flyttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vindt de dagen waarop activiteiten zich opstapelen en schuift dingen op, rekening houdend met vrije tijd en prioriteit. Alleen activiteiten met lage prioriteit worden verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykrywa dni, w które gromadzą się wydarzenia, i przestawia je, biorąc pod uwagę wolny czas i ważność. Przenoszone są tylko wydarzenia o niskiej ważności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta os dias em que os eventos se acumulam e os reorganiza levando em conta o tempo livre e a importância. Só eventos de importância baixa são movidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находит дни, где события скапливаются, и переставляет их с учётом свободного времени и важности. Переносятся только события с низкой важностью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hittar dagarna där händelserna hopar sig och flyttar om saker med hänsyn till ledig tid och prioritet. Bara händelser med låg prioritet flyttas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค้นหาวันที่กิจกรรมกระจุกตัว แล้วจัดใหม่อัตโนมัติโดยคำนึงถึงเวลาว่างและความสำคัญ จะย้ายเฉพาะกิจกรรมที่สำคัญน้อยเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinliklerin yığıldığı günleri bulur, boş zamanı ve önemi göz önüne alarak etkinlikleri otomatik olarak yeniden yerleştirir. Yalnızca önemi düşük etkinlikler taşınır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm những ngày bị dồn sự kiện và tự động sắp xếp lại, có tính đến thời gian rảnh và mức độ quan trọng. Chỉ dời những sự kiện ít quan trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测日程集中的日期，考虑空闲时间与重要程度，自动重新安排日程。只会移动重要程度低的日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測行程集中的日期，考量空閒時間與重要程度，自動重新安排行程。只會移動重要程度低的行程。"
          }
        }
      }
    },
