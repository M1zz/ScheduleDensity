    "꾸준함, 쪼개기 습관, 완주율, 어디에 시간이 갔나" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consistency, splitting habits, finish rate, where the time went"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꾸준함, 쪼개기 습관, 완주율, 어디에 시간이 갔나"
          }
