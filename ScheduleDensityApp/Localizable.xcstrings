          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下右上角的「加入」，就會在彩虹上畫出一條線。"
          }
        }
      }
    },
    "오른쪽 위 + 를 눌러 이번 주에 할 일을 적어보세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
