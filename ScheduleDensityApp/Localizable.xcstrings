    "아직 공유받은 일정이 없어요.\n상대가 보낸 초대 링크를 누르면 여기에 나타납니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím s vámi nikdo nic nesdílí.\nKdyž klepnete na odkaz s pozvánkou, objeví se to tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet er delt med dig endnu.\nTryk på et invitationslink, som nogen sender dig, så vises det her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch hat niemand etwas mit dir geteilt.\nTippe auf einen Einladungslink, den du bekommst, dann erscheint es hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει μοιραστεί τίποτα μαζί σου ακόμη.\nΠάτα έναν σύνδεσμο πρόσκλησης που σου στέλνουν και θα εμφανιστεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing has been shared with you yet.\nTap an invite link someone sends and it shows up here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing has been shared with you yet.\nTap an invite link someone sends and it shows up here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no han compartido nada contigo.\nToca un enlace de invitación que te envíen y aparecerá aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulle ei ole vielä jaettu mitään.\nNapauta jonkun lähettämää kutsulinkkiä, niin se ilmestyy tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’a encore été partagé avec vous.\nTouchez un lien d’invitation reçu et il apparaîtra ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada jadwal yang dibagikan kepada Anda.\nKetuk tautan undangan dari orang lain, dan jadwalnya muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun evento condiviso con te.\nTocca il link di invito che ti inviano e comparirà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ共有された予定はありません。\n相手から届いた招待リンクをタップすると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 공유받은 일정이 없어요.\n상대가 보낸 초대 링크를 누르면 여기에 나타납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting er delt med deg ennå.\nTrykk på en invitasjonslenke noen sender deg, så vises det her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is nog niets met je gedeeld.\nTik op een uitnodigingslink die je krijgt, dan verschijnt het hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt jeszcze niczego Ci nie udostępnił.\nStuknij link z zaproszeniem od kogoś, a plan pojawi się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não compartilharam nada com você.\nToque num link de convite que alguém enviar e ele aparece aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С вами пока ничем не поделились.\nНажмите на приглашение, которое вам прислали, и оно появится здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget har delats med dig än.\nTryck på en inbjudningslänk som någon skickar så dyker det upp här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีใครแชร์กิจกรรมให้คุณ\nแตะลิงก์คำเชิญที่ได้รับ แล้วจะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz sizinle paylaşılan bir şey yok.\nBiri size davet bağlantısı gönderdiğinde ona dokunun, burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có ai chia sẻ lịch với bạn.\nChạm vào liên kết mời người khác gửi, lịch sẽ hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有人与你共享日程。\n轻点对方传来的邀请链接，就会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有人與你共享行程。\n點一下對方傳來的邀請連結，就會出現在這裡。"
          }
        }
      }
    },
    "아직 내보내기 결과가 없습니다. 잠시 뒤 '동기화 진단'을 다시 보세요." : {
