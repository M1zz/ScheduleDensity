    "연 날짜만 셉니다. 몇 시에 열었는지, 무엇을 하셨는지는 남기지 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítají se jen dny, kdy jste aplikaci otevřeli. Ne hodina, ne to, co jste dělali."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun de datoer, du åbnede den. Ikke klokkeslæt, ikke hvad du gjorde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Tage, an denen du die App geöffnet hast. Weder Uhrzeit noch was du getan hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο οι ημερομηνίες που την άνοιξες. Όχι η ώρα, όχι τι έκανες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the dates you opened it. Not the hour, not what you did."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the dates you opened it. Not the hour, not what you did."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo las fechas en que la abriste. Ni la hora ni lo que hiciste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain päivät, joina avasit apin. Ei kellonaikaa, ei sitä, mitä teit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement les dates d’ouverture. Ni l’heure, ni ce que vous avez fait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya tanggal Anda membuka app yang dihitung. Jam berapa dan apa yang Anda lakukan tidak dicatat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo le date in cui l’hai aperta. Non l’ora, né cosa hai fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いた日付だけを数えます。何時に開いたか、何をしたかは残しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연 날짜만 셉니다. 몇 시에 열었는지, 무엇을 하셨는지는 남기지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare datoene du åpnet den. Ikke klokkeslett, ikke hva du gjorde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de datums waarop je de app opende. Niet het tijdstip, niet wat je deed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczone są tylko daty otwarcia. Bez godziny i bez tego, co robiłeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só as datas em que você abriu o app. Nem a hora, nem o que você fez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считаются только даты, когда вы открывали приложение. Ни время, ни ваши действия не сохраняются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara datumen du öppnade appen. Inte klockslaget, inte vad du gjorde."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับเฉพาะวันที่เปิดแอป ไม่เก็บว่าเปิดกี่โมงหรือทำอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca uygulamayı açtığınız tarihler sayılır. Saati ve ne yaptığınız kaydedilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đếm những ngày bạn mở ứng dụng. Không ghi giờ mở, không ghi bạn đã làm gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只记录打开的日期。不留下几点打开、做了什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只記錄打開的日期。不留下幾點打開、做了什麼。"
          }
        }
      }
