    "※ 끝나는 날이 없던 예전 일정은 30일 기준으로 계산됩니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※ Starší události bez data konce se počítají jako 30denní"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※ Ældre begivenheder uden slutdato regnes som 30 dage"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※ Ältere Termine ohne Enddatum werden mit 30 Tagen berechnet"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※ Παλαιότερα συμβάντα χωρίς ημερομηνία λήξης υπολογίζονται ως 30 ημέρες"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※ Older events with no end date are counted as 30 days"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※ Older events with no end date are counted as 30 days"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※ Los eventos antiguos sin fecha de fin se cuentan como 30 días"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※ Vanhat tapahtumat ilman päättymispäivää lasketaan 30 päiväksi"
          }
        },
        "fr" : {
          "stringUnit" : {
