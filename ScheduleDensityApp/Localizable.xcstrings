          }
        }
      }
    },
    "아직 안 쪼갬": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not split yet"
          }
        }
      }
    },
    "아직 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet"
          }
        }
      }
    },
    "아직 함께 보는 목록이 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shared list yet"
          }
        }
      }
    },
    "아침": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning"
          }
        }
      }
    },
    "아침 (06–12시)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning (6 AM–12 PM)"
          }
        }
      }
    },
    "안 잡음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set"
          }
        }
      }
    },
    "안 정한 것이 먼저 막고 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something undecided is blocking it first."
          }
        }
      }
    },
    "안 정함": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set"
          }
        }
      }
    },
    "안 정해진 게 남아 있으면 아래 단계가 전부 안 열립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If anything is left undecided, none of the steps below will open."
          }
        }
      }
    },
    "안 쪼갠 것": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not split"
          }
        }
      }
    },
    "안내 닫기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close guide"
          }
        }
      }
    },
    "알 수 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "알겠어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        }
      }
    },
    "앞 단계가 끝나야 다음이 옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next one waits until this one is done."
          }
        }
      }
    },
    "앞에서 막고 있는 것이 안 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing seems to be blocking it."
          }
        }
      }
    },
    "앱 판정으로 되돌리기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the app's call"
          }
        }
      }
    },
    "앱의 짐작이 아니라 내가 하는 말": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your call, not the app's guess"
          }
        }
      }
    },
    "약 %lld일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "about %lld days"
          }
        }
      }
    },
    "어디까지 했는지 다시 읽어 와야 시작됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have to reload where you left off before you can start."
          }
        }
      }
    },
    "어디에 시간이 갔나": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the time went"
          }
        }
      }
    },
    "어떤 순서로 쪼개면 되는지 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what order to split in"
          }
        }
      }
    },
    "언제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When"
          }
        }
      }
    },
    "언제든 여기서 끄실 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn this off here at any time."
          }
        }
      }
    },
    "언제부터 언제까지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From when to when"
          }
        }
      }
    },
    "언제부터 언제까지인지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From when to when"
          }
        }
      }
    },
    "언제부터 언제까지인지 정해 두면 그 기간이 무지개에 한 줄로 그어집니다. 오늘 손을 안 대는 날도, 끝나지 않았다면 여전히 나를 붙잡고 있으니까요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the span and it's drawn on the Rainbow as one line — because a day you don't touch it still holds you, as long as it isn't finished."
          }
        }
      }
    },
    "업체 예약 전화": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call to book the movers"
          }
        }
      }
    },
    "없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        }
      }
    },
    "여기 쌓이는 숫자는 진행률에 섞이지 않습니다. 성과 칸이 아니라 회복 칸입니다.\n짧은 휴식은 활력(d=.36)과 피로(d=.35)에는 효과가 확인됐지만 성과에는 유의한 효과가 없습니다(d=.16, p=.116). 성과를 기대하니까 “5분 쉬어야지”가 헛되게 느껴지는 것입니다.\n— Albulescu et al. 2022, PLOS ONE (22개 표본, N=2,335)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers here never mix into your progress. This is a recovery column, not a performance one.\nShort breaks have a confirmed effect on vigor (d=.36) and fatigue (d=.35), but no significant effect on performance (d=.16, p=.116). It's because you expect performance that \"I should take five\" feels wasted.\n— Albulescu et al. 2022, PLOS ONE (22 samples, N=2,335)"
          }
        }
      }
    },
    "여기서 적은 것은 아직 맥에 안 갑니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you write here doesn't reach the Mac yet"
          }
        }
      }
    },
    "여기서 적은 할 일이 맥에서도 보입니다. 적는 것 자체는 무료입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To-dos you write here show up on your Mac. Writing itself is free."
          }
        }
      }
    },
    "여기서만 새 일이 시작됩니다. 미리 정해 둔 블록 대기열의 맨 위를 집으세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New work only starts here. Take the top of the block queue you set up in advance."
          }
        }
      }
    },
    "여유 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plenty of room"
          }
        }
      }
    },
    "여유가 가장 많은 날": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day with the most room"
          }
        }
      }
    },
    "연 날짜만 셉니다. 몇 시에 열었는지, 무엇을 하셨는지는 남기지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the dates you opened it. Not the hour, not what you did."
          }
        }
      }
    },
    "연속으로 여신 날": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days in a row"
          }
        }
      }
    },
    "예": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes"
          }
        }
      }
    },
    "예외 날짜": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded dates"
          }
        }
      }
    },
    "예외 날짜 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an exception"
          }
        }
      }
    },
    "예정된 예외": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming exceptions"
          }
        }
      }
    },
    "오늘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "오늘 ± %lld개월": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today ± %lld months"
          }
        }
      }
    },
    "오늘까지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due today"
          }
        }
      }
    },
    "오늘부터 셉니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counting from today."
          }
        }
      }
    },
    "오늘부터 이 날까지 무지개에 한 줄이 그어집니다.\n실제로 시간을 쓰는 날은 무지개에서 칸을 눌러 고칠 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A line is drawn on the Rainbow from today to this date.\nTap a cell on the Rainbow to change which days actually take time."
          }
        }
      }
    },
    "오늘을 기준으로 과거 %lld개월, 미래 %lld개월의 일정을 표시합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows %lld months back and %lld months ahead from today."
          }
        }
      }
    },
    "오류: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error: %@"
          }
        }
      }
    },
    "오른쪽 위 '추가'를 누르면 무지개에 한 줄이 그어집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add at the top right and a line is drawn on the Rainbow."
          }
        }
      }
    },
    "오른쪽 위 + 를 눌러 이번 주에 할 일을 적어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right and write down this week's work."
          }
        }
      }
    },
    "오른쪽 위 공유 버튼으로 함께할 사람을 초대하거나,\n상대가 보낸 초대 링크를 눌러 참여하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the share button at the top right to invite someone,\nor tap an invite link you were sent to join."
          }
        }
      }
    },
    "오른쪽으로 밀면 번개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
