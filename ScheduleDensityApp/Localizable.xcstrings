    "높은 중요도는 빠른 날짜를, 낮은 중요도는 여유로운 날짜를 추천합니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vysoká důležitost dostane dřívější data, nízká volnější dny"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høj vigtighed får tidlige datoer, lav vigtighed får mere luftige"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hohe Wichtigkeit bekommt frühere Tage, niedrige Wichtigkeit Tage mit mehr Luft"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η υψηλή σημασία παίρνει νωρίτερες ημερομηνίες, η χαμηλή πιο άνετες"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High importance gets earlier dates; low importance gets roomier ones"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High importance gets earlier dates; low importance gets roomier ones"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo más importante va a fechas más próximas; lo menos importante, a días más holgados"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tärkeät saavat aikaisemmat päivät, vähemmän tärkeät väljemmät"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une importance haute obtient des dates proches, une importance basse des jours plus calmes"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kepentingan tinggi disarankan ke tanggal lebih awal; kepentingan rendah ke hari yang lebih longgar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importanza alta suggerisce date vicine, quella bassa date più libere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要度が高いものは早い日付を、低いものは余裕のある日付をおすすめします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높은 중요도는 빠른 날짜를, 낮은 중요도는 여유로운 날짜를 추천합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høy viktighet får tidlige datoer, lav viktighet får dager med mer luft"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoge prioriteit krijgt vroege datums, lage prioriteit rustigere"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysoki priorytet dostaje wcześniejsze daty, niski — luźniejsze"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importância alta ganha datas mais próximas; importância baixa, dias mais folgados"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Важным делам предлагаются ранние даты, менее важным — более свободные"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hög prioritet får tidigare datum, låg prioritet dagar med mer utrymme"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสำคัญสูงจะแนะนำวันที่เร็ว ความสำคัญต่ำจะแนะนำวันที่มีที่ว่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek önem daha erken tarihleri, düşük önem daha rahat tarihleri alır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc quan trọng được gợi ý ngày sớm hơn, việc ít quan trọng được gợi ý ngày thong thả hơn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要度高的会推荐较早的日期，重要度低的则推荐较宽松的日期"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要度高的會推薦較早的日期，重要度低的則推薦較寬鬆的日期"
          }
        }
      }
    },
    "높음 - 가능한 한 빠른 날짜에 배치됩니다" : {
