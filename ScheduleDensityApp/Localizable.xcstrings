        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every event backed up to iCloud has been deleted.\nThe data on this device stays.\n\nSync was turned off automatically."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에 백업된 모든 일정 데이터가 삭제되었습니다.\n로컬 데이터는 유지됩니다.\n\n동기화가 자동으로 해제되었습니다."
          }
        },
