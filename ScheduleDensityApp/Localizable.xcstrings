          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitteret, der bliver mørkere, jo mere begivenheder overlapper. Ingen begrænsninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
