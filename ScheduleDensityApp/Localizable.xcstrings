            "value" : "Gökkuşağına çizdiği çizgi de silinir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường đã vẽ trên Cầu vồng cũng sẽ mất."
          }
