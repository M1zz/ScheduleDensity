        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续度、拆分习惯、完成率、时间都去哪了"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持續度、拆分習慣、完成率、時間都去哪了"
          }
        }
      }
    },
    "꾹 눌러 일정 만드는 법을 처음부터 안내" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walks through drawing an event by press-and-hold"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꾹 눌러 일정 만드는 법을 처음부터 안내"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从头说明如何长按创建日程"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從頭說明如何長按建立行程"
          }
        }
      }
    },
    "끊기면 다시 올라와야 합니다. 방해 없는 시간에 두세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it breaks, you have to climb back up. Give it undisturbed time."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끊기면 다시 올라와야 합니다. 방해 없는 시간에 두세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一中断就得重新爬上来。请放在不受打扰的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一中斷就得重新爬上來。請放在不受打擾的時間。"
          }
        }
      }
    },
    "끊기지 않고 이어지는 중입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still going, unbroken."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끊기지 않고 이어지는 중입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续进行中，没有中断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持續進行中，沒有中斷。"
          }
        }
      }
    },
    "끌어다 놓으면 계획" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag it, and it's planned"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끌어다 놓으면 계획"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖过去，就是计划"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖過去，就是計畫"
          }
        }
      }
    },
    "끝" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束"
          }
        }
      }
    },
    "끝 없는 예전 일정" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Old events with no end"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝 없는 예전 일정"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有结束日的旧日程"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有結束日的舊行程"
          }
        }
      }
    },
    "끝나는 날은 반드시 정합니다. 스터디처럼 화요일에만 모이더라도, 그 스터디가 끝나는 날까지는 계속 매여 있는 시간이니까요.\n무지개에는 매여 있는 기간이 옅게, 실제로 시간을 쓰는 날이 진하게 칠해집니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An end date is always required. Even a study group that only meets on Tuesdays holds you right up to the day it ends.\nOn the Rainbow, the time it holds you is pale and the days you actually spend are dark."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝나는 날은 반드시 정합니다. 스터디처럼 화요일에만 모이더라도, 그 스터디가 끝나는 날까지는 계속 매여 있는 시간이니까요.\n무지개에는 매여 있는 기간이 옅게, 실제로 시간을 쓰는 날이 진하게 칠해집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束日一定要设置。就算像读书会那样只在星期二聚会，直到读书会结束那天，这段时间都一直绑着你。\n在彩虹上，被绑住的期间涂得淡，真正花时间的日子涂得深。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束日一定要設定。就算像讀書會那樣只在星期二聚會，直到讀書會結束那天，這段時間都一直綁著你。\n在彩虹上，被綁住的期間塗得淡，真正花時間的日子塗得深。"
          }
        }
      }
    },
    "끝나는 날을 한 번 더 꾹" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the end day once more"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝나는 날을 한 번 더 꾹"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在结束那天再长按一次"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在結束那天再長按一次"
          }
        }
      }
    },
    "끝나면 알림" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When it ends"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝나면 알림"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束时通知"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束時通知"
          }
        }
      }
    },
    "끝나지 않은 일은 잔여물이 되어 그다음 덩어리 시간까지 갉아먹습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unfinished work leaves residue that eats into the next block of time."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝나지 않은 일은 잔여물이 되어 그다음 덩어리 시간까지 갉아먹습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没做完的事会变成残留，连下一段整块时间也一并侵蚀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒做完的事會變成殘留，連下一段整塊時間也一併侵蝕。"
          }
        }
      }
    },
    "끝내기" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝내기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止"
          }
        }
      }
    },
    "끝내신 비율" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much you finish"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝내신 비율"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成的比例"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成的比例"
          }
        }
      }
    },
    "끝내지 못하고 넘어간 일은 다음 시간까지 따라와 흐립니다. 한 자리에서 닫히는 크기로 잘라 두면, 넘어갈 때 머리에 남는 게 없어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work you leave unfinished follows you into the next hour and blurs it. Cut it to a size that closes in one sitting and nothing stays in your head when you move on."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝내지 못하고 넘어간 일은 다음 시간까지 따라와 흐립니다. 한 자리에서 닫히는 크기로 잘라 두면, 넘어갈 때 머리에 남는 게 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没做完就带过去的事，会跟着你到下一段时间，把它弄得模糊。切成一次坐下就能收尾的大小，换到下一件时脑中就不会留下什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒做完就帶過去的事，會跟著你到下一段時間，把它弄得模糊。切成一次坐下就能收尾的大小，換到下一件時腦中就不會留下什麼。"
          }
        }
      }
    },
    "끝을 닫는 단계. 짬이 나면 바로 집을 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The step that closes the end. Take it whenever a gap opens."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝을 닫는 단계. 짬이 나면 바로 집을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收尾的步骤。一有空档就能马上拿起来做。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收尾的步驟。一有空檔就能馬上拿起來做。"
          }
        }
      }
    },
    "끝이 닫히는 크기로 더 쪼개세요. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split it further, down to a size that closes. A half-done step drags your attention into the next hour."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝이 닫히는 크기로 더 쪼개세요. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再拆细一点，拆到能收尾的大小。做到一半的步骤会把注意力拖到下一段时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再拆細一點，拆到能收尾的大小。做到一半的步驟會把注意力拖到下一段時間。"
          }
        }
      }
    },
    "끝이 정해져 있어 여기서 닫힙니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The end is fixed, so it closes here."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝이 정해져 있어 여기서 닫힙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终点已定，所以在这里收尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終點已定，所以在這裡收尾。"
          }
        }
      }
    },
    "끝이 정해져 있지 않아 안 닫힙니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no fixed end, so it never closes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝이 정해져 있지 않아 안 닫힙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终点未定，所以不会收尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終點未定，所以不會收尾。"
          }
        }
      }
    },
    "나가기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나가기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開"
          }
        }
      }
    },
    "나중에" : {
      "localizations" : {
