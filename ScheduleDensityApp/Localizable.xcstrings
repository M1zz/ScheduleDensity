        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε μια γραμμή που θα αναγνωρίσεις αργότερα, όταν πατήσεις αυτό το κελί στο ουράνιο τόξο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write one line you'll recognize later when you tap this cell on the Rainbow."
          }
        },
