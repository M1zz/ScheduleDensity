    "같은 세로줄에서 끝나는 날을 다시 꾹 누르면 두 날 사이가 네모로 이어지고, 일정을 적는 창이 열려요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve stejném sloupci podržte den konce – oba dny se spojí do jednoho pruhu a otevře se okno pro zápis události."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold på slutdagen i samme kolonne, så bliver de to dage forbundet til én bjælke – og så åbner begivenhedsarket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Endtag in derselben Spalte gedrückt, dann verbinden sich die beiden Tage zu einem Balken – und das Termin-Fenster öffnet sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα παρατεταμένα την ημέρα λήξης στην ίδια στήλη: οι δύο μέρες ενώνονται σε μία μπάρα και ανοίγει η φόρμα του συμβάντος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the end day in the same column, and the two days join into one bar — then the event sheet opens."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the end day in the same column, and the two days join into one bar — then the event sheet opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el día final en la misma columna y los dos días se unen en una barra; luego se abre la hoja del evento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina pitkään päättymispäivää samassa sarakkeessa, niin päivät yhdistyvät yhdeksi palkiksi ja tapahtumaikkuna avautuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le jour de fin dans la même colonne : les deux jours se relient en une barre et la fiche de l’événement s’ouvre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan lama hari selesai di kolom yang sama, dan kedua hari tersambung menjadi satu balok — lalu lembar jadwal terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il giorno di fine nella stessa colonna: i due giorni si uniscono in una barra e si apre la scheda dell’evento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ縦の列で終わる日をもう一度長押しすると、2日のあいだがひとつの帯でつながり、予定を書き込む画面が開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 세로줄에서 끝나는 날을 다시 꾹 누르면 두 날 사이가 네모로 이어지고, 일정을 적는 창이 열려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på sluttdagen i samme kolonne, så blir de to dagene koblet til én stolpe – og så åpnes hendelsesarket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de einddag in dezelfde kolom ingedrukt, dan worden de twee dagen één balk — en opent het activiteitenvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj dzień końca w tej samej kolumnie, a oba dni połączą się w jeden pasek — potem otworzy się okno wydarzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure o dia final na mesma coluna e os dois dias viram uma só barra; depois abre a ficha do evento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте день окончания в том же столбце — дни соединятся полосой и откроется окно события."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck länge på slutdagen i samma kolumn, så binds de två dagarna ihop till en stapel och händelsefönstret öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดค้างที่วันสิ้นสุดในคอลัมน์เดียวกันอีกครั้ง สองวันนั้นจะเชื่อมเป็นแถบเดียว แล้วหน้าบันทึกกิจกรรมจะเปิดขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı sütunda bitiş gününe yeniden basılı tutun; iki gün tek bir çubukla birleşir ve etkinlik sayfası açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ ngày kết thúc trong cùng cột, hai ngày sẽ nối thành một thanh — rồi bảng nhập sự kiện sẽ mở ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一竖列中再按住结束的那天，两天之间就会连成一条，并打开记录日程的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一直欄中再按住結束的那天，兩天之間就會連成一條，並打開記錄行程的視窗。"
          }
        }
      }
    },
