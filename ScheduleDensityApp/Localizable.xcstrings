          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진한 칸과 옅은 칸"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mørke og bleke ruter"
          }
        },
        "nl" : {
          "stringUnit" : {
