    "끝내지 못하고 넘어간 일은 다음 시간까지 따라와 흐립니다. 한 자리에서 닫히는 크기로 잘라 두면, 넘어갈 때 머리에 남는 게 없어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedokončená práce se s vámi táhne do další hodiny a zamlžuje ji. Rozdělte ji na kousky, které se uzavřou na jeden zátah, a při přechodu dál vám v hlavě nic nezůstane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejde, du lader stå ufærdigt, følger dig ind i den næste time og slører den. Skær det til en størrelse, der lukker i ét stræk, så bliver intet hængende i hovedet, når du går videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du unerledigt liegen lässt, verfolgt dich in die nächste Stunde und trübt sie. Schneide es auf eine Größe zu, die sich an einem Stück abschließen lässt, dann bleibt beim Weitermachen nichts im Kopf hängen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δουλειά που αφήνεις ημιτελή σε ακολουθεί στην επόμενη ώρα και τη θολώνει. Κόψ’ τη σε μέγεθος που κλείνει με ένα κάθισμα και δεν θα σου μένει τίποτα στο μυαλό όταν προχωράς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work you leave unfinished follows you into the next hour and blurs it. Cut it to a size that closes in one sitting and nothing stays in your head when you move on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work you leave unfinished follows you into the next hour and blurs it. Cut it to a size that closes in one sitting and nothing stays in your head when you move on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que dejas sin terminar te sigue a la hora siguiente y la enturbia. Córtalo a un tamaño que se cierre de una sentada y no te quedará nada en la cabeza al pasar a otra cosa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesken jätetty työ seuraa sinua seuraavaan tuntiin ja sumentaa sen. Leikkaa se kokoon, joka valmistuu yhdellä istumalla, niin päähän ei jää mitään, kun siirryt eteenpäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un travail laissé inachevé vous suit dans l’heure suivante et la brouille. Coupez-le à une taille qui se boucle d’une traite et rien ne vous reste en tête quand vous passez à autre chose."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan yang ditinggal belum selesai ikut terbawa ke jam berikutnya dan membuatnya kabur. Potong sampai bisa tuntas sekali duduk, dan tidak ada yang tertinggal di kepala saat Anda beralih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro lasciato a metà ti segue nell’ora successiva e la offusca. Taglialo a una dimensione che si chiude in una seduta e, quando passi oltre, non ti resta niente in testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わらせられずに持ち越した仕事は、次の時間までついてきて集中を曇らせます。ひと続きで閉じられる大きさに切っておけば、次へ移るときに頭に何も残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝내지 못하고 넘어간 일은 다음 시간까지 따라와 흐립니다. 한 자리에서 닫히는 크기로 잘라 두면, 넘어갈 때 머리에 남는 게 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeid du lar stå uferdig, følger deg inn i neste time og gjør den uklar. Skjær det til en størrelse som avsluttes i én økt, så blir ingenting hengende i hodet når du går videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk dat je onaf laat, gaat mee naar het volgende uur en vertroebelt het. Knip het op tot iets wat in één zit af kan, dan blijft er niets in je hoofd hangen als je verdergaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedokończona praca idzie za Tobą do następnej godziny i ją rozmywa. Potnij ją na kawałki, które domykają się za jednym posiedzeniem, a przechodząc dalej, nie będziesz mieć nic w głowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que fica inacabado vai junto para a hora seguinte e a embaça. Corte num tamanho que se feche numa sentada só e nada fica na cabeça quando você passar para outra coisa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незаконченное дело тянется за вами в следующий час и мешает сосредоточиться. Нарежьте его на части, которые закрываются за один подход, — и при переходе к другому в голове ничего не останется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbete du lämnar ofärdigt följer med in i nästa timme och grumlar den. Skär det till en storlek som blir klar i ett pass, så ligger inget kvar i huvudet när du går vidare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานที่ทำไม่จบแล้วข้ามไป จะตามไปรบกวนชั่วโมงถัดไป ตัดให้มีขนาดที่จบได้ในรวดเดียว แล้วเวลาย้ายไปทำอย่างอื่นจะไม่มีอะไรค้างในหัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitirilmeden bırakılan iş bir sonraki saate de taşınır ve onu bulandırır. Tek oturuşta kapanacak boyutta keserseniz, geçerken aklınızda bir şey kalmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc bỏ dở sẽ theo bạn sang giờ tiếp theo và làm nó mờ đi. Cắt nó thành cỡ xong được trong một lần ngồi, để khi chuyển việc, đầu óc không còn vướng bận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没做完就带过去的事，会跟着你到下一段时间，把它弄得模糊。切成一次坐下就能收尾的大小，换到下一件时脑中就不会留下什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒做完就帶過去的事，會跟著你到下一段時間，把它弄得模糊。切成一次坐下就能收尾的大小，換到下一件時腦中就不會留下什麼。"
          }
        }
      }
    },
    "끝을 닫는 단계. 짬이 나면 바로 집을 수 있습니다." : {
      "localizations" : {
        "cs" : {
