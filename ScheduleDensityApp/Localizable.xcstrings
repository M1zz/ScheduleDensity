        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemek veya silmek için bir hücreye basılı tutun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ một ô để sửa hoặc xóa ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按格子即可直接打开编辑与删除菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按格子即可直接開啟編輯與刪除選單。"
          }
        }
      }
    },
    "칸을 탭하면 내용을 보고, 꾹 누르면 고치거나 지울 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím políčko zobrazíte, podržením ho upravíte nebo smažete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et felt for at læse det; tryk og hold for at redigere eller slette det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Kästchen, um es zu lesen; halte es gedrückt, um es zu bearbeiten oder zu löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα ένα κελί για να το διαβάσεις· πάτα παρατεταμένα για επεξεργασία ή διαγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a cell to read it; press and hold to edit or delete it."
          }
        },
