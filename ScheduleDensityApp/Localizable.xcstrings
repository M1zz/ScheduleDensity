    "새 일을 시작하기엔 전환 비용에 다 먹힙니다. 다음 일의 계획을 적어 두는 데 쓰세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na začátek něčeho nového je to málo – všechno spolkne přepnutí. Využijte to k sepsání plánu na další úkol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For kort til at starte på noget nyt – skiftet æder det hele. Brug det til at skrive planen for det næste ned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu kurz, um etwas Neues anzufangen – der Wechsel frisst alles. Nutze sie, um den Plan für das Nächste aufzuschreiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πολύ λίγο για να ξεκινήσεις κάτι νέο — η εναλλαγή τα τρώει όλα. Χρησιμοποίησέ το για να γράψεις το πλάνο για το επόμενο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too short to start something new — switching eats it all. Use it to write down the plan for what's next."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too short to start something new — switching eats it all. Use it to write down the plan for what's next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado corto para empezar algo nuevo: el cambio de tarea se lo come todo. Úsalo para apuntar el plan de lo siguiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian lyhyt uuden aloittamiseen – vaihtaminen syö kaiken. Käytä se seuraavan asian suunnitelman kirjaamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop court pour commencer autre chose : le changement de tâche avale tout. Profitez-en pour noter le plan de la suite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu singkat untuk memulai hal baru — habis untuk berpindah fokus. Pakai untuk mencatat rencana pekerjaan berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppo poco per iniziare qualcosa di nuovo: il cambio di contesto se lo mangia tutto. Usalo per annotare il piano della prossima cosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいことを始めるには、切り替えのコストで全部消えてしまいます。次にやることの計画を書いておくのに使いましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 일을 시작하기엔 전환 비용에 다 먹힙니다. 다음 일의 계획을 적어 두는 데 쓰세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For kort til å starte på noe nytt – byttet spiser alt. Bruk det til å skrive ned planen for det som kommer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te kort om iets nieuws te beginnen — het schakelen kost alles. Schrijf er het plan voor je volgende klus mee op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za krótko, by zacząć coś nowego — wszystko zje przełączanie. Zapisz w tym czasie plan na następną rzecz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curto demais para começar algo novo — a troca de contexto come tudo. Use para anotar o plano do que vem a seguir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком мало, чтобы начать что-то новое, — всё уйдёт на переключение. Лучше запишите план следующего дела."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För kort för att börja på något nytt – bytet äter upp allt. Använd tiden till att skriva ned planen för det som kommer härnäst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สั้นเกินกว่าจะเริ่มงานใหม่ การสลับงานจะกินเวลาไปหมด ใช้เวลานี้จดแผนของงานถัดไปดีกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir işe başlamak için çok kısa; geçiş maliyeti hepsini yer. Sıradaki işin planını yazmak için kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá ngắn để bắt đầu việc mới — chi phí chuyển việc sẽ ngốn hết. Hãy dùng nó để ghi lại kế hoạch cho việc tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太短了，开始新的事会被切换成本吃光。用来写下下一件事的计划吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太短了，開始新的事會被切換成本吃光。用來寫下下一件事的計畫吧。"
          }
        }
      }
    },
    "새 타이머는 다이나믹 아일랜드와 잠금화면에 남은 시간이 보입니다. 이번 타이머만 감추려면 타이머 화면에서 끄십시오." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové časovače ukazují zbývající čas v Dynamic Islandu a na zamčené obrazovce. Chcete-li skrýt jen tento časovač, vypněte to na obrazovce časovače."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye timere viser den resterende tid i Dynamic Island og på låseskærmen. For kun at skjule den aktuelle timer skal du slå den fra på timerskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Timer zeigen die Restzeit in der Dynamic Island und auf dem Sperrbildschirm. Um nur den aktuellen Timer auszublenden, schalte ihn im Timer-Bildschirm aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα νέα χρονόμετρα δείχνουν τον υπόλοιπο χρόνο στο Dynamic Island και στην οθόνη κλειδώματος. Για να κρύψεις μόνο το τρέχον, απενεργοποίησέ το στην οθόνη του χρονομέτρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New timers show the remaining time in the Dynamic Island and on the Lock Screen. To hide just the current timer, turn it off on the timer screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New timers show the remaining time in the Dynamic Island and on the Lock Screen. To hide just the current timer, turn it off on the timer screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nuevos temporizadores muestran el tiempo restante en la Dynamic Island y en la pantalla bloqueada. Para ocultar solo el actual, desactívalo en la pantalla del temporizador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet ajastimet näyttävät jäljellä olevan ajan Dynamic Islandissa ja lukitusnäytöllä. Jos haluat piilottaa vain nykyisen ajastimen, laita se pois päältä ajastinnäkymässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux minuteurs affichent le temps restant dans la Dynamic Island et sur l’écran verrouillé. Pour masquer seulement le minuteur en cours, désactivez-le sur l’écran du minuteur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer baru menampilkan sisa waktu di Dynamic Island dan Layar Terkunci. Untuk menyembunyikan timer yang sedang berjalan saja, matikan di layar timer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi timer mostrano il tempo rimanente nella Dynamic Island e sulla schermata di blocco. Per nascondere solo il timer attuale, disattivalo nella schermata del timer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいタイマーは、Dynamic Islandとロック画面に残り時間が表示されます。今回のタイマーだけ隠すには、タイマー画面でオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 타이머는 다이나믹 아일랜드와 잠금화면에 남은 시간이 보입니다. 이번 타이머만 감추려면 타이머 화면에서 끄십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye tidtakere viser gjenværende tid i Dynamic Island og på låseskjermen. For å skjule bare den gjeldende tidtakeren slår du den av på tidtakerskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe timers tonen de resterende tijd in Dynamic Island en op het toegangsscherm. Wil je alleen deze timer verbergen, zet het dan uit in het timerscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe timery pokazują pozostały czas w Dynamic Island i na ekranie blokady. Aby ukryć tylko bieżący timer, wyłącz go na ekranie timera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos timers mostram o tempo restante na Ilha Dinâmica e na Tela Bloqueada. Para ocultar só o timer atual, desative-o na tela do timer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые таймеры показывают оставшееся время в Dynamic Island и на экране блокировки. Чтобы скрыть только текущий таймер, выключите его на экране таймера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya timers visar återstående tid i Dynamic Island och på låsskärmen. Om du bara vill dölja den aktuella timern stänger du av det på timerskärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวจับเวลาใหม่จะแสดงเวลาที่เหลือใน Dynamic Island และบนหน้าจอล็อก หากต้องการซ่อนเฉพาะตัวจับเวลานี้ ให้ปิดในหน้าตัวจับเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni zamanlayıcılar kalan süreyi Dynamic Island’da ve Kilitli Ekran’da gösterir. Yalnızca bu zamanlayıcıyı gizlemek için zamanlayıcı ekranından kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ hẹn giờ mới sẽ hiện thời gian còn lại trên Dynamic Island và Màn hình khóa. Để ẩn riêng bộ hẹn giờ hiện tại, hãy tắt trên màn hình hẹn giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的计时器会在动态岛和锁定屏幕显示剩余时间。若只想隐藏这一个计时器，请在计时器页面关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的計時器會在動態島和鎖定畫面顯示剩餘時間。若只想隱藏這一個計時器，請在計時器畫面關閉。"
          }
        }
      }
    },
    "새 타이머는 다이나믹 아일랜드와 잠금화면에 띄우지 않습니다. 이번 타이머만 보이려면 타이머 화면에서 켜십시오." : {
