        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con poco tempo previsto, qui non si chiuderà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短めに見積もっても、ここでは終わりません。"
