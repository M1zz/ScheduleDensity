            "state" : "translated",
            "value" : "Seçtiğiniz takvimlerdeki etkinlikler gökkuşağınızda hep görünür. Takvim’de taşırsanız veya silerseniz gökkuşağı da buna uyar."
          }
        },
        "vi" : {
          "stringUnit" : {
