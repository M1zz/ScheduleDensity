    "빈 자리가 이만큼 남지 않아 아무 데도 못 놓았습니다. 다른 날로 미루거나 시간을 줄여야 해요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný den nemá tolik volného místa, takže se to nedalo nikam umístit. Přesuňte to na jiný den, nebo zkraťte čas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen dag har så meget plads tilbage, så den kunne ikke placeres nogen steder. Flyt den til en anden dag, eller skær ned på timerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Tag hat noch so viel Platz, deshalb ließ es sich nirgends einplanen. Verschiebe es auf einen anderen Tag oder kürze die Stunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία μέρα δεν έχει τόσο περιθώριο, οπότε δεν μπήκε πουθενά. Μετάφερέ το σε άλλη μέρα ή μείωσε τις ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No day has this much room left, so it couldn't be placed anywhere. Move it to another day or cut the hours."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No day has this much room left, so it couldn't be placed anywhere. Move it to another day or cut the hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún día tiene tanto margen libre, así que no se pudo colocar en ningún sitio. Pásalo a otro día o recorta las horas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Millään päivällä ei ole näin paljon tilaa jäljellä, joten sitä ei voitu sijoittaa mihinkään. Siirrä se toiseen päivään tai vähennä tunteja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun jour n’a autant de place libre : impossible de le placer. Reportez-le à un autre jour ou réduisez la durée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada hari yang masih punya ruang sebanyak ini, jadi tidak bisa ditaruh di mana pun. Pindahkan ke hari lain atau kurangi waktunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun giorno ha ancora tutto questo spazio, quindi non è stato possibile collocarlo. Spostalo a un altro giorno o riduci le ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これだけの空きが残っている日がないため、どこにも置けませんでした。別の日に回すか、時間を減らしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 자리가 이만큼 남지 않아 아무 데도 못 놓았습니다. 다른 날로 미루거나 시간을 줄여야 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen dag har så mye plass igjen, så den kunne ikke plasseres noe sted. Flytt den til en annen dag eller kutt ned på timene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen enkele dag heeft nog zoveel ruimte, dus het kon nergens worden gezet. Schuif het naar een andere dag of neem minder uren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden dzień nie ma tyle wolnego miejsca, więc nie dało się tego nigdzie umieścić. Przenieś to na inny dzień albo skróć czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum dia tem tanto espaço sobrando, então não deu para encaixar em lugar nenhum. Passe para outro dia ou reduza as horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни в одном дне не осталось столько места, поэтому дело никуда не поставлено. Перенесите его на другой день или сократите время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen dag har så mycket utrymme kvar, så den kunde inte placeras någonstans. Flytta den till en annan dag eller minska timmarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีวันไหนเหลือที่ว่างพอ จึงวางไม่ได้ ย้ายไปวันอื่นหรือลดเวลาลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir günde bu kadar yer kalmadığı için hiçbir yere yerleştirilemedi. Başka bir güne erteleyin ya da süreyi kısaltın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ngày nào còn đủ chỗ trống như vậy nên không xếp được vào đâu. Hãy dời sang ngày khác hoặc bớt số giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有哪一天还剩这么多空位，所以放不进去。请改到其他天，或减少小时数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有哪一天還剩這麼多空位，所以放不進去。請改到其他天，或減少時數。"
          }
        }
      }
    },
