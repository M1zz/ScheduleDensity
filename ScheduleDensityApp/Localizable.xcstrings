        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選的每一天要投入的時數。這個數字決定那天會排得多滿。"
          }
        }
      }
    },
    "고른 캘린더를 무지개에 늘 비추기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
