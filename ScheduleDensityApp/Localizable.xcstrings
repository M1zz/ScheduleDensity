    "한 번 사면 끝입니다. 구독이 아니고, 같은 Apple 계정의 다른 기기에서도 열립니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koupíte jednou a máte hotovo. Nejde o předplatné a odemkne se i na dalších zařízeních se stejným Apple účtem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Køb den én gang, så er du færdig. Det er ikke et abonnement, og den låses op på dine andre enheder med samme Apple-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal kaufen, fertig. Kein Abo – und auf deinen anderen Geräten mit demselben Apple Account ebenfalls freigeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αγοράζεις μία φορά και τελείωσε. Δεν είναι συνδρομή και ξεκλειδώνει και στις άλλες συσκευές σου με τον ίδιο Λογαριασμό Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy it once and you're done. It isn't a subscription, and it opens on your other devices with the same Apple Account."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy it once and you're done. It isn't a subscription, and it opens on your other devices with the same Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo compras una vez y listo. No es una suscripción, y se desbloquea en tus otros dispositivos con la misma cuenta de Apple."
