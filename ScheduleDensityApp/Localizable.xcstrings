        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα συμβάντων μένουν σε αυτή τη συσκευή\nκαι δεν αποστέλλονται πουθενά"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event data stays on this device\nand is never sent anywhere"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event data stays on this device\nand is never sent anywhere"
          }
