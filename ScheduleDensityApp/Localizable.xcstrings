    "맨 위 카드를 눌러 이 일이 언제부터 언제까지인지 정해 주세요.\n정하면 그 기간이 무지개에 한 줄로 그어집니다 — 끝나는 날까지 계속 나를 붙잡고 있는 시간이니까요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na kartu nahoře a nastavte, od kdy do kdy tato práce trvá.\nJakmile to nastavíte, období se v duze zakreslí jako jeden pruh – protože vás drží až do posledního dne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på kortet øverst, og angiv, hvornår opgaven løber fra og til.\nNår det er angivet, tegnes perioden som én linje på regnbuen – for den binder dig helt frem til sidste dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe oben auf die Karte und leg fest, von wann bis wann diese Aufgabe läuft.\nDann wird der Zeitraum als Linie im Regenbogen gezogen – denn sie bindet dich bis zu ihrem letzten Tag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα την κάρτα στην κορυφή και όρισε από πότε έως πότε τρέχει αυτή η δουλειά.\nΜόλις το ορίσεις, η διάρκεια σχεδιάζεται στο ουράνιο τόξο ως μία γραμμή — γιατί σε δεσμεύει ως την τελευταία της μέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the card at the top and set when this job runs from and to.\nOnce it's set, that span is drawn on the Rainbow as one line — because it holds you right up to its last day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the card at the top and set when this job runs from and to.\nOnce it's set, that span is drawn on the Rainbow as one line — because it holds you right up to its last day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la tarjeta de arriba y define desde cuándo hasta cuándo va esta tarea.\nUna vez definido, ese periodo se dibuja en el arcoíris como una línea, porque te tiene atado hasta su último día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta ylintä korttia ja aseta, mistä mihin tämä työ kestää.\nKun se on asetettu, ajanjakso piirretään sateenkaareen yhtenä viivana – se sitoo sinua viimeiseen päivään asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la carte du haut et indiquez quand ce travail commence et finit.\nLa période est alors tracée d’un trait sur l’Arc-en-ciel, car elle vous mobilise jusqu’à son dernier jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk kartu paling atas dan tentukan kapan pekerjaan ini dimulai dan berakhir.\nSetelah ditentukan, rentang itu digambar sebagai satu garis di Pelangi — karena pekerjaan ini mengikat Anda sampai hari terakhirnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca la scheda in alto e imposta da quando a quando dura questo lavoro.\nUna volta impostato, il periodo viene tracciato sull’Arcobaleno come una riga, perché ti impegna fino all’ultimo giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん上のカードをタップして、この仕事がいつからいつまでかを決めてください。\n決めると、その期間が虹に1本の線で引かれます。終わる日までずっと自分をとらえている時間だからです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 위 카드를 눌러 이 일이 언제부터 언제까지인지 정해 주세요.\n정하면 그 기간이 무지개에 한 줄로 그어집니다 — 끝나는 날까지 계속 나를 붙잡고 있는 시간이니까요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på kortet øverst og angi når oppgaven går fra og til.\nNår det er angitt, tegnes perioden som én linje på regnbuen – for den binder deg helt frem til siste dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de kaart bovenaan en stel in van wanneer tot wanneer deze klus loopt.\nDaarna wordt die periode als één lijn op de regenboog getekend — want hij houdt je bezig tot de laatste dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij kartę na górze i ustal, od kiedy do kiedy trwa ta praca.\nPo ustaleniu ten okres zostanie narysowany na tęczy jedną linią — bo wiąże Cię aż do ostatniego dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no cartão lá em cima e defina de quando até quando vai esta tarefa.\nDepois disso, o período é desenhado no arco-íris como uma linha — porque ele prende você até o último dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на карточку вверху и укажите, с какого по какое число идёт это дело.\nПериод появится на радуге одной полосой — ведь дело держит вас до самого последнего дня."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på kortet högst upp och ange när jobbet pågår, från och till.\nNär det är angivet ritas perioden som en linje i regnbågen – för den binder dig ända till sista dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะการ์ดด้านบนสุด แล้วกำหนดว่างานนี้เริ่มและจบเมื่อไร\nเมื่อกำหนดแล้ว ช่วงเวลานั้นจะถูกขีดเป็นเส้นเดียวบนสายรุ้ง เพราะมันผูกคุณไว้จนถึงวันสุดท้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En üstteki karta dokunup bu işin ne zamandan ne zamana süreceğini belirleyin.\nBelirlediğinizde o dönem gökkuşağına tek bir çizgi olarak çizilir; çünkü iş, son gününe kadar sizi bağlı tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào thẻ trên cùng và đặt thời gian bắt đầu, kết thúc của việc này.\nKhi đặt xong, khoảng đó được vẽ thành một đường trên Cầu vồng — vì nó giữ chân bạn đến tận ngày cuối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点最上方的卡片，设置这件事从何时开始、到何时结束。\n设置后，这段期间会在彩虹上画成一条线，因为直到最后一天，它都一直绑着你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下最上方的卡片，設定這件事從何時開始、到何時結束。\n設定後，這段期間會在彩虹上畫成一條線，因為直到最後一天，它都一直綁著你。"
          }
        }
      }
    },
    "맨 위에는 지금 할 단계 하나만 섭니다. 그게 지금 손대야 하는 일이에요.\n나머지는 아래 목록에서 순서대로 기다립니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahoře stojí jen jeden krok – ten, do kterého se máte pustit teď.\nOstatní čekají v seznamu níže, až na ně přijde řada."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun ét trin står øverst – det, du skal tage fat på lige nu.\nResten venter på tur i listen nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oben steht immer nur ein Schritt – der, den du jetzt anpacken solltest.\nDie übrigen warten in der Liste darunter, bis sie dran sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην κορυφή στέκεται μόνο ένα βήμα: αυτό που πρέπει να πιάσεις τώρα.\nΤα υπόλοιπα περιμένουν τη σειρά τους στη λίστα από κάτω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only one step stands at the top — the one to touch right now.\nThe rest wait their turn in the list below."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only one step stands at the top — the one to touch right now.\nThe rest wait their turn in the list below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba solo hay un paso: el que toca hacer ahora.\nLos demás esperan su turno en la lista de abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylimpänä on vain yksi vaihe – se, johon tartut juuri nyt.\nMuut odottavat vuoroaan alla olevassa listassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule étape se place en haut : celle à faire maintenant.\nLes autres attendent leur tour dans la liste en dessous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di paling atas hanya ada satu langkah — yang perlu dikerjakan sekarang.\nSisanya menunggu giliran di daftar bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In alto c’è una sola fase: quella da affrontare adesso.\nLe altre aspettano il loro turno nell’elenco qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん上には、今やるステップがひとつだけ表示されます。それが今手をつけるべきことです。\n残りは下のリストで順番を待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 위에는 지금 할 단계 하나만 섭니다. 그게 지금 손대야 하는 일이에요.\n나머지는 아래 목록에서 순서대로 기다립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare ett trinn står øverst – det du skal ta tak i akkurat nå.\nResten venter på tur i listen nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bovenaan staat maar één stap: die waar je nu aan moet.\nDe rest wacht hieronder op zijn beurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na górze stoi tylko jeden krok — ten, którym trzeba zająć się teraz.\nReszta czeka na swoją kolej na liście poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lá em cima fica só uma etapa: a que é para fazer agora.\nAs outras esperam a vez na lista abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наверху стоит только один шаг — тот, за который пора браться сейчас.\nОстальные ждут своей очереди в списке ниже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara ett steg står högst upp – det du ska ta i just nu.\nResten väntar på sin tur i listan nedanför."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ด้านบนสุดจะมีเพียงขั้นตอนเดียวที่ต้องทำตอนนี้ นั่นคืองานที่ควรลงมือเลย\nที่เหลือรอคิวอยู่ในรายการด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En üstte yalnızca tek bir adım durur: şu an el atmanız gereken adım.\nGerisi aşağıdaki listede sırasını bekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên cùng chỉ có một bước — bước cần làm ngay bây giờ.\nCác bước còn lại chờ đến lượt trong danh sách bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最上方只站着一个现在要做的步骤，那就是现在该动手的事。\n其余的在下方清单中按顺序等待。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最上方只站著一個現在要做的步驟，那就是現在該動手的事。\n其餘的在下方清單中依序等待。"
          }
        }
      }
    },
    "멈춤" : {
      "extractionState" : "stale",
      "localizations" : {
