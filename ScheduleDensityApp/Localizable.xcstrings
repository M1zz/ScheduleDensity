        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 무지개에서 이 칸을 눌렀을 때 알아볼 수 있게, 한 줄로 적어주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
