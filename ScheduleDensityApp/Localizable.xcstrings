            "value" : "从头再次显示在待办事项页面关掉的提示（拆分与步骤大小的建议）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從頭再次顯示在待辦事項畫面關掉的提示（拆分與步驟大小的建議）。"
          }
        }
      }
    },
    "할 일과 단계 쪼개기" : {
