            "state" : "translated",
            "value" : "Na tym samym Apple Account widać je na obu urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mesma Conta Apple, aparece nos dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С одним Apple Account видно на обоих устройствах."
          }
        },
