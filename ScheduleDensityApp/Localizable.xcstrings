    "하루 12시간 이상 일정이 배정되어 있습니다. 일정 조정을 권장합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé dny mají naplánováno přes 12 hodin. Zvažte, zda něco nepřesunout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle dage har mere end 12 timer. Overvej at flytte noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An manchen Tagen sind mehr als 12 Stunden verplant. Verschieb besser etwas."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάποιες μέρες έχουν πάνω από 12 ώρες. Σκέψου να μετακινήσεις κάτι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some days carry more than 12 hours. Consider moving something."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some days carry more than 12 hours. Consider moving something."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay días con más de 12 horas asignadas. Conviene mover algo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joillekin päiville on varattu yli 12 tuntia. Harkitse jonkin siirtämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains jours dépassent 12 heures. Pensez à déplacer quelque chose."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada hari dengan jadwal lebih dari 12 jam. Sebaiknya pindahkan sebagian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni giorni superano le 12 ore di impegni. Valuta di spostare qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日に12時間以上の予定が入っている日があります。予定の調整をおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 12시간 이상 일정이 배정되어 있습니다. 일정 조정을 권장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen dager har mer enn 12 timer. Vurder å flytte noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op sommige dagen staat meer dan 12 uur gepland. Overweeg iets te verschuiven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W niektóre dni zaplanowano ponad 12 godzin. Warto coś przenieść."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há dias com mais de 12 horas agendadas. Vale mudar alguma coisa de lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На некоторые дни приходится больше 12 часов. Стоит что-то перенести."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
