        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld일 무료로 써 보고, 그 뒤에 결제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis i %lld dager, deretter betaling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dagen gratis, daarna betaal je."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za darmo przez %lld dni, potem płatnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grátis por %lld dias, depois é cobrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно %lld дн., затем — оплата."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis i %lld dagar, sedan debiteras du."
