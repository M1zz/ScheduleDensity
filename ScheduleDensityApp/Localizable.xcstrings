    "구매를 확인하지 못했습니다. 잠시 뒤 다시 시도해 주세요." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákup se nepodařilo ověřit. Zkuste to prosím za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Købet kunne ikke bekræftes. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kauf konnte nicht bestätigt werden. Bitte versuch es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επιβεβαίωση της αγοράς. Δοκίμασε ξανά σε λίγο."
          }
        },
