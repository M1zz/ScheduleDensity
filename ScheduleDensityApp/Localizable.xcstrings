            "value" : "虹に引いた線も一緒に消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무지개에 그어 둔 줄도 함께 없어집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
