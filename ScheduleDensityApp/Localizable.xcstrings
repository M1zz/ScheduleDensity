    "iCloud에 백업된 모든 일정 데이터가 삭제되었습니다.\n로컬 데이터는 유지됩니다.\n\n동기화가 자동으로 해제되었습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny události zálohované na iCloudu byly smazány.\nData v tomto zařízení zůstávají.\n\nSynchronizace se automaticky vypnula."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle begivenheder, der var sikkerhedskopieret til iCloud, er slettet.\nDataene på denne enhed bliver.\n\nSynkronisering blev slået fra automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle in iCloud gesicherten Termine wurden gelöscht.\nDie Daten auf diesem Gerät bleiben erhalten.\n\nDie Synchronisierung wurde automatisch ausgeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφηκαν όλα τα συμβάντα από το αντίγραφο ασφαλείας iCloud.\nΤα δεδομένα στη συσκευή παραμένουν.\n\nΟ συγχρονισμός απενεργοποιήθηκε αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every event backed up to iCloud has been deleted.\nThe data on this device stays.\n\nSync was turned off automatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every event backed up to iCloud has been deleted.\nThe data on this device stays.\n\nSync was turned off automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron todos los eventos copiados en iCloud.\nLos datos de este dispositivo se conservan.\n\nLa sincronización se desactivó automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki iCloudiin varmuuskopioidut tapahtumat on poistettu.\nTämän laitteen tiedot säilyvät.\n\nSynkronointi kytkettiin automaattisesti pois."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les événements sauvegardés sur iCloud ont été supprimés.\nLes données de cet appareil sont conservées.\n\nLa synchronisation a été désactivée automatiquement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua jadwal yang dicadangkan di iCloud telah dihapus.\nData di perangkat ini tetap ada.\n\nSinkronisasi otomatis dimatikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli eventi salvati su iCloud sono stati eliminati.\nI dati su questo dispositivo restano.\n\nLa sincronizzazione è stata disattivata automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudにバックアップしたすべての予定データを削除しました。\nこのデバイスのデータはそのまま残ります。\n\n同期は自動的にオフになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에 백업된 모든 일정 데이터가 삭제되었습니다.\n로컬 데이터는 유지됩니다.\n\n동기화가 자동으로 해제되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle hendelser som var sikkerhetskopiert til iCloud, er slettet.\nDataene på denne enheten blir værende.\n\nSynkronisering ble slått av automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle activiteiten in de iCloud-reservekopie zijn verwijderd.\nDe gegevens op dit apparaat blijven bewaard.\n\nSynchronisatie is automatisch uitgezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie wydarzenia z kopii w iCloud zostały usunięte.\nDane na tym urządzeniu zostają.\n\nSynchronizacja została automatycznie wyłączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os eventos com backup no iCloud foram apagados.\nOs dados deste dispositivo continuam aqui.\n\nA sincronização foi desativada automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все события, сохранённые в iCloud, удалены.\nДанные на этом устройстве сохранены.\n\nСинхронизация выключена автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla händelser som säkerhetskopierats till iCloud har raderats.\nDatan på den här enheten finns kvar.\n\nSynkroniseringen stängdes av automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบข้อมูลกิจกรรมทั้งหมดที่สำรองไว้ใน iCloud แล้ว\nข้อมูลในอุปกรณ์นี้ยังอยู่ครบ\n\nปิดการซิงค์ให้อัตโนมัติแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud’a yedeklenen tüm etkinlikler silindi.\nBu aygıttaki veriler kalır.\n\nEşzamanlama otomatik olarak kapatıldı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi sự kiện đã sao lưu lên iCloud đã bị xóa.\nDữ liệu trên thiết bị này vẫn được giữ.\n\nĐồng bộ đã tự động tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除所有备份在 iCloud 的日程数据。\n此设备上的数据会保留。\n\n已自动关闭同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已刪除所有備份在 iCloud 的行程資料。\n此裝置上的資料會保留。\n\n已自動關閉同步。"
          }
        }
      }
    },
    "iCloud에 백업된 모든 일정 데이터를 삭제하시겠습니까?\n\n로컬 데이터는 유지되며, iCloud 백업만 삭제됩니다.\n이 작업은 되돌릴 수 없습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat všechny události zálohované na iCloudu?\n\nData v tomto zařízení zůstanou, smaže se jen záloha na iCloudu.\nTuto akci nelze vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du slette alle begivenheder, der er sikkerhedskopieret til iCloud?\n\nDataene på denne enhed bliver; kun iCloud-sikkerhedskopien forsvinder.\nDet kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle in iCloud gesicherten Termine löschen?\n\nDie Daten auf diesem Gerät bleiben erhalten; nur die iCloud-Sicherung wird gelöscht.\nDas kann nicht widerrufen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να διαγραφούν όλα τα συμβάντα από το αντίγραφο ασφαλείας iCloud;\n\nΤα δεδομένα στη συσκευή παραμένουν· διαγράφεται μόνο το αντίγραφο στο iCloud.\nΑυτό δεν αναιρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete every event backed up to iCloud?\n\nThe data on this device stays; only the iCloud backup goes.\nThis can't be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete every event backed up to iCloud?\n\nThe data on this device stays; only the iCloud backup goes.\nThis can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar todos los eventos copiados en iCloud?\n\nLos datos de este dispositivo se conservan; solo se borra la copia en iCloud.\nEsta acción no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko kaikki iCloudiin varmuuskopioidut tapahtumat?\n\nTämän laitteen tiedot säilyvät, vain iCloud-varmuuskopio poistetaan.\nTätä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer tous les événements sauvegardés sur iCloud ?\n\nLes données de cet appareil sont conservées ; seule la sauvegarde iCloud disparaît.\nCette action est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus semua jadwal yang dicadangkan di iCloud?\n\nData di perangkat ini tetap ada; hanya cadangan iCloud yang dihapus.\nTindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare tutti gli eventi salvati su iCloud?\n\nI dati su questo dispositivo restano: viene eliminato solo il backup iCloud.\nL’operazione non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudにバックアップしたすべての予定データを削除しますか？\n\nこのデバイスのデータは残り、iCloudのバックアップだけが削除されます。\nこの操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에 백업된 모든 일정 데이터를 삭제하시겠습니까?\n\n로컬 데이터는 유지되며, iCloud 백업만 삭제됩니다.\n이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du slette alle hendelser som er sikkerhetskopiert til iCloud?\n\nDataene på denne enheten blir værende; bare iCloud-sikkerhetskopien forsvinner.\nDette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle activiteiten in de iCloud-reservekopie verwijderen?\n\nDe gegevens op dit apparaat blijven; alleen de iCloud-reservekopie verdwijnt.\nDit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć wszystkie wydarzenia z kopii w iCloud?\n\nDane na tym urządzeniu zostaną; usunięta zostanie tylko kopia w iCloud.\nTej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar todos os eventos com backup no iCloud?\n\nOs dados deste dispositivo continuam; só o backup do iCloud é apagado.\nNão é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить все события, сохранённые в iCloud?\n\nДанные на этом устройстве останутся, удалится только копия в iCloud.\nЭто действие нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera alla händelser som säkerhetskopierats till iCloud?\n\nDatan på den här enheten finns kvar, bara iCloud-säkerhetskopian försvinner.\nDet här går inte att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบข้อมูลกิจกรรมทั้งหมดที่สำรองไว้ใน iCloud ไหม\n\nข้อมูลในอุปกรณ์นี้ยังอยู่ จะลบเฉพาะข้อมูลสำรองใน iCloud\nการดำเนินการนี้เลิกทำไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud’a yedeklenen tüm etkinlikler silinsin mi?\n\nBu aygıttaki veriler kalır; yalnızca iCloud yedeklemesi silinir.\nBu işlem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mọi sự kiện đã sao lưu lên iCloud?\n\nDữ liệu trên thiết bị này vẫn được giữ, chỉ bản sao lưu iCloud bị xóa.\nKhông thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要删除所有备份在 iCloud 的日程数据吗？\n\n此设备上的数据会保留，只会删除 iCloud 备份。\n此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要刪除所有備份在 iCloud 的行程資料嗎？\n\n此裝置上的資料會保留，只會刪除 iCloud 備份。\n此動作無法復原。"
          }
        }
      }
    },
