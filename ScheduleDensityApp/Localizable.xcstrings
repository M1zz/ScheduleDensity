    "5주 단위로 반복되는 패턴을 설정하세요. 격주 스터디처럼 홀수/짝수 주가 다른 일도 적을 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte vzorec, který se opakuje po pěti týdnech. Liché a sudé týdny se můžou lišit – třeba u studijní skupiny jednou za dva týdny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil et mønster, der gentages hver femte uge. Ulige og lige uger kan være forskellige – fx en studiegruppe hver anden uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege ein Muster fest, das sich alle fünf Wochen wiederholt. Gerade und ungerade Wochen dürfen sich unterscheiden – etwa bei einer Lerngruppe alle zwei Wochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όρισε ένα μοτίβο που επαναλαμβάνεται κάθε πέντε εβδομάδες. Οι μονές και οι ζυγές εβδομάδες μπορούν να διαφέρουν — για παράδειγμα, μια ομάδα μελέτης κάθε δεύτερη εβδομάδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a pattern that repeats every five weeks. Odd and even weeks can differ — a biweekly study group, for instance."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a pattern that repeats every five weeks. Odd and even weeks can differ — a biweekly study group, for instance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define un patrón que se repite cada cinco semanas. Las semanas pares e impares pueden ser distintas, como un grupo de estudio quincenal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta viiden viikon välein toistuva kaava. Parittomat ja parilliset viikot voivat erota toisistaan – esimerkiksi joka toinen viikko kokoontuva opintopiiri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un motif qui se répète toutes les cinq semaines. Semaines paires et impaires peuvent différer, par exemple pour un groupe d’étude un week-end sur deux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur pola yang berulang setiap lima minggu. Minggu ganjil dan genap bisa berbeda — misalnya kelompok belajar dua mingguan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta uno schema che si ripete ogni cinque settimane. Le settimane pari e dispari possono essere diverse, come per un gruppo di studio a settimane alterne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5週ごとに繰り返すパターンを設定します。隔週の勉強会のように、奇数週と偶数週で内容が違う予定も登録できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5주 단위로 반복되는 패턴을 설정하세요. 격주 스터디처럼 홀수/짝수 주가 다른 일도 적을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi et mønster som gjentas hver femte uke. Oddetalls- og partallsuker kan være forskjellige – for eksempel en studiegruppe annenhver uke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel een patroon in dat elke vijf weken terugkomt. Even en oneven weken mogen verschillen — handig voor bijvoorbeeld een tweewekelijkse studiegroep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw wzór powtarzający się co pięć tygodni. Tygodnie parzyste i nieparzyste mogą się różnić — na przykład przy spotkaniach co dwa tygodnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina um padrão que se repete a cada cinco semanas. Semanas pares e ímpares podem ser diferentes, como um grupo de estudos quinzenal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте шаблон, который повторяется каждые пять недель. Нечётные и чётные недели могут отличаться — например, учёба раз в две недели."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in ett mönster som upprepas var femte vecka. Udda och jämna veckor kan skilja sig åt – till exempel en studiecirkel varannan vecka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งรูปแบบที่วนซ้ำทุก 5 สัปดาห์ งานที่สัปดาห์คี่กับคู่ต่างกัน เช่น กลุ่มติวทุกสองสัปดาห์ ก็ใส่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beş haftada bir tekrarlanan bir düzen kurun. İki haftada bir yapılan bir çalışma grubu gibi, tek ve çift haftaları farklı olan işleri de yazabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt một khuôn mẫu lặp lại mỗi năm tuần. Tuần lẻ và tuần chẵn có thể khác nhau — ví dụ một nhóm học cách tuần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置以 5 周为单位重复的模式。像隔周读书会这种单周、双周不同的事也能记下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定以 5 週為單位重複的模式。像隔週讀書會這種單週、雙週不同的事也能記下。"
          }
        }
      }
    },
