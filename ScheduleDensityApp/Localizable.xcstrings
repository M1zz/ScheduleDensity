          }
        }
      }
    },
    "꾸준함" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consistency"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
