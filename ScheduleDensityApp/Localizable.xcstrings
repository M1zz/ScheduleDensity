    "단계는 언제든 다시 적고, 순서도 바꿀 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky můžete kdykoli přepsat a změnit jejich pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan altid omskrive trinnene og ændre deres rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Schritte jederzeit umschreiben und umsortieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείς να ξαναγράψεις τα βήματα και να αλλάξεις τη σειρά τους όποτε θέλεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can rewrite steps and reorder them at any time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can rewrite steps and reorder them at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes reescribir los pasos y cambiar su orden cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit kirjoittaa vaiheet uudelleen ja järjestää ne milloin vain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez réécrire les étapes et changer leur ordre à tout moment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah bisa ditulis ulang dan diubah urutannya kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi riscrivere e riordinare le fasi quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステップはいつでも書き直せて、順番も変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단계는 언제든 다시 적고, 순서도 바꿀 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan når som helst skrive om trinnene og endre rekkefølgen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt stappen altijd herschrijven en van volgorde veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroki możesz w każdej chwili przepisać i zmienić ich kolejność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode reescrever e reordenar as etapas quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаги можно в любой момент переписать и поменять местами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan skriva om stegen och ändra ordningen när du vill."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนขั้นตอนใหม่หรือเปลี่ยนลำดับได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adımları istediğiniz zaman yeniden yazabilir, sıralarını değiştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể viết lại các bước và đổi thứ tự bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步骤随时都能重写，也能调整顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步驟隨時都能重寫，也能調整順序。"
          }
        }
      }
    },
    "단계는 한 번 앉아서 끝낼 수 있는 크기여야 합니다. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다.\n이 일 전체 시간은 단계들의 합이 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krok by měl být tak malý, aby se dal dokončit na jeden zátah. Napůl hotový krok vám odvádí pozornost i do další hodiny.\nCelkový čas tohoto úkolu je součtem jeho kroků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et trin skal være så lille, at det kan klares i ét stræk. Et halvfærdigt trin trækker din opmærksomhed med ind i den næste time.\nOpgavens samlede tid er summen af dens trin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Schritt sollte so klein sein, dass er sich an einem Stück erledigen lässt. Ein halb erledigter Schritt zieht deine Aufmerksamkeit in die nächste Stunde.\nDie Gesamtzeit dieser Aufgabe ist die Summe ihrer Schritte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα βήμα πρέπει να είναι αρκετά μικρό ώστε να τελειώνει με ένα κάθισμα. Ένα βήμα που μένει στη μέση τραβάει την προσοχή σου και στην επόμενη ώρα.\nΟ συνολικός χρόνος αυτής της εργασίας είναι το άθροισμα των βημάτων της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A step should be small enough to finish in one sitting. A half-done step drags your attention into the next hour.\nThe job's total time is the sum of its steps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A step should be small enough to finish in one sitting. A half-done step drags your attention into the next hour.\nThe job's total time is the sum of its steps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paso debe ser lo bastante pequeño para terminarlo de una sentada. Un paso a medias arrastra tu atención a la hora siguiente.\nEl tiempo total de esta tarea es la suma de sus pasos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaiheen pitäisi olla niin pieni, että sen saa valmiiksi yhdellä istumalla. Kesken jäänyt vaihe vetää huomiosi mukanaan seuraavaan tuntiin.\nTämän tehtävän kokonaisaika on sen vaiheiden summa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étape doit être assez petite pour se terminer d’une traite. Une étape laissée à moitié entraîne votre attention dans l’heure suivante.\nLa durée totale de cette tâche est la somme de ses étapes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah harus cukup kecil untuk selesai sekali duduk. Langkah yang setengah jadi menyeret perhatian Anda ke jam berikutnya.\nTotal waktu tugas ini adalah jumlah langkah-langkahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fase deve essere abbastanza piccola da finirla in una sola seduta. Una fase lasciata a metà si trascina la tua attenzione nell’ora successiva.\nLa durata totale di questa attività è la somma delle sue fasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステップは、一度座って終えられる大きさにします。やりかけのステップは、次の時間まで注意を引きずります。\nこのやること全体の時間は、ステップの合計になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단계는 한 번 앉아서 끝낼 수 있는 크기여야 합니다. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다.\n이 일 전체 시간은 단계들의 합이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et trinn bør være så lite at det kan gjøres ferdig i én økt. Et halvferdig trinn drar oppmerksomheten din med inn i neste time.\nOppgavens totale tid er summen av trinnene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stap moet klein genoeg zijn om in één zit af te ronden. Een half afgemaakte stap trekt je aandacht mee naar het volgende uur.\nDe totale tijd van deze taak is de som van de stappen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krok powinien być na tyle mały, by skończyć go za jednym posiedzeniem. Krok zostawiony w połowie ciągnie uwagę do następnej godziny.\nCałkowity czas zadania to suma jego kroków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma etapa deve ser pequena o bastante para terminar numa sentada só. Uma etapa deixada pela metade arrasta sua atenção para a hora seguinte.\nO tempo total desta tarefa é a soma das etapas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаг должен быть таким, чтобы закончить его за один подход. Недоделанный шаг тянет внимание и в следующий час.\nОбщее время задачи — сумма её шагов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett steg ska vara så litet att du blir klar med det i ett enda pass. Ett halvfärdigt steg drar med sig din uppmärksamhet in i nästa timme.\nDen totala tiden för uppgiften är summan av dess steg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขั้นตอนควรเล็กพอที่จะทำจบได้ในการนั่งครั้งเดียว ขั้นตอนที่ทำค้างไว้จะดึงความสนใจของคุณไปจนถึงชั่วโมงถัดไป\nเวลารวมของสิ่งที่ต้องทำนี้คือผลรวมของขั้นตอนทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir adım, tek oturuşta bitecek kadar küçük olmalı. Yarım kalan bir adım dikkatinizi bir sonraki saate de taşır.\nBu görevin toplam süresi, adımlarının toplamıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bước nên đủ nhỏ để làm xong trong một lần ngồi. Một bước làm dở sẽ kéo sự chú ý của bạn sang giờ tiếp theo.\nTổng thời gian của việc này là tổng các bước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步骤要小到一次坐下就能做完。做到一半的步骤会把注意力拖到下一段时间。\n这件事的总时间就是各步骤的加总。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步驟要小到一次坐下就能做完。做到一半的步驟會把注意力拖到下一段時間。\n這件事的總時間就是各步驟的加總。"
          }
        }
      }
    },
