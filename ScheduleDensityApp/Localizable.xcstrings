          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ปุ่มแชร์ที่มุมขวาบนเพื่อเชิญคนที่จะใช้ด้วยกัน\nหรือแตะลิงก์คำเชิญที่ได้รับเพื่อเข้าร่วม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
