            "state" : "translated",
            "value" : "與 Mac 同步"
          }
        }
      }
    },
    "맥과 함께 쓰기" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
