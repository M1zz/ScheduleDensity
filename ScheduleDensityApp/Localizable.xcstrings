    },
    "진한 칸은 실제로 시간을 쓰는 날, 옅은 칸은 매여만 있는 날입니다. 스터디가 화요일에만 모여도 끝나는 날까지 계속 옅게 이어지는 이유예요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tmavá políčka jsou dny, kdy na věci opravdu trávíte čas; světlá jsou dny, kdy vás jen drží. Proto se studijní skupina, která se schází jen v úterý, táhne světle až do svého posledního dne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mørke felter er dage, du faktisk bruger tid på; blege felter er dage, den blot binder dig. Derfor fortsætter en studiegruppe, der kun mødes om tirsdagen, blegt helt til sidste dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräftige Kästchen sind Tage, an denen du wirklich Zeit aufwendest, blasse sind Tage, an denen dich die Sache nur bindet. Deshalb bleibt eine Lerngruppe, die sich nur dienstags trifft, bis zum letzten Tag blass sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σκούρα κελιά είναι μέρες που πραγματικά αφιερώνεις χρόνο· τα αχνά είναι μέρες που απλώς σε δεσμεύει. Γι’ αυτό μια ομάδα μελέτης που συναντιέται μόνο την Τρίτη μένει αχνή ως την τελευταία της μέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark cells are days you actually spend time; pale cells are days it merely holds you. That's why a Tuesday-only study group stays pale all the way to its last day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark cells are days you actually spend time; pale cells are days it merely holds you. That's why a Tuesday-only study group stays pale all the way to its last day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las celdas intensas son días en que de verdad dedicas tiempo; las claras, días en que solo te tiene atado. Por eso un grupo de estudio que solo se reúne los martes sigue en tono claro hasta su último día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tummat ruudut ovat päiviä, joina oikeasti käytät aikaa; haaleat ovat päiviä, joina työ vain sitoo sinua. Siksi tiistaisin kokoontuva opintopiiri näkyy haaleana viimeiseen päiväänsä asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cases foncées sont les jours où vous y passez vraiment du temps, les pâles ceux où le travail vous mobilise seulement. C’est pourquoi un groupe d’étude du mardi reste en pâle jusqu’à son dernier jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotak pekat adalah hari Anda benar-benar memakai waktu; kotak pucat adalah hari yang hanya mengikat Anda. Itu sebabnya kelompok belajar yang hanya bertemu tiap Selasa tetap berwarna pucat sampai hari terakhirnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le celle intense sono i giorni in cui ci dedichi davvero del tempo; quelle tenui sono i giorni in cui ti impegna e basta. Per questo un gruppo di studio che si riunisce solo il martedì resta tenue fino all’ultimo giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "濃いマスは実際に時間を使う日、薄いマスはとられているだけの日です。勉強会が火曜日だけでも、終わる日までずっと薄く続くのはそのためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진한 칸은 실제로 시간을 쓰는 날, 옅은 칸은 매여만 있는 날입니다. 스터디가 화요일에만 모여도 끝나는 날까지 계속 옅게 이어지는 이유예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mørke ruter er dager du faktisk bruker tid på; bleke ruter er dager den bare binder deg. Derfor fortsetter en studiegruppe som bare møtes på tirsdager, blekt helt til siste dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donkere vakjes zijn dagen waarop je er echt tijd aan besteedt, lichte vakjes dagen waarop het je alleen bezighoudt. Daarom loopt een studiegroep die alleen op dinsdag samenkomt licht door tot de laatste dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciemne komórki to dni, w które naprawdę poświęcasz czas; jasne to dni, w które sprawa tylko Cię wiąże. Dlatego grupa spotykająca się tylko we wtorki ciągnie się jasno aż do ostatniego dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Células fortes são dias em que você realmente dedica tempo; as claras, dias em que você só fica preso. Por isso um grupo de estudos que só se reúne às terças continua em tom claro até o último dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яркие клетки — дни, когда вы действительно тратите время, бледные — дни, когда дело просто держит вас. Поэтому учебная группа по вторникам тянется бледной полосой до самого последнего дня."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mörka rutor är dagar du faktiskt lägger tid på; bleka rutor är dagar det bara binder dig. Därför förblir en studiecirkel som bara träffas på tisdagar blek ända till sista dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่องสีเข้มคือวันที่ใช้เวลาจริง ช่องสีจางคือวันที่แค่ผูกอยู่ นั่นคือเหตุผลที่กลุ่มติวซึ่งนัดแค่วันอังคาร ยังแสดงจาง ๆ ต่อเนื่องไปจนถึงวันสุดท้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koyu hücreler gerçekten zaman ayırdığınız, soluk hücreler yalnızca sizi bağlı tuttuğu günlerdir. Yalnızca salı toplanan bir çalışma grubunun son gününe kadar soluk uzanmasının nedeni budur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ô đậm là ngày bạn thực sự dành thời gian, ô nhạt là ngày việc chỉ đang giữ chân bạn. Đó là lý do nhóm học chỉ họp thứ Ba vẫn hiện nhạt đến tận ngày cuối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深色格是实际花时间的日子，浅色格是只是被绑住的日子。所以读书会即使只在星期二聚会，也会一路淡淡延续到结束那天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深色格是實際花時間的日子，淺色格是只是被綁住的日子。所以讀書會即使只在星期二聚會，也會一路淡淡延續到結束那天。"
          }
        }
      }
    },
