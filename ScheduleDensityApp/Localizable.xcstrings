    "오늘과 내일 남은 일정이 여기에 보입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tady uvidíte zbývající události na dnešek a zítřek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resterende begivenheder i dag og i morgen vises her."
