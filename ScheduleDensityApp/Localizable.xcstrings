    "iCloud 에서 지우지 못해 이 기기에서도 지우지 않았습니다. 한쪽만 지우면 나중에 다시 내려옵니다.\n\n%@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z iCloudu se to smazat nepodařilo, a proto se to nesmazalo ani tady. Kdybyste smazali jen jednu stranu, později by se to vrátilo.\n\n%@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kunne ikke slettes fra iCloud, så det blev heller ikke slettet her. Sletter du kun det ene sted, kommer det tilbage senere.\n\n%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte nicht aus iCloud gelöscht werden, deshalb wurde es auch hier nicht gelöscht. Wird nur auf einer Seite gelöscht, kommt es später zurück.\n\n%@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η διαγραφή από το iCloud, οπότε δεν διαγράφηκε ούτε εδώ. Αν διαγραφεί μόνο από τη μία πλευρά, θα επιστρέψει αργότερα.\n\n%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It couldn't be deleted from iCloud, so it wasn't deleted here either. Delete one side only and it comes back later.\n\n%@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It couldn't be deleted from iCloud, so it wasn't deleted here either. Delete one side only and it comes back later.\n\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo eliminar de iCloud, así que tampoco se eliminó aquí. Si lo eliminas solo de un lado, volverá a aparecer más tarde.\n\n%@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaminen iCloudista epäonnistui, joten sitä ei poistettu täältäkään. Jos poistat vain toiselta puolelta, se palaa myöhemmin.\n\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression a échoué sur iCloud, donc rien n’a été supprimé ici non plus. Si un seul côté est supprimé, l’élément revient plus tard.\n\n%@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data tidak bisa dihapus dari iCloud, jadi di perangkat ini juga tidak dihapus. Jika hanya satu sisi yang dihapus, datanya akan muncul lagi nanti.\n\n%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile eliminarlo da iCloud, quindi non è stato eliminato nemmeno qui. Se lo elimini da una parte sola, più tardi ricompare.\n\n%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudから削除できなかったため、このデバイスからも削除していません。片方だけ削除すると、あとでまた戻ってきてしまいます。\n\n%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 에서 지우지 못해 이 기기에서도 지우지 않았습니다. 한쪽만 지우면 나중에 다시 내려옵니다.\n\n%@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kunne ikke slettes fra iCloud, så det ble heller ikke slettet her. Sletter du bare på ett sted, kommer det tilbake senere.\n\n%@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kon niet uit iCloud worden verwijderd, dus het is hier ook niet verwijderd. Verwijder je het maar aan één kant, dan komt het later terug.\n\n%@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się usunąć z iCloud, więc nie usunięto też z tego urządzenia. Gdyby usunąć tylko z jednej strony, dane wróciłyby później.\n\n%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível apagar do iCloud, então também não foi apagado aqui. Se apagar só de um lado, ele volta depois.\n\n%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить из iCloud, поэтому на этом устройстве тоже ничего не удалено. Если удалить только с одной стороны, данные потом вернутся.\n\n%@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att radera från iCloud, så det raderades inte heller här. Raderar du bara på ena sidan kommer det tillbaka senare.\n\n%@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบจาก iCloud ไม่ได้ จึงไม่ได้ลบจากอุปกรณ์นี้ด้วย ถ้าลบแค่ฝั่งเดียว ข้อมูลจะกลับมาอีกภายหลัง\n\n%@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud’dan silinemediği için burada da silinmedi. Yalnızca bir taraftan silinirse daha sonra geri gelir.\n\n%@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không xóa được trên iCloud nên cũng chưa xóa ở đây. Nếu chỉ xóa một bên, dữ liệu sẽ quay lại sau.\n\n%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从 iCloud 删除，所以此设备上也没有删除。只删除一边的话，之后会再同步回来。\n\n%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法從 iCloud 刪除，所以此裝置上也沒有刪除。只刪除一邊的話，之後會再同步回來。\n\n%@"
          }
        }
      }
    },
    "iCloud를 사용하려면 설정에서 Apple ID로 로그인해주세요." : {
