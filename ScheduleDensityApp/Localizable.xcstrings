    "번개는\n‘지금 바로’ 라는 뜻" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blesk znamená\n„hned teď“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynet betyder\n“lige nu”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Blitz heißt\n„jetzt sofort“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Αστραπή σημαίνει\n«αμέσως»"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bolt means\n'right now'"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bolt means\n'right now'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rayo significa\n“ya mismo”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salama tarkoittaa\n”heti”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Éclair veut dire\n« tout de suite »"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilat artinya\n‘sekarang juga’"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Fulmine significa\n“subito”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稲妻は\n「今すぐ」のしるし"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번개는\n‘지금 바로’ 라는 뜻"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynet betyr\n«akkurat nå»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bliksem betekent\n‘nu meteen’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Błyskawica znaczy\n„od razu”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O raio quer dizer\n“agora mesmo”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Молния значит\n«прямо сейчас»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blixten betyder\n”direkt”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สายฟ้าแปลว่า\n“ทำได้เลยตอนนี้”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimşek\n“hemen şimdi” demek"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tia chớp nghĩa là\n“làm ngay”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闪电的意思是\n“现在马上”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閃電的意思是\n「現在馬上」"
          }
        }
      }
    },
    "번개는 ‘이건 준비 없이 바로 된다’고 내가 직접 붙이는 표시입니다. 5분 열두 번은 한 시간이 아니라서, 짬에 집을 수 있는 일은 따로 표시해 두어야 흘러가지 않아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blesk je značka, kterou si dáváte sami: tohle jde udělat hned, bez rozjezdu. Dvanáct pětiminutovek nedá hodinu, a proto si to, co se vejde do krátké mezery, musíte označit předem – jinak vám ty chvilky protečou mezi prsty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynet er en markering, du selv sætter, og den siger: Den her kræver ingen opvarmning. Tolv huller på fem minutter er ikke én time, så medmindre du markerer det, der passer i et hul, løber hullerne dig af hænde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Blitz setzt du selbst – als Zeichen dafür, dass etwas ohne Anlauf geht. Zwölfmal fünf Minuten sind keine Stunde. Wenn du nicht markierst, was in eine Lücke passt, zerrinnen dir die Lücken zwischen den Fingern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Αστραπή είναι μια σήμανση που βάζεις μόνος σου και λέει ότι αυτό γίνεται χωρίς ζέσταμα. Δώδεκα πεντάλεπτα δεν κάνουν μία ώρα· αν δεν σημειώσεις ό,τι χωράει σε ένα κενό, τα κενά γλιστρούν μέσα από τα χέρια σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bolt is a mark you put on yourself, saying this one needs no warm-up. Twelve five-minute gaps aren't an hour, so unless you mark what fits in a gap, the gaps run out through your fingers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bolt is a mark you put on yourself, saying this one needs no warm-up. Twelve five-minute gaps aren't an hour, so unless you mark what fits in a gap, the gaps run out through your fingers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rayo es una marca que pones tú para decir: esto se hace sin preparación. Doce huecos de cinco minutos no son una hora, así que si no marcas lo que cabe en un hueco, los huecos se te escapan entre los dedos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salama on merkintä, jonka lisäät itse: tämä ei vaadi lämmittelyä. Kaksitoista viiden minuutin rakoa ei ole tunti, joten ellet merkitse rakoon mahtuvia asioita, raot valuvat sormien läpi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Éclair est une marque que vous posez vous-même pour dire : celle-ci se fait sans préparation. Douze fois cinq minutes ne font pas une heure ; si vous ne marquez pas ce qui tient dans un creux, les creux vous filent entre les doigts."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilat adalah tanda yang Anda pasang sendiri, artinya ‘yang ini bisa langsung dikerjakan tanpa persiapan’. Dua belas kali lima menit bukan satu jam, jadi pekerjaan yang muat di sela waktu harus ditandai agar celah itu tidak terbuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Fulmine è un segno che metti tu, per dire “questa si fa subito, senza preparazione”. Dodici volte cinque minuti non fanno un’ora: se non segni ciò che sta in un momento libero, quei momenti ti scivolano tra le dita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稲妻は「これは準備なしですぐできる」と自分で付ける印です。5分を12回集めても1時間にはならないので、すき間時間に手に取れることは別に印を付けておかないと、すき間はそのまま流れていってしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번개는 ‘이건 준비 없이 바로 된다’고 내가 직접 붙이는 표시입니다. 5분 열두 번은 한 시간이 아니라서, 짬에 집을 수 있는 일은 따로 표시해 두어야 흘러가지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynet er et merke du setter selv, og det sier: Denne krever ingen oppvarming. Tolv luker på fem minutter er ikke én time, så med mindre du merker det som passer i en luke, renner lukene ut mellom fingrene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bliksem is een label dat je zelf plakt: ‘dit kan zonder voorbereiding’. Twaalf keer vijf minuten is geen uur, dus wat in een gaatje past, moet je apart markeren, anders glippen die gaatjes je door de vingers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Błyskawica to znak, który stawiasz sam: „to da się zrobić od razu, bez rozruchu”. Dwanaście razy po pięć minut to nie godzina, więc jeśli nie oznaczysz tego, co mieści się w luce, luki przeciekną Ci przez palce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O raio é uma marca que você mesmo coloca para dizer: isto sai sem preparação. Doze brechas de cinco minutos não são uma hora, então, se você não marcar o que cabe numa brecha, as brechas escorrem pelos dedos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Молния — это отметка, которую вы ставите сами: «это можно сделать без раскачки». Двенадцать раз по пять минут — не час, поэтому то, что помещается в паузу, нужно отмечать отдельно, иначе паузы утекают сквозь пальцы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blixten är en markering du sätter själv och som säger att det här inte kräver någon uppstart. Tolv femminutersluckor blir inte en timme, så om du inte markerar det som ryms i en lucka rinner luckorna mellan fingrarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สายฟ้าคือเครื่องหมายที่คุณติดเองว่า “อันนี้ไม่ต้องวอร์มเครื่อง ทำได้เลย” ห้านาทีสิบสองครั้งไม่ใช่หนึ่งชั่วโมง ถ้าไม่ทำเครื่องหมายงานที่ใส่ในช่องว่างได้ไว้ ช่องว่างเหล่านั้นก็จะไหลผ่านไปเฉย ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimşek, “bu iş hazırlık istemez, hemen yapılır” diye bizzat koyduğunuz bir işarettir. On iki kez beş dakika bir saat etmez; bu yüzden bir boşluğa sığan işleri ayrıca işaretlemezseniz o boşluklar elinizden kayıp gider."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tia chớp là dấu do chính bạn gắn, nói rằng việc này không cần khởi động. Mười hai lần năm phút không bằng một giờ, nên nếu không đánh dấu riêng những việc vừa một khoảng trống, các khoảng trống sẽ trôi tuột mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闪电是你自己贴上的标记，表示“这件事不用准备，马上就能做”。十二次 5 分钟不等于一小时，所以能在空档拿起来做的事要另外标出来，才不会白白流走。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閃電是你自己貼上的標記，表示「這件事不用準備，馬上就能做」。十二次 5 分鐘不等於一小時，所以能在空檔拿起來做的事要另外標出來，才不會白白流走。"
          }
        }
      }
    },
    "번개를 붙인 줄은 차례와 상관없이 목록 맨 위 연두 칸에 섭니다. 짬이 났을 때 목록을 훑지 않고 맨 위만 봐도 되도록요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řádek s Bleskem přeskočí frontu a stojí v zeleném poli nahoře. Když se uvolní chvilka, stačí se podívat nahoru, nemusíte procházet celý seznam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En linje med lyn springer køen over og står i den grønne boks øverst – så når der opstår et hul, skal du kun kigge deroppe og ikke gennemgå hele listen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zeile mit Blitz überspringt die Reihenfolge und steht oben im grünen Feld. Wenn sich eine Lücke auftut, schaust du nur dorthin, statt die ganze Liste durchzugehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια γραμμή με Αστραπή προσπερνά την ουρά και στέκεται στο πράσινο πλαίσιο στην κορυφή — έτσι, όταν ανοίξει ένα κενό, κοιτάς μόνο εκεί πάνω αντί να διαβάζεις όλη τη λίστα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bolted line jumps the queue and stands in the green box at the top — so when a gap opens you only have to look up there, not scan the whole list."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bolted line jumps the queue and stands in the green box at the top — so when a gap opens you only have to look up there, not scan the whole list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línea con rayo se salta la cola y se coloca en el recuadro verde de arriba. Así, cuando se abre un hueco, solo tienes que mirar ahí, sin repasar toda la lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salamalla merkitty rivi ohittaa jonon ja nousee vihreään laatikkoon ylimmäksi – kun rako aukeaa, katsot vain sinne etkä selaa koko listaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne avec un Éclair passe devant tout le monde et se place dans l’encadré vert en haut. Quand un creux se présente, il suffit de regarder là, sans parcourir toute la liste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris yang diberi Kilat berdiri di kotak hijau muda paling atas, tanpa peduli urutan. Saat ada waktu luang, cukup lihat bagian atas tanpa menelusuri seluruh daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una riga con il Fulmine salta la fila e si mette nel riquadro verde in cima all’elenco. Così, quando hai un momento libero, ti basta guardare lì invece di scorrere tutto l’elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稲妻を付けた行は、順番に関係なくリストのいちばん上の黄緑の枠に並びます。すき間時間ができたとき、リスト全体を見なくても上だけ見ればいいように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번개를 붙인 줄은 차례와 상관없이 목록 맨 위 연두 칸에 섭니다. 짬이 났을 때 목록을 훑지 않고 맨 위만 봐도 되도록요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En linje med lyn hopper over køen og står i den grønne boksen øverst – så når det åpner seg en luke, trenger du bare å se der oppe, ikke gå gjennom hele listen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een regel met een bliksem slaat de rij over en staat bovenaan in het groene vak. Zo kijk je bij een gaatje alleen daar, in plaats van de hele lijst door te lopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozycja z Błyskawicą omija kolejkę i staje w zielonym polu na samej górze — gdy pojawi się luka, wystarczy spojrzeć tam, a nie przeglądać całą listę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha com raio fura a fila e fica no quadro verde lá em cima. Assim, quando surge uma brecha, basta olhar ali, sem percorrer a lista inteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строка с молнией встаёт в зелёный блок наверху списка вне очереди. Когда появляется пауза, не нужно просматривать весь список — достаточно взглянуть наверх."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rad med blixt går före i kön och står i den gröna rutan högst upp – så när en lucka öppnar sig behöver du bara titta där, inte skumma hela listan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บรรทัดที่ติดสายฟ้าจะลัดคิวไปอยู่ในกล่องสีเขียวอ่อนบนสุดของรายการ เมื่อมีช่องว่าง แค่มองด้านบนก็พอ ไม่ต้องไล่ดูทั้งรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimşekli bir satır sırasını beklemez, listenin en üstündeki yeşil kutuya geçer. Böylece bir boşluk açıldığında bütün listeyi taramanız gerekmez, en üste bakmanız yeter."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dòng có Tia chớp được chen lên trước, nằm trong ô xanh lá trên cùng — để khi có khoảng trống, bạn chỉ cần nhìn lên đó, không phải dò cả danh sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴上闪电的项目不管顺序，都会站到清单最上方的浅绿色格子里。这样有空档时不必扫过整份清单，只看最上面就好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上閃電的項目不管順序，都會站到清單最上方的淺綠色格子裡。這樣有空檔時不必掃過整份清單，只看最上面就好。"
          }
        }
      }
    },
    "번개를 붙인다고 마감이나 걸린 시간이 바뀌지는 않아요. 어디에 서는지만 달라집니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blesk nemění termín ani to, jak dlouho věc trvá. Mění jen to, kde stojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynet ændrer hverken en deadline eller den tid, noget tager. Det ændrer kun, hvor det står."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Blitz ändert weder Deadline noch Dauer. Er ändert nur, wo etwas steht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Αστραπή δεν αλλάζει την προθεσμία ούτε τον χρόνο που παίρνει κάτι. Αλλάζει μόνο πού στέκεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bolt doesn't change a deadline or the time something takes. It only changes where it stands."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bolt doesn't change a deadline or the time something takes. It only changes where it stands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rayo no cambia la fecha límite ni lo que tarda algo. Solo cambia dónde se coloca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salama ei muuta määräaikaa eikä kestoa. Se muuttaa vain paikkaa listassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Éclair ne change ni l’échéance ni la durée. Il change seulement la place de la tâche."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilat tidak mengubah tenggat atau lama pengerjaan. Yang berubah hanya posisinya di daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Fulmine non cambia la scadenza né il tempo richiesto. Cambia solo il posto in elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稲妻を付けても、締め切りやかかる時間は変わりません。並ぶ位置が変わるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번개를 붙인다고 마감이나 걸린 시간이 바뀌지는 않아요. 어디에 서는지만 달라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynet endrer verken en frist eller tiden noe tar. Det endrer bare hvor det står."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bliksem verandert niets aan de deadline of aan hoelang iets duurt. Alleen aan waar het staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Błyskawica nie zmienia terminu ani czasu trwania. Zmienia tylko miejsce na liście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O raio não muda o prazo nem quanto tempo algo leva. Só muda onde ele fica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Молния не меняет ни дедлайн, ни длительность. Меняется только место в списке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blixten ändrar inte deadline eller hur lång tid något tar. Den ändrar bara var det står."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การติดสายฟ้าไม่ได้เปลี่ยนกำหนดส่งหรือเวลาที่ใช้ เปลี่ยนแค่ตำแหน่งที่มันอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimşek bir işin son tarihini ya da süresini değiştirmez. Yalnızca nerede durduğunu değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tia chớp không đổi hạn chót hay thời gian của việc. Nó chỉ đổi chỗ việc đó đứng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴上闪电不会改变截止日或所需时间，只会改变它站的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上閃電不會改變截止日或所需時間，只會改變它站的位置。"
          }
        }
      }
    },
