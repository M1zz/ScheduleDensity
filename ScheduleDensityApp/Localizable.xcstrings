          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng nút chia sẻ ở góc trên bên phải để mời ai đó,\nhoặc chạm vào liên kết mời bạn nhận được để tham gia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
