    "이 기기에서 지웁니다. iCloud 에는 올라간 적이 없습니다. 되돌릴 수 없습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaže to z tohoto zařízení. Na iCloud se to nikdy nedostalo. Tuto akci nelze vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter den fra denne enhed. Den blev aldrig sendt op til iCloud. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht es von diesem Gerät. In iCloud war es nie. Das kann nicht widerrufen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφεται από αυτή τη συσκευή. Δεν ανέβηκε ποτέ στο iCloud. Αυτό δεν αναιρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes it from this device. It never went up to iCloud. This can't be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes it from this device. It never went up to iCloud. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimina de este dispositivo. Nunca se subió a iCloud. Esta acción no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa sen tältä laitteelta. Sitä ei ole koskaan lähetetty iCloudiin. Tätä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime l’élément de cet appareil. Il n’a jamais été envoyé sur iCloud. Action irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihapus dari perangkat ini. Data ini belum pernah diunggah ke iCloud. Tindakan ini tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo elimina da questo dispositivo. Non è mai stato caricato su iCloud. L’operazione non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから削除します。iCloudにはアップロードされたことがありません。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 지웁니다. iCloud 에는 올라간 적이 없습니다. 되돌릴 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter den fra denne enheten. Den ble aldri lastet opp til iCloud. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert het van dit apparaat. Het is nooit naar iCloud geüpload. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa z tego urządzenia. Nigdy nie trafiło do iCloud. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga deste dispositivo. Nunca foi enviado ao iCloud. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет с этого устройства. В iCloud это никогда не загружалось. Действие нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar det från den här enheten. Det har aldrig laddats upp till iCloud. Det här går inte att ångra."
