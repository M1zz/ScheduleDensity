    "같은 제목과 같은 기간의 일정이 이미 무지개에 있습니다. 다른 기기에서 적은 것일 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Událost se stejným názvem a obdobím už v duze je. Možná byla zapsána na jiném zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En begivenhed med samme titel og periode er allerede på regnbuen. Den kan være skrevet ind på en anden enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Termin mit gleichem Titel und Zeitraum ist schon im Regenbogen. Vielleicht wurde er auf einem anderen Gerät eingetragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχει ήδη στο ουράνιο τόξο συμβάν με τον ίδιο τίτλο και την ίδια διάρκεια. Ίσως καταχωρίστηκε σε άλλη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An event with the same title and span is already on the Rainbow. It may have been added on another device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An event with the same title and span is already on the Rainbow. It may have been added on another device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay en el arcoíris un evento con el mismo título y el mismo periodo. Puede que se añadiera en otro dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sateenkaaressa on jo tapahtuma, jolla on sama otsikko ja ajanjakso. Se on ehkä kirjattu toisella laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un événement avec le même titre et la même période figure déjà sur l’Arc-en-ciel. Il a peut-être été ajouté sur un autre appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadwal dengan judul dan rentang yang sama sudah ada di Pelangi. Mungkin dicatat di perangkat lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sull’Arcobaleno c’è già un evento con lo stesso titolo e lo stesso periodo. Forse è stato aggiunto su un altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じタイトル・同じ期間の予定がすでに虹にあります。別のデバイスで書いたものかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 제목과 같은 기간의 일정이 이미 무지개에 있습니다. 다른 기기에서 적은 것일 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hendelse med samme tittel og periode ligger allerede på regnbuen. Den kan være lagt inn på en annen enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat al een activiteit met dezelfde titel en periode op de regenboog. Misschien is die op een ander apparaat ingevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tęczy jest już wydarzenie o tym samym tytule i okresie. Mogło zostać dodane na innym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe no arco-íris um evento com o mesmo título e o mesmo período. Talvez tenha sido adicionado em outro dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На радуге уже есть событие с таким же названием и периодом. Возможно, его добавили на другом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns redan en händelse med samma titel och period i regnbågen. Den kan ha lagts till på en annan enhet."
