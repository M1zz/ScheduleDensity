    "기간 안에서 실제로 시간을 쓰는 요일만 고르세요. 고르지 않은 날도 기간 안이면 무지개에 옅게 남습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte jen dny v týdnu, kdy na tom opravdu pracujete. Nevybrané dny v rámci období zůstanou v duze bledé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg kun de ugedage, du faktisk bruger tid på det. Dage, du springer over, bliver stadig stående blegt på regnbuen, så længe de ligger i perioden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle nur die Wochentage, an denen du wirklich Zeit dafür aufwendest. Nicht gewählte Tage bleiben im Regenbogen blass sichtbar, solange sie im Zeitraum liegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε μόνο τις ημέρες της εβδομάδας που πραγματικά αφιερώνεις χρόνο. Οι υπόλοιπες μέρες μένουν αχνές στο ουράνιο τόξο, εφόσον είναι μέσα στη διάρκεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick only the weekdays you actually spend time on it. Days you skip still stay on the Rainbow, pale, as long as they're in the span."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick only the weekdays you actually spend time on it. Days you skip still stay on the Rainbow, pale, as long as they're in the span."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige solo los días de la semana en que de verdad le dedicas tiempo. Los días que no elijas siguen en el arcoíris, en tono claro, mientras estén dentro del periodo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse vain viikonpäivät, joina oikeasti käytät siihen aikaa. Ohitetut päivät näkyvät silti haaleina sateenkaaressa, kunhan ne ovat ajanjakson sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez seulement les jours où vous y consacrez vraiment du temps. Les autres jours restent pâles sur l’Arc-en-ciel tant qu’ils sont dans la période."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih hanya hari yang benar-benar Anda pakai untuk mengerjakannya. Hari yang tidak dipilih tetap tampil samar di Pelangi selama masih dalam rentang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli solo i giorni della settimana in cui ci dedichi davvero del tempo. I giorni non scelti restano comunque tenui sull’Arcobaleno, se rientrano nel periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間の中で、実際に時間を使う曜日だけを選んでください。選ばなかった日も、期間内なら虹に薄く残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간 안에서 실제로 시간을 쓰는 요일만 고르세요. 고르지 않은 날도 기간 안이면 무지개에 옅게 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg bare ukedagene du faktisk bruker tid på det. Dager du hopper over, blir likevel stående blekt på regnbuen så lenge de ligger i perioden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies alleen de weekdagen waarop je er echt tijd aan besteedt. Dagen die je overslaat, blijven binnen de periode licht op de regenboog staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz tylko dni tygodnia, w które naprawdę na to poświęcasz czas. Niewybrane dni w obrębie okresu i tak zostaną na tęczy, w jasnym kolorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha só os dias da semana em que você realmente dedica tempo a isso. Os dias não escolhidos continuam no arco-íris, em tom claro, enquanto estiverem dentro do período."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите только те дни недели, когда вы действительно на это тратите время. Невыбранные дни внутри периода тоже останутся на радуге — бледными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj bara de veckodagar du faktiskt lägger tid på det. Dagar du hoppar över syns ändå blekt i regnbågen så länge de ligger inom perioden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเฉพาะวันในสัปดาห์ที่ใช้เวลากับงานนี้จริง วันที่ไม่ได้เลือกแต่อยู่ในช่วงเวลา จะยังแสดงจาง ๆ บนสายรุ้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dönem içinde yalnızca gerçekten zaman ayırdığınız günleri seçin. Seçmediğiniz günler de dönem içindeyse gökkuşağında soluk olarak kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ chọn những ngày trong tuần bạn thực sự dành thời gian cho việc này. Ngày không chọn vẫn hiện nhạt trên Cầu vồng, miễn là còn trong khoảng thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只选期间内实际投入时间的星期。没选的日子只要在期间内，仍会淡淡地留在彩虹上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只選期間內實際投入時間的星期。沒選的日子只要在期間內，仍會淡淡地留在彩虹上。"
          }
        }
      }
    },
    "기간 전부가 아니라, 그 안에서 진짜로 손을 대는 요일만 고르세요.\n스터디가 화요일에만 모인다면 화요일만 고르면 됩니다. 나머지 날은 '아직 안 끝난 일'로 옅게 남아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne celé období – jen dny v týdnu, kdy na tom opravdu pracujete.\nPokud se studijní skupina schází jen v úterý, vyberte úterý. Ostatní dny zůstanou bledé jako práce, která ještě neskončila."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke hele perioden – kun de ugedage, du virkelig rører ved det.\nMødes studiegruppen om tirsdagen, så vælg tirsdag. De andre dage står blegt som arbejde, der ikke er færdigt endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht den ganzen Zeitraum – nur die Wochentage, an denen du wirklich daran arbeitest.\nTrifft sich die Lerngruppe nur dienstags, wähle Dienstag. Die übrigen Tage bleiben blass, als Arbeit, die noch nicht fertig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όχι όλη τη διάρκεια — μόνο τις ημέρες που πραγματικά το πιάνεις.\nΑν η ομάδα μελέτης συναντιέται την Τρίτη, διάλεξε την Τρίτη. Οι άλλες μέρες μένουν αχνές, ως δουλειά που δεν έχει τελειώσει ακόμη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not the whole span — only the weekdays you really touch it.\nIf the study group meets on Tuesdays, pick Tuesday. The other days stay pale, as work that isn't finished yet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not the whole span — only the weekdays you really touch it.\nIf the study group meets on Tuesdays, pick Tuesday. The other days stay pale, as work that isn't finished yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No todo el periodo, solo los días de la semana en que de verdad te pones con ello.\nSi el grupo de estudio se reúne los martes, elige el martes. Los demás días quedan en tono claro, como algo que aún no ha terminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei koko ajanjaksoa – vain ne viikonpäivät, joina oikeasti tartut siihen.\nJos opintopiiri kokoontuu tiistaisin, valitse tiistai. Muut päivät jäävät haaleiksi keskeneräisenä työnä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas toute la période : seulement les jours où vous vous y mettez vraiment.\nSi le groupe d’étude se réunit le mardi, choisissez mardi. Les autres jours restent pâles, comme un travail pas encore terminé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan seluruh rentangnya — hanya hari yang benar-benar Anda kerjakan.\nKalau kelompok belajar hanya bertemu hari Selasa, pilih Selasa saja. Hari lainnya tetap samar sebagai pekerjaan yang belum selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non tutto il periodo: solo i giorni in cui ci metti davvero mano.\nSe il gruppo di studio si riunisce il martedì, scegli il martedì. Gli altri giorni restano tenui, come lavoro non ancora finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間全部ではなく、その中で本当に手をつける曜日だけを選んでください。\n勉強会が火曜日だけなら、火曜日だけを選べばOKです。ほかの日は「まだ終わっていないこと」として薄く残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간 전부가 아니라, 그 안에서 진짜로 손을 대는 요일만 고르세요.\n스터디가 화요일에만 모인다면 화요일만 고르면 됩니다. 나머지 날은 '아직 안 끝난 일'로 옅게 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke hele perioden – bare ukedagene du faktisk tar i det.\nMøtes studiegruppen på tirsdager, velger du tirsdag. De andre dagene står blekt som arbeid som ikke er ferdig ennå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet de hele periode — alleen de weekdagen waarop je er echt mee bezig bent.\nKomt de studiegroep alleen op dinsdag samen, kies dan dinsdag. De andere dagen blijven licht, als werk dat nog niet af is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie cały okres — tylko dni tygodnia, w które naprawdę się tym zajmujesz.\nJeśli grupa spotyka się we wtorki, wybierz wtorek. Pozostałe dni zostaną jasne, jako praca jeszcze nieskończona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não o período inteiro, só os dias da semana em que você realmente mexe nisso.\nSe o grupo de estudos se reúne às terças, escolha terça. Os outros dias ficam em tom claro, como algo que ainda não terminou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не весь период, а только дни недели, когда вы действительно этим занимаетесь.\nЕсли учебная группа собирается по вторникам, выберите вторник. Остальные дни останутся бледными — как дело, которое ещё не закончено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte hela perioden – bara de veckodagar du verkligen tar i det.\nOm studiecirkeln träffas på tisdagar väljer du tisdag. De andra dagarna syns blekt, som arbete som inte är klart än."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ใช่ทั้งช่วงเวลา แต่เลือกเฉพาะวันที่ลงมือทำจริง\nถ้ากลุ่มติวนัดเฉพาะวันอังคาร ก็เลือกแค่วันอังคาร วันอื่นจะแสดงจาง ๆ ในฐานะ “งานที่ยังไม่จบ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dönemin tamamını değil, yalnızca işe gerçekten el attığınız günleri seçin.\nÇalışma grubu yalnızca salı günleri toplanıyorsa salıyı seçin. Diğer günler “henüz bitmemiş iş” olarak soluk kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không phải cả khoảng thời gian — chỉ những ngày trong tuần bạn thực sự bắt tay vào.\nNếu nhóm học chỉ họp vào thứ Ba, hãy chọn thứ Ba. Những ngày còn lại hiện nhạt, như việc chưa xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是整段期间，只选你真的会动手的星期。\n如果读书会只在星期二聚会，就只选星期二。其他日子会以“尚未完成的事”淡淡留着。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是整段期間，只選你真的會動手的星期。\n如果讀書會只在星期二聚會，就只選星期二。其他日子會以「尚未完成的事」淡淡留著。"
          }
        }
      }
    },
