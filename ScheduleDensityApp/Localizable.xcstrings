    "iCloud 백업이 해제되었습니다. 로컬 데이터는 유지됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záloha na iCloud je vypnutá. Data v tomto zařízení zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-sikkerhedskopi er slået fra. Dataene på denne enhed bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Sicherung ist aus. Die Daten auf diesem Gerät bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αντίγραφο ασφαλείας iCloud απενεργοποιήθηκε. Τα δεδομένα στη συσκευή παραμένουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud backup is off. The data on this device stays."
          }
        },
