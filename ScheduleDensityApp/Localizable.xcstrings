    "회차는 맥에서 고칩니다. 회차가 있으면 요일 대신 이 날들만 진하게 섭니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekce se upravují na Macu. S lekcemi se místo dnů v týdnu zvýrazní jen tyto dny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessioner redigeres på Mac. Med sessioner fremhæves kun disse dage i stedet for ugedage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine bearbeitest du auf dem Mac. Mit Terminen werden statt Wochentagen nur diese Tage hervorgehoben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συνεδρίες επεξεργάζονται στο Mac. Με συνεδρίες τονίζονται μόνο αυτές οι ημέρες αντί για ημέρες της εβδομάδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit sessions on your Mac. With sessions, only these days are highlighted instead of weekdays."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit sessions on your Mac. With sessions, only these days are highlighted instead of weekdays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones se editan en el Mac. Con sesiones solo se resaltan estos días en lugar de los días de la semana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertoja muokataan Macilla. Kun kertoja on, viikonpäivien sijaan korostuvat vain nämä päivät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séances se modifient sur le Mac. Avec des séances, seuls ces jours sont mis en avant au lieu des jours de la semaine."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi diubah di Mac. Jika ada sesi, hanya hari-hari ini yang ditebalkan, bukan hari dalam seminggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni si modificano sul Mac. Con le sessioni vengono evidenziati solo questi giorni invece dei giorni della settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回はMacで編集します。回があると、曜日の代わりにこの日だけが濃く表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økter redigeres på Mac. Med økter fremheves bare disse dagene i stedet for ukedager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessies bewerk je op de Mac. Met sessies worden alleen deze dagen uitgelicht in plaats van weekdagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesje edytuje się na Macu. Przy sesjach zamiast dni tygodnia wyróżnione są tylko te dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões são editadas no Mac. Com sessões, só estes dias ficam destacados em vez dos dias da semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Занятия редактируются на Mac. С занятиями вместо дней недели выделяются только эти дни."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillfällen redigeras på Mac. Med tillfällen markeras bara de här dagarna i stället för veckodagar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แก้ไขครั้งได้บน Mac เมื่อมีครั้ง จะเน้นเฉพาะวันเหล่านี้แทนวันในสัปดาห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumlar Mac’te düzenlenir. Oturum varsa haftanın günleri yerine yalnızca bu günler vurgulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉnh các buổi trên Mac. Khi có buổi, chỉ những ngày này được tô đậm thay cho các ngày trong tuần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "课次在 Mac 上编辑。有课次时只突出这些日子，而不是按星期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "課次在 Mac 上編輯。有課次時只突顯這些日子，而不是依星期。"
          }
        }
      }
    },
    "한 번 사면 맥 앱도 함께 Pro로 열립니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí koupit jednou a Pro se odemkne i v aplikaci pro Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Køb én gang, så låses Pro også op i Mac-appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal kaufen – Pro gilt auch in der Mac-App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με μία αγορά, το Pro ξεκλειδώνει και στην εφαρμογή Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy once and the Mac app unlocks Pro too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy once and the Mac app unlocks Pro too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra una vez y la app de Mac también desbloquea Pro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi osto avaa Pron myös Mac-apissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul achat débloque aussi Pro dans l’app Mac."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beli sekali, Pro juga terbuka di app Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquista una volta e Pro si sblocca anche nell’app per Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度購入すると、MacアプリでもProが使えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøp én gang, så låses Pro også opp i Mac-appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén keer kopen ontgrendelt Pro ook in de Mac-app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden zakup odblokowuje Pro także w aplikacji na Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compre uma vez e o app do Mac também libera o Pro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна покупка открывает Pro и в приложении для Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köp en gång så låses Pro upp även i Mac-appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซื้อครั้งเดียว แอปบน Mac ก็ปลดล็อก Pro ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez al, Mac uygulamasında da Pro açılsın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mua một lần, ứng dụng Mac cũng mở khóa Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买一次，Mac App 也会一起解锁 Pro。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買一次，Mac App 也會一起解鎖 Pro。"
          }
