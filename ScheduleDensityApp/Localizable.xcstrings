    "초대 링크를 받은 사람은 내 일정을 읽기 전용으로 볼 수 있어요.\n링크는 보여주고 싶은 사람에게만 보내세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo dostane odkaz s pozvánkou, uvidí vaše události, ale nebude je moct měnit.\nOdkaz pošlete jen lidem, kterým je chcete ukázat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle med invitationslinket kan læse dine begivenheder, men ikke ændre dem.\nSend det kun til dem, du vil have skal se dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Einladungslink hat, kann deine Termine lesen, aber nicht ändern.\nSchick ihn nur an Leute, die sie sehen sollen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος έχει τον σύνδεσμο πρόσκλησης μπορεί να διαβάσει τα συμβάντα σου, αλλά όχι να τα αλλάξει.\nΣτείλ’ τον μόνο σε όσους θέλεις να τα βλέπουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the invite link can read your events, but not change them.\nOnly send it to people you want to see them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the invite link can read your events, but not change them.\nOnly send it to people you want to see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga el enlace de invitación puede ver tus eventos, pero no cambiarlos.\nEnvíalo solo a quien quieras que los vea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuka tahansa kutsulinkin saanut voi lukea tapahtumiasi mutta ei muuttaa niitä.\nLähetä linkki vain niille, joiden haluat näkevän ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne ayant le lien d’invitation peut lire vos événements, sans les modifier.\nEnvoyez-le uniquement aux personnes concernées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang menerima tautan undangan bisa melihat jadwal Anda, tetapi tidak bisa mengubahnya.\nKirim tautannya hanya ke orang yang ingin Anda beri akses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi riceve il link di invito può leggere i tuoi eventi, ma non modificarli.\nInvialo solo alle persone a cui vuoi mostrarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待リンクを受け取った人は、あなたの予定を閲覧のみで見ることができます。\nリンクは見せたい人にだけ送ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초대 링크를 받은 사람은 내 일정을 읽기 전용으로 볼 수 있어요.\n링크는 보여주고 싶은 사람에게만 보내세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle med invitasjonslenken kan lese hendelsene dine, men ikke endre dem.\nSend den bare til dem du vil skal se dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen met de uitnodigingslink kan je activiteiten lezen, maar niet wijzigen.\nStuur hem alleen naar mensen die ze mogen zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto ma link z zaproszeniem, może czytać Twoje wydarzenia, ale nie może ich zmieniać.\nWysyłaj go tylko osobom, którym chcesz je pokazać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem tiver o link de convite pode ver seus eventos, mas não alterar.\nEnvie só para quem você quer que veja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получатель ссылки-приглашения сможет только смотреть ваши события.\nОтправляйте её только тем, кому хотите их показать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla som har inbjudningslänken kan läsa dina händelser, men inte ändra dem.\nSkicka den bara till dem du vill ska se dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ที่ได้รับลิงก์คำเชิญจะดูกิจกรรมของคุณได้แบบอ่านอย่างเดียว\nส่งลิงก์ให้เฉพาะคนที่คุณอยากให้เห็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davet bağlantısını alan herkes etkinliklerinizi okuyabilir ama değiştiremez.\nBağlantıyı yalnızca görmesini istediğiniz kişilere gönderin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai có liên kết mời đều xem được sự kiện của bạn, nhưng không sửa được.\nChỉ gửi liên kết cho người bạn muốn cho xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收到邀请链接的人可以只读查看你的日程。\n只把链接传给你想让他看的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收到邀請連結的人可以唯讀檢視你的行程。\n只把連結傳給你想讓他看的人。"
          }
        }
      }
    },
    "초대 링크를 받은 사람은 누구나 이 목록에 참여해 함께 읽고 쓸 수 있습니다.\n링크는 함께할 사람에게만 보내주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo dostane odkaz s pozvánkou, může se k seznamu připojit a společně ho číst i upravovat.\nOdkaz pošlete jen těm, s kým ho chcete sdílet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle med invitationslinket kan blive en del af listen og læse og skrive i den.\nSend det kun til dem, du vil have med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Einladungslink hat, kann dieser Liste beitreten und darin lesen und schreiben.\nSchick ihn nur an Leute, mit denen du sie teilen willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος έχει τον σύνδεσμο πρόσκλησης μπορεί να μπει σε αυτή τη λίστα και να διαβάζει και να γράφει σε αυτήν.\nΣτείλ’ τον μόνο σε όσους θέλεις μέσα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the invite link can join this list and read and write in it.\nOnly send it to the people you want in."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the invite link can join this list and read and write in it.\nOnly send it to the people you want in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga el enlace de invitación puede unirse a esta lista y leer y escribir en ella.\nEnvíalo solo a las personas que quieras dentro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuka tahansa kutsulinkin saanut voi liittyä tähän listaan, lukea ja kirjoittaa siihen.\nLähetä linkki vain niille, jotka haluat mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne ayant le lien d’invitation peut rejoindre cette liste, la lire et y écrire.\nEnvoyez-le uniquement aux personnes avec qui vous la partagez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang menerima tautan undangan bisa bergabung ke daftar ini dan ikut membaca serta menulis.\nKirim tautannya hanya ke orang yang ingin Anda ajak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque riceva il link di invito può unirsi a questo elenco e leggerlo e modificarlo insieme a te.\nInvialo solo alle persone che vuoi coinvolgere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待リンクを受け取った人は誰でもこのリストに参加して、一緒に読み書きできます。\nリンクは一緒に使う人にだけ送ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초대 링크를 받은 사람은 누구나 이 목록에 참여해 함께 읽고 쓸 수 있습니다.\n링크는 함께할 사람에게만 보내주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle med invitasjonslenken kan bli med i listen og lese og skrive i den.\nSend den bare til dem du vil ha med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen met de uitnodigingslink kan meedoen aan deze lijst en erin lezen en schrijven.\nStuur hem alleen naar de mensen die je erbij wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto ma link z zaproszeniem, może dołączyć do tej listy, czytać ją i w niej pisać.\nWysyłaj go tylko osobom, z którymi chcesz ją dzielić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem tiver o link de convite pode entrar nesta lista e ler e escrever nela.\nEnvie só para as pessoas que você quer junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой, у кого есть ссылка-приглашение, может присоединиться к этому списку, читать и писать в нём.\nОтправляйте её только тем, с кем хотите вести список."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla som har inbjudningslänken kan gå med i listan och både läsa och skriva i den.\nSkicka den bara till dem du vill ha med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ที่ได้รับลิงก์คำเชิญทุกคนจะเข้าร่วมรายการนี้ และอ่านเขียนร่วมกันได้\nส่งลิงก์ให้เฉพาะคนที่จะใช้ด้วยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davet bağlantısını alan herkes bu listeye katılıp birlikte okuyup yazabilir.\nBağlantıyı yalnızca birlikte çalışacağınız kişilere gönderin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai có liên kết mời đều có thể tham gia danh sách này và cùng đọc, ghi.\nChỉ gửi liên kết cho những người bạn muốn làm cùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收到邀请链接的人都可以加入这个列表，一起读写。\n请只把链接传给要一起参与的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收到邀請連結的人都可以加入這個列表，一起讀寫。\n請只把連結傳給要一起參與的人。"
          }
        }
      }
    },
