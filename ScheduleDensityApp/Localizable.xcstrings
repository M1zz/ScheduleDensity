          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 위 '추가'를 누르면 무지개에 한 줄이 그어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
