    "Mac에서 짠 주간 계획 블록을 밀도에 함께 표시 (읽기 전용).\n루틴(고정·쿼터)은 매일 그대로 깔리므로 그리지 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje bloky týdenního plánu, které jste si udělali na Macu (jen ke čtení).\nRutiny – pevné i kvóty – se opakují každý den, proto se nevykreslují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser de ugeplansblokke, du har lavet på din Mac, skrivebeskyttet.\nRutiner – faste og kvoter – gentages hver dag og tegnes derfor ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Wochenplan-Blöcke, die du auf dem Mac erstellt hast, schreibgeschützt an.\nRoutinen – feste und Kontingente – wiederholen sich täglich und werden daher nicht gezeichnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει τα μπλοκ του εβδομαδιαίου πλάνου που έφτιαξες στο Mac, μόνο για ανάγνωση.\nΟι ρουτίνες (σταθερές και κατανομές) επαναλαμβάνονται κάθε μέρα, γι’ αυτό δεν σχεδιάζονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the weekly plan blocks you made on the Mac, read-only.\nRoutines — fixed and quota — repeat every day, so they aren't drawn."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the weekly plan blocks you made on the Mac, read-only.\nRoutines — fixed and quota — repeat every day, so they aren't drawn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los bloques del plan semanal que hiciste en el Mac, solo lectura.\nLas rutinas (fijas y de cuota) se repiten todos los días, así que no se dibujan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää Macilla tekemäsi viikkosuunnitelman lohkot, vain luku.\nRutiinit – kiinteät ja kiintiöt – toistuvat joka päivä, joten niitä ei piirretä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche en lecture seule les blocs du planning hebdomadaire créés sur le Mac.\nLes routines (fixes et quotas) se répètent chaque jour et ne sont donc pas dessinées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan blok rencana mingguan yang Anda buat di Mac (hanya baca).\nRutinitas — tetap dan kuota — berulang setiap hari, jadi tidak digambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra i blocchi del piano settimanale creati sul Mac, in sola lettura.\nLe routine (fisse e a quota) si ripetono ogni giorno, quindi non vengono disegnate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macで作った週の予定ブロックを密度に重ねて表示します（読み取り専用）。\nルーティン（固定・ノルマ）は毎日同じように入るので描きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 짠 주간 계획 블록을 밀도에 함께 표시 (읽기 전용).\n루틴(고정·쿼터)은 매일 그대로 깔리므로 그리지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser ukeplanblokkene du har laget på Macen, skrivebeskyttet.\nRutiner – faste og kvoter – gjentas hver dag og tegnes derfor ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de weekplanblokken die je op de Mac hebt gemaakt, alleen-lezen.\nRoutines (vast en quotum) komen elke dag terug en worden daarom niet getekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje bloki planu tygodnia ułożone na Macu, tylko do odczytu.\nRutyny (stałe i normy) powtarzają się codziennie, więc nie są rysowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra os blocos do plano semanal feitos no Mac, só para leitura.\nRotinas (fixas e de cota) se repetem todo dia, então não são desenhadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает блоки недельного плана, составленного на Mac (только чтение).\nРутины — постоянные и с нормой — повторяются каждый день, поэтому не рисуются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar veckoplanens block som du gjort på Mac, skrivskyddat.\nRutiner – fasta och kvoter – upprepas varje dag och ritas därför inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงบล็อกแผนประจำสัปดาห์ที่สร้างบน Mac ไว้ในความหนาแน่นด้วย (อ่านอย่างเดียว)\nกิจวัตร (แบบคงที่และแบบโควตา) วนทุกวันเหมือนเดิม จึงไม่วาดลงไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’te hazırladığınız haftalık plan bloklarını yoğunlukla birlikte gösterir (salt okunur).\nRutinler (sabit ve kota) her gün aynen tekrarlandığı için çizilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị các khối kế hoạch tuần bạn lập trên Mac, chỉ để xem.\nThói quen — cố định và hạn mức — lặp lại mỗi ngày nên không được vẽ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将在 Mac 上排好的每周计划区块一并显示在密度中（只读）。\n日常例程（固定·配额）每天都照样铺着，所以不另外画出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將在 Mac 上排好的每週計畫區塊一併顯示在密度中（唯讀）。\n例行事項（固定・配額）每天都照樣鋪著，所以不另外畫出。"
          }
        }
      }
    },
