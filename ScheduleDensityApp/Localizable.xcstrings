    "iOS 설정 ▸ 이 앱 ▸ 실시간 현황이 꺼져 있어 보이지 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro tuto aplikaci jsou v Nastavení iOS vypnuté aktivity živě, takže se nemůže zobrazit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-aktiviteter er slået fra for denne app i Indstillinger, så den kan ikke vises."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Aktivitäten sind für diese App in den iOS-Einstellungen ausgeschaltet, deshalb kann sie nicht angezeigt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι Ζωντανές δραστηριότητες είναι απενεργοποιημένες για την εφαρμογή στις Ρυθμίσεις του iOS, οπότε δεν μπορεί να εμφανιστεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activities are turned off for this app in iOS Settings, so it can't appear."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activities are turned off for this app in iOS Settings, so it can't appear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Actividades en tiempo real están desactivadas para esta app en Ajustes de iOS, así que no puede aparecer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activityt on kytketty pois tältä apilta iOS:n Asetuksissa, joten sitä ei voi näyttää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
